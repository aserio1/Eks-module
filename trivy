
#!/usr/bin/env python3

# Jenkins EFS Cleanup
#
# Fast DRY-RUN inventory of:
#   1. Stale .terraform directories
#   2. Potential stale Jenkins build workspaces
#
# No hardcoded Jenkins project names.
# No recursive size calculations.
# No deletion.
#
# Run against the actual workspace storage path
# visible to the Jenkins execution environment.

import os
import sys
import time
import argparse

ROOT_DIR = "/home/jenkins/workspace"
MAX_WORKERS = 8
STALE_DAYS = 90

MAX_SCAN_SECONDS = 300
PROGRESS_INTERVAL = 5000

SKIP_DIRS = {
    ".git",
    ".svn",
    ".hg",
    "node_modules",
    "__pycache__",
    ".venv",
    "venv",
    ".cache",
    ".mypy_cache",
    ".pytest_cache",
    ".tox",
    ".gradle",
    ".m2",
    "target",
    "dist",
    "build",
    "coverage",
    ".next",
    ".idea",
    ".vscode"
}


def scan_workspaces(root, stale_days, max_seconds):
    """
    Discover stale Terraform caches and potential
    Jenkins build workspaces.

    No deletion is performed.
    """

    cutoff = time.time() - (stale_days * 86400)
    start_time = time.monotonic()

    stack = [(root, 0)]

    results = {
        "directories_scanned": 0,
        "terraform_found": 0,
        "stale_terraform": 0,
        "build_dirs_found": 0,
        "stale_build_dirs": 0,
        "skipped": 0,
        "errors": 0,
        "timed_out": False
    }

    while stack:

        if time.monotonic() - start_time >= max_seconds:
            results["timed_out"] = True
            break

        current, depth = stack.pop()
        results["directories_scanned"] += 1

        if results["directories_scanned"] % PROGRESS_INTERVAL == 0:
            print(
                f"Scanned: {results['directories_scanned']} | "
                f"Stale Terraform: {results['stale_terraform']} | "
                f"Stale build folders: {results['stale_build_dirs']}",
                flush=True
            )

        try:
            with os.scandir(current) as entries:
                for entry in entries:

                    try:
                        if not entry.is_dir(
                            follow_symlinks=False
                        ):
                            continue

                        if entry.name in SKIP_DIRS:
                            results["skipped"] += 1
                            continue

                        if entry.name == ".terraform":
                            results["terraform_found"] += 1

                            info = entry.stat(
                                follow_symlinks=False
                            )

                            if info.st_mtime < cutoff:
                                results["stale_terraform"] += 1

                            # Do not recurse into Terraform cache.
                            continue

                        # Numeric directories may represent
                        # Jenkins BUILD_NUMBER directories.
                        if entry.name.isdigit():
                            results["build_dirs_found"] += 1

                            info = entry.stat(
                                follow_symlinks=False
                            )

                            if info.st_mtime < cutoff:
                                results["stale_build_dirs"] += 1

                            # Do not recurse into build directories.
                            continue

                        stack.append((entry.path, depth + 1))

                    except OSError:
                        results["errors"] += 1

        except OSError:
            results["errors"] += 1

    results["elapsed"] = time.monotonic() - start_time

    return results


def main():

    parser = argparse.ArgumentParser(
        description="Jenkins workspace cleanup dry-run"
    )

    parser.add_argument(
        "--root",
        default=ROOT_DIR,
        help="Workspace storage path visible to this process"
    )

    parser.add_argument(
        "--stale-days",
        type=int,
        default=STALE_DAYS
    )

    parser.add_argument(
        "--max-seconds",
        type=int,
        default=MAX_SCAN_SECONDS
    )

    parser.add_argument(
        "--execute",
        action="store_true",
        help="Deletion is disabled"
    )

    args = parser.parse_args()

    if args.execute:
        print("ERROR: Deletion is disabled.")
        sys.exit(1)

    if args.stale_days < 0 or args.max_seconds <= 0:
        parser.error("Invalid retention or scan-time value")

    if not os.path.isdir(args.root):
        print(
            f"ERROR: Workspace directory not accessible: "
            f"{args.root}",
            file=sys.stderr
        )
        sys.exit(1)

    print("======================================")
    print("JENKINS WORKSPACE CLEANUP - DRY RUN")
    print("======================================")
    print(f"Scanning         : {args.root}")
    print(f"Retention period : {args.stale_days} days")
    print(f"Max scan time    : {args.max_seconds} seconds")
    print("Mode             : DRY-RUN")
    print()

    results = scan_workspaces(
        args.root,
        args.stale_days,
        args.max_seconds
    )

    print()
    print("======================================")
    print("DRY-RUN SUMMARY")
    print("======================================")
    print(f"Directories scanned         : {results['directories_scanned']}")
    print(f"Terraform directories found : {results['terraform_found']}")
    print(f"Stale Terraform directories : {results['stale_terraform']}")
    print(f"Numeric directories found   : {results['build_dirs_found']}")
    print(f"Stale numeric directories   : {results['stale_build_dirs']}")
    print(f"Irrelevant folders skipped  : {results['skipped']}")
    print(f"Scan errors                 : {results['errors']}")
    print(f"Execution time              : {results['elapsed']:.2f} seconds")

    scan_status = (
        "PARTIAL"
        if results["timed_out"] or results["errors"]
        else "COMPLETE WITH EXCLUSIONS"
    )

    print(f"Scan status                 : {scan_status}")
    print("Directories deleted         : 0")
    print("Files deleted               : 0")
    print("======================================")
    print("DRY-RUN COMPLETE - NOTHING DELETED")
    print("======================================")


if __name__ == "__main__":
    main()
