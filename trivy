
#!/usr/bin/env python3

# Jenkins EFS Cleanup
# Fast root-level dry run.
#
# Scan /jenkins_jobs and exclude major Jenkins folders.
# Identify unexpected root files and directories.
# Flag potential old feature branch and truncated job names.
#
# DRY-RUN ONLY - nothing is deleted.

import os
import sys
import time
import stat
import argparse
from datetime import datetime

ROOT_DIR = "/jenkins_jobs"
STALE_DAYS = 90

EXCLUDED_FOLDERS = {
    "CGAP",
    "Data Workbench",
    "GIS",
    "IDES",
    "IMAC",
    "ML Engineering",
    "OAMS",
    "SALT",
    "Swift Insights Explorer",
    "Utility"
}

# Common patterns in Jenkins multibranch job names.
FEATURE_PATTERNS = (
    "feature-",
    "feature/",
    "bugfix-",
    "bugfix/",
    "hotfix-",
    "hotfix/",
    "release-",
    "release/",
    "PR-"
)


def format_date(timestamp):
    return datetime.fromtimestamp(
        timestamp
    ).strftime("%Y-%m-%d %H:%M:%S")


def classify_entry(name, is_dir):
    """
    Classify root-level entries for manual review.

    Name-based classifications are only hints.
    They do not verify whether a Jenkins job exists.
    """

    lower_name = name.lower()

    if not is_dir:
        return "ROOT FILE"

    if any(
        pattern.lower() in lower_name
        for pattern in FEATURE_PATTERNS
    ):
        return "POSSIBLE FEATURE/PR JOB"

    return "OTHER ROOT DIRECTORY - REVIEW"


def scan_root(root, stale_days):
    """
    Scan immediate children of /jenkins_jobs.

    No recursive traversal.
    No directory size calculations.
    No Jenkins API calls.
    No deletion.
    """

    cutoff = time.time() - (stale_days * 86400)

    results = {
        "total_entries": 0,
        "excluded": 0,
        "files": 0,
        "directories": 0,
        "stale_files": 0,
        "stale_directories": 0,
        "feature_jobs": 0,
        "errors": 0,
        "candidates": []
    }

    with os.scandir(root) as entries:

        for entry in entries:

            results["total_entries"] += 1

            try:
                is_dir = entry.is_dir(
                    follow_symlinks=False
                )

                # Exclude the major Jenkins folders.
                if is_dir and entry.name in EXCLUDED_FOLDERS:
                    results["excluded"] += 1
                    continue

                info = entry.stat(
                    follow_symlinks=False
                )

                if is_dir:
                    results["directories"] += 1
                else:
                    results["files"] += 1

                # Only list entries older than retention.
                if info.st_mtime >= cutoff:
                    continue

                category = classify_entry(
                    entry.name,
                    is_dir
                )

                if is_dir:
                    results["stale_directories"] += 1
                else:
                    results["stale_files"] += 1

                if category == "POSSIBLE FEATURE/PR JOB":
                    results["feature_jobs"] += 1

                results["candidates"].append({
                    "name": entry.name,
                    "path": entry.path,
                    "type": "DIRECTORY" if is_dir else "FILE",
                    "category": category,
                    "modified": format_date(info.st_mtime),
                    "mtime": info.st_mtime,
                    "age_days": int(
                        (time.time() - info.st_mtime) / 86400
                    ),
                    "permissions": stat.filemode(info.st_mode)
                })

            except (PermissionError, FileNotFoundError, OSError) as e:
                results["errors"] += 1

                print(
                    f"WARNING: Cannot inspect {entry.path}: {e}",
                    file=sys.stderr,
                    flush=True
                )

    return results


def main():

    parser = argparse.ArgumentParser(
        description="Fast Jenkins EFS root dry-run cleanup"
    )

    parser.add_argument(
        "--execute",
        action="store_true",
        help="Deletion is disabled"
    )

    parser.add_argument(
        "--root",
        default=ROOT_DIR,
        help="Root directory to scan"
    )

    parser.add_argument(
        "--stale-days",
        type=int,
        default=STALE_DAYS
    )

    args = parser.parse_args()

    if args.execute:
        print("ERROR: Deletion is disabled.")
        sys.exit(1)

    if args.stale_days < 0:
        parser.error("--stale-days must be >= 0")

    if not os.path.isdir(args.root):
        print(
            f"ERROR: Directory not found: {args.root}",
            file=sys.stderr
        )
        sys.exit(1)

    start_time = time.monotonic()

    print("======================================")
    print("JENKINS EFS CLEANUP - ROOT DRY RUN")
    print("======================================")
    print(f"Root directory  : {args.root}")
    print(f"Retention period: {args.stale_days} days")
    print(f"Excluded folders: {len(EXCLUDED_FOLDERS)}")
    print("Recursive scan  : NO")
    print("Mode            : DRY-RUN")
    print()

    results = scan_root(
        args.root,
        args.stale_days
    )

    # Oldest entries first.
    results["candidates"].sort(
        key=lambda item: item["mtime"]
    )

    print("======================================")
    print("STALE ROOT ENTRIES - REVIEW REQUIRED")
    print("======================================")

    if not results["candidates"]:
        print("No stale root-level entries found.")

    for item in results["candidates"]:
        print(
            f"{item['type']:10} | "
            f"{item['age_days']:5} days | "
            f"{item['modified']} | "
            f"{item['category']} | "
            f"{item['path']}"
        )

    elapsed = time.monotonic() - start_time

    print()
    print("======================================")
    print("DRY-RUN SUMMARY")
    print("======================================")
    print(f"Total root entries scanned    : {results['total_entries']}")
    print(f"Major folders excluded        : {results['excluded']}")
    print(f"Other root directories        : {results['directories']}")
    print(f"Other root files              : {results['files']}")
    print(f"Stale directories (>90 days)  : {results['stale_directories']}")
    print(f"Stale files (>90 days)        : {results['stale_files']}")
    print(f"Possible feature/PR jobs      : {results['feature_jobs']}")
    print(f"Total proposed review items   : {len(results['candidates'])}")
    print(f"Access errors                 : {results['errors']}")
    print(f"Execution time                : {elapsed:.2f} seconds")
    print("Directories deleted           : 0")
    print("Files deleted                 : 0")
    print("======================================")
    print("DRY-RUN COMPLETE - NOTHING DELETED")
    print("All candidates require manual review.")
    print("======================================")


if __name__ == "__main__":
    main()
