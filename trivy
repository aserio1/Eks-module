    Derive workspace root from Jenkins environment.
    Discover stale Terraform caches and potential
    Jenkins build workspaces.
    Expected pattern:
      <root>/<JOB_NAME>/<BUILD_NUMBER>
    JOB_NAME may contain nested folders and branch names.
    No deletion is performed.
    """

    workspace = os.environ.get("WORKSPACE")
    job_name = os.environ.get("JOB_NAME")
    build_number = os.environ.get("BUILD_NUMBER")

    if not all((workspace, job_name, build_number)):
        print(
            "ERROR: WORKSPACE, JOB_NAME and BUILD_NUMBER "
            "must be available."
        )
        sys.exit(1)

    if not build_number.isdigit():
        print("ERROR: Invalid BUILD_NUMBER.")
        sys.exit(1)

    job_parts = [
        part
        for part in job_name.replace("%2F", "/").split("/")
        if part
    ]

    # Resolve the known Jenkins workspace suffix.
    suffix = Path(*job_parts, build_number)
    cutoff = time.time() - (stale_days * 86400)
    start_time = time.monotonic()

    workspace_path = Path(workspace).resolve()
    stack = [(root, 0)]

    # Jenkins ws() may be nested further for script execution.
    # Find the expected job/build suffix in the workspace path.
    parts = workspace_path.parts
    suffix_parts = suffix.parts

    for i in range(len(parts) - len(suffix_parts) + 1):
        if tuple(parts[i:i + len(suffix_parts)]) == suffix_parts:
            return Path(*parts[:i])

    print(
        "ERROR: Cannot derive workspace root from "
        "WORKSPACE/JOB_NAME/BUILD_NUMBER."
    )
    print(f"WORKSPACE    : {workspace}")
    print(f"JOB_NAME     : {job_name}")
    print(f"BUILD_NUMBER : {build_number}")
    sys.exit(1)


