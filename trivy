"""
audit_python310.py
Scans a GitHub org for repos still using Python 3.10 in:
  - Dockerfiles  (FROM python:3.10...)
  - Any .groovy file (JTE pipeline configs, etc.)  (python_version = "3.10...")

Archived / read-only repos are excluded: the org's active repo list is
fetched once up front, and search results are filtered against it before
any file content is fetched. The original 5 org-wide search queries are
unchanged — no extra search API calls are introduced.

Requirements:
  pip install requests

Usage:
  export GITHUB_TOKEN=ghp_...
  python audit_python310.py --org my-org [--output report.csv]
"""

import argparse
import base64
import csv
import os
import re
import sys
import time
from dataclasses import dataclass, fields
from typing import Iterator

import requests

# ---------------------------------------------------------------------------
# Config
# ---------------------------------------------------------------------------

DEPRECATED = re.compile(r"3\.10(\.\d+)?")

DOCKERFILE_FROM = re.compile(r"^FROM\s+python:3\.10", re.IGNORECASE | re.MULTILINE)
DOCKERFILE_ARG = re.compile(r"(?:ENV|ARG)\s+PYTHON_VERSION\s*=?\s*3\.10", re.IGNORECASE | re.MULTILINE)
DOCKERFILE_ECR = re.compile(r"^FROM\b.*ib-python310", re.IGNORECASE | re.MULTILINE)
JTE_VERSION = re.compile(r'python_version\s*[=:]\s*["\']?3\.10', re.IGNORECASE)

# Each tuple: (kind, search term, filename qualifiers)
# Two separate Dockerfile queries — one per filename — because GitHub code search
# treats multiple filename: qualifiers as OR within the same query, but results
# can be inconsistent for exact-name matches vs prefix matches. Explicit is safer.
#
# For JTE, we search by extension:groovy rather than a specific filename, since
# pipeline config files aren't always named pipeline_config.groovy.
SEARCH_QUERIES = [
    ("dockerfile", "FROM python:3.10", "filename:Dockerfile"),
    ("dockerfile", "FROM python:3.10", "filename:DockerfileTemplate"),
    ("dockerfile", "ib-python310", "filename:Dockerfile"),
    ("dockerfile", "ib-python310", "filename:DockerfileTemplate"),
    ("jte", "python_version = 3.10", "extension:groovy"),
]# ---------------------------------------------------------------------------
# Data
# ---------------------------------------------------------------------------


@dataclass
class Hit:
    repo: str
    file: str
    kind: str  # 'dockerfile' | 'jte'
    match: str  # the matched line(s)
    html_url: str


# ---------------------------------------------------------------------------
# GitHub client
# ---------------------------------------------------------------------------


class GitHub:
    def __init__(self, token: str, host: str = "https://git.aws.hhsoig.gov/api/v3", cacert: str | None = None):
        self.BASE = host.rstrip("/")
        self.s = requests.Session()
        self.s.headers.update(
            {
                "Authorization": f"Bearer {token}",
                "Accept": "application/vnd.github+json",
                "X-GitHub-Api-Version": "2022-11-28",
            }
        )
        # Use corporate CA bundle if provided, otherwise default verification.
        # Set cacert to False only as a last resort — disables SSL verification entirely.
        self.s.verify = cacert if cacert else True

    def _get(self, url: str, **params) -> dict:
        r = self.s.get(url, params=params)
        self._handle_rate(r)
        r.raise_for_status()
        return r.json()

    def _handle_rate(self, r: requests.Response):
        """Back off on secondary rate limits and search throttling."""
        if r.status_code == 403 and "rate limit" in r.text.lower():
            reset = int(r.headers.get("X-RateLimit-Reset", time.time() + 60))
            wait = max(reset - int(time.time()), 10)
            print(f"  [rate limit] sleeping {wait}s …", flush=True)
            time.sleep(wait)
        elif r.status_code == 422:
            pass  # handled by caller

    def search_code(self, q: str) -> Iterator[dict]:
        """Paginate through all code search results (max 1 000 per query)."""
        url = f"{self.BASE}/search/code"
        page = 1
        while True:
            data = self._get(url, q=q, per_page=100, page=page)
            yield from data.get("items", [])
            if len(data.get("items", [])) < 100:
                break
            page += 1
            time.sleep(1)  # stay inside secondary rate limits

    def file_content(self, repo: str, path: str, ref: str = "HEAD") -> str | None:
        """Fetch raw file content; returns None on error."""
        url = f"{self.BASE}/repos/{repo}/contents/{path}"
        try:
            data = self._get(url, ref=ref)
            return base64.b64decode(data["content"]).decode("utf-8", errors="replace")
        except Exception:
            return None

    def list_active_repos(self, org: str) -> list[str]:
        """
        Return full_names of all non-archived (active) repos in an org.
        Fetched once, up front, so archived repos are never included in
        any subsequent code search.
        """
        active: list[str] = []
        url = f"{self.BASE}/orgs/{org}/repos"
        page = 1
        while True:
            data = self._get(url, per_page=100, page=page, type="all")
            if not data:
                break
            active.extend(repo["full_name"] for repo in data if not repo.get("archived", False))
            if len(data) < 100:
                break
            page += 1
            time.sleep(0.5)
        return active


# ---------------------------------------------------------------------------
# Audit logic
# ---------------------------------------------------------------------------


def extract_matches(content: str, kind: str) -> list[str]:
    """Return the matching lines from a file."""
    lines = []
    for i, line in enumerate(content.splitlines(), 1):
        if kind == "dockerfile":
            # Three independent checks — any one is a violation:
            #   1. Public image:  FROM python:3.10[.x][-suffix]
            #   2. ENV/ARG pin:   PYTHON_VERSION=3.10.x
            #   3. ECR image:     FROM <anything>ib-python310<anything>
            matched = DOCKERFILE_FROM.search(line) or DOCKERFILE_ARG.search(line) or DOCKERFILE_ECR.search(line)
            if matched:
                lines.append(f"L{i}: {line.strip()}")
        elif kind == "jte":
            if JTE_VERSION.search(line):
                lines.append(f"L{i}: {line.strip()}")
    return lines


def audit_org(gh: GitHub, org: str) -> list[Hit]:
    hits: list[Hit] = []
    seen: set[str] = set()

    active_repos = set(gh.list_active_repos(org))

    for kind, term, qualifier in SEARCH_QUERIES:
        q = f"{term} org:{org} {qualifier}"
        print(f"\n[search] {q}")

        for item in gh.search_code(q):
            repo = item["repository"]["full_name"]
            path = item["path"]
            html_url = item["html_url"]
            key = f"{repo}/{path}"

            if key in seen:
                continue
            seen.add(key)

            if repo not in active_repos:
                continue

            print(f"  checking {key} …", end=" ", flush=True)
            content = gh.file_content(repo, path)
            if content is None:
                print("⚠ could not fetch")
                continue

            matches = extract_matches(content, kind)
            if matches:
                hits.append(
                    Hit(
                        repo=repo,
                        file=path,
                        kind=kind,
                        match=" | ".join(matches),
                        html_url=html_url,
                    )
                )
                print(f"✗ {len(matches)} match(es)")
            else:
                print("✓ false-positive, skipped")

        time.sleep(2)  # between query types

    return hits


# ---------------------------------------------------------------------------
# Output
# ---------------------------------------------------------------------------


def print_summary(hits: list[Hit]):
    if not hits:
        print("\n✅  No Python 3.10 usage found.")
        return

    repos = sorted({h.repo for h in hits})
    print(f"\n{'='*60}")
    print(f"  Found {len(hits)} file(s) across {len(repos)} repo(s)")
    print(f"{'='*60}")

    for repo in repos:
        repo_hits = [h for h in hits if h.repo == repo]
        print(f"\n  {repo}")
        for h in repo_hits:
            label = " Dockerfile" if h.kind == "dockerfile" else " .groovy file"
            print(f"    {label}  →  {h.file}")
            for line in h.match.split(" | "):
                print(f"       {line}")
            print(f"       {h.html_url}")


def write_csv(hits: list[Hit], path: str):
    with open(path, "w", newline="") as f:
        w = csv.DictWriter(f, fieldnames=[field.name for field in fields(Hit)])
        w.writeheader()
        for h in hits:
            w.writerow({field.name: getattr(h, field.name) for field in fields(Hit)})
    print(f"\n📄  Report written to {path}")


# ---------------------------------------------------------------------------
# Entry point
# ---------------------------------------------------------------------------


def main():
    parser = argparse.ArgumentParser(description="Audit GitHub org for Python 3.10 usage")
    parser.add_argument("--org", required=True, help="GitHub org name")
    parser.add_argument("--host", default="https://git.aws.hhsoig.gov/api/v3", help="GitHub API base URL")
    parser.add_argument("--output", default=None, help="CSV output file (optional)")
    parser.add_argument("--cacert", default=None, help="Path to CA bundle (.pem) for corporate proxy")
    args = parser.parse_args()

    token = os.getenv("GITHUB_TOKEN")
    if not token:
        sys.exit("Error: GITHUB_TOKEN env var not set.")

    gh = GitHub(token, host=args.host, cacert=args.cacert)
    hits = audit_org(gh, args.org)

    print_summary(hits)

    if args.output:
        write_csv(hits, args.output)


if __name__ == "__main__":
    main()
