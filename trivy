
customPath = "workspace/${env.JOB_NAME.replace('%2F','/')}/${env.BUILD_NUMBER}"

pipeline {
    agent { label jte.keywords.project }

    triggers {
        cron('0 2 * * 1-5') // Every Monday-Friday at 9:00 pm EST.
    }

    stages {
        stage('Disable Concurrent Builds') {
            steps {
                echo "Disabling Concurrent Builds"
                script {
                    disable_concurrent_builds()
                }
            }
        }

        stage('Checkout') {
            steps {
                script {
                    git_checkout()
                }
            }
        }

        stage('Run EFS Cleanup') {
            steps {
                echo "Starting EFS Cleanup..."
                script {
                    setup()
                    sast(true)
                    scan_dependencies()

                    // Check whether pytest can discover any tests
                    def testCollectionStatus = sh(
                        script: """
                            python3 -m pytest --collect-only -q
                        """,
                        returnStatus: true
                    )

                    if (testCollectionStatus == 0) {
                        echo "Python tests found. Running unit tests..."
                        unit_test()
                    } else if (testCollectionStatus == 5) {
                        echo "No Python tests found. Skipping unit_test() for EFS Cleanup."
                    } else {
                        error("Pytest collection failed with exit code ${testCollectionStatus}")
                    }

                    ws("${customPath}/admin/scripts"){
                        sh """
                        /home/jenkins/anaconda3/envs/python312/bin/python3 cleanup_jenkins_efs.py
                        """
                    }
                }
            }
        }

    }

    post {
        success {
            echo 'EFS Cleanup completed successfully!'
        }
        failure {
            echo 'EFS Cleanup failed. Check console output for details.'
            // email_via_sns()
        }
    }
}
