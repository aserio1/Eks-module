set -euo pipefail

PLUGIN_CACHE_DIR="/tmp/jenkins-plugin-cache"
S3_PLUGIN_CACHE="s3://jenkins-binaries-213141505949/jenkins-plugin-cache/"

echo "========================================"
echo "Jenkins Plugin Cache Upload"
echo "========================================"

# Verify AWS identity
aws sts get-caller-identity

# Verify Jenkins container
docker inspect -f '{{.State.Running}}' jenkins | grep -qx true || {
  echo "ERROR: Jenkins container is not running"
  exit 1
}

# Prepare clean local directory
rm -rf "$PLUGIN_CACHE_DIR"
mkdir -p "$PLUGIN_CACHE_DIR"

# Copy plugins from Jenkins container
echo "Copying Jenkins plugins..."
docker cp jenkins:/home/jenkins/plugins/. "$PLUGIN_CACHE_DIR/"

# Verify plugin archives
PLUGIN_COUNT=$(find "$PLUGIN_CACHE_DIR" -maxdepth 1 -type f \
  \( -name "*.jpi" -o -name "*.hpi" \) | wc -l)

echo "Plugins found: $PLUGIN_COUNT"

if [ "$PLUGIN_COUNT" -eq 0 ]; then
  echo "ERROR: No plugin archives found."
  exit 1
fi

# Upload plugins to S3
echo "Uploading Jenkins plugins to S3..."

aws s3 sync \
  "$PLUGIN_CACHE_DIR/" \
  "$S3_PLUGIN_CACHE" \
  --exclude "*" \
  --include "*.jpi" \
  --include "*.hpi" \
  --region us-east-1

# Verify uploaded files
echo "Verifying S3 plugin cache..."

aws s3 ls \
  "$S3_PLUGIN_CACHE" \
  --recursive \
  --region us-east-1 \
  | awk '$4 ~ /\.(jpi|hpi)$/ {n++} END {print "Plugins in S3:", n+0}'

echo "========================================"
echo "Jenkins Plugin Cache Upload Completed"
echo "========================================"
