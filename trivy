#!/usr/bin/env python3

# This script identifies recursively .terraform dirs
# found in /home/jenkins/workspace.
# Lists cleanup candidates without deleting any files.
# Executed via a Jenkins job that runs daily during off hours.

import os
import sys
import time
import shutil
import argparse
import json
import urllib.request
import urllib.parse
import urllib.error
import base64
import re
from concurrent.futures import ThreadPoolExecutor, as_completed
from threading import Lock

ROOT_DIR = "/home/jenkins/workspace"
MAX_WORKERS = 8  # Tune based on EFS throughput limits
STALE_DAYS = 90

print_lock = Lock()
stats_lock = Lock()
freed_space = 0


def get_dir_size_fast(path):
    """Use os.scandir recursively for faster size calculation."""
    total = 0
    try:
        with os.scandir(path) as it:
            for entry in it:
                try:
                    if entry.is_file(follow_symlinks=False):
                        total += entry.stat(follow_symlinks=False).st_size
                    elif entry.is_dir(follow_symlinks=False):
                        total += get_dir_size_fast(entry.path)
                except (PermissionError, FileNotFoundError):
                    pass
    except (PermissionError, FileNotFoundError):
        pass
    return total


def find_terraform_dirs(root):
    """
    Walk the tree with os.scandir and prune traversal into .terraform dirs.
    """
    try:
        with os.scandir(root) as it:
            for entry in it:
                if not entry.is_dir(follow_symlinks=False):
                    continue

                if entry.name == ".terraform":
                    yield entry.path
                else:
                    yield from find_terraform_dirs(entry.path)

    except (PermissionError, FileNotFoundError) as e:
        print(f"Cannot access {root}: {e}", file=sys.stderr)


def find_stale_workspaces(root):
    """
    Find top-level Jenkins workspace directories older than 90 days.
    """
    cutoff = time.time() - (STALE_DAYS * 86400)

    try:
        with os.scandir(root) as it:
            for entry in it:
                try:
                    if not entry.is_dir(follow_symlinks=False):
                        continue

                    if entry.stat(follow_symlinks=False).st_mtime < cutoff:
                        yield entry.path

                except (PermissionError, FileNotFoundError):
                    pass

    except (PermissionError, FileNotFoundError) as e:
        print(f"Cannot access {root}: {e}", file=sys.stderr)


def get_jenkins_jobs():
    """
    Retrieve Jenkins jobs using the existing Jenkins controller environment.
    No credential configuration is modified.
    """
    jenkins_url = os.environ.get("JENKINS_URL", "").rstrip("/")

    if not jenkins_url:
        raise RuntimeError("JENKINS_URL is not available")

    jenkins_user = os.environ.get("JENKINS_USER", "")
    jenkins_token = os.environ.get("JENKINS_API_TOKEN", "")

    headers = {
        "Accept": "application/json"
    }

    if jenkins_user and jenkins_token:
        credentials = base64.b64encode(
            f"{jenkins_user}:{jenkins_token}".encode()
        ).decode()

        headers["Authorization"] = f"Basic {credentials}"

    jobs = {}
    pending = [(jenkins_url, "")]

    while pending:
        url, parent = pending.pop()

        request = urllib.request.Request(
            url + "/api/json?tree=jobs[name,url,_class]",
            headers=headers
        )

        with urllib.request.urlopen(request, timeout=30) as response:
            data = json.load(response)

        if "jobs" not in data:
            raise RuntimeError("Jenkins job listing unavailable")

        for job in data["jobs"]:
            name = job["name"]
            full_name = f"{parent}/{name}" if parent else name

            jobs[full_name] = job

            job_class = job.get("_class", "")

            if any(value in job_class for value in (
                "Folder",
                "WorkflowMultiBranchProject",
                "OrganizationFolder"
            )):
                pending.append((job["url"].rstrip("/"), full_name))

    return jobs


def get_workspace_job_name(path):
    """
    Normalize Jenkins workspace names.
    Remove @tmp and concurrent workspace suffixes.
    """
    name = os.path.basename(path)

    if name.endswith("@tmp"):
        name = name[:-4]

    name = re.sub(r"@\d+$", "", name)

    return name


def find_matching_job(workspace, jobs):
    """
    Match workspace against existing Jenkins jobs.
    """
    name = get_workspace_job_name(workspace)

    if name in jobs:
        return name

    matches = []

    for full_name in jobs:
        if full_name.replace("/", "_") == name:
            matches.append(full_name)

    if len(matches) == 1:
        return matches[0]

    return None


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument(
        "--execute",
        action="store_true",
        help="Not supported in this report-only version"
    )
    args = parser.parse_args()

    if args.execute:
        print("ERROR: This script is report-only. No deletion is supported.")
        sys.exit(1)

    if not os.path.isdir(ROOT_DIR):
        print(f"ERROR: Workspace root not found: {ROOT_DIR}")
        sys.exit(1)

    try:
        jobs = get_jenkins_jobs()
    except Exception as e:
        print(f"ERROR: Unable to validate Jenkins jobs: {e}")
        sys.exit(1)

    stale_workspaces = list(find_stale_workspaces(ROOT_DIR))
    terraform_dirs = list(find_terraform_dirs(ROOT_DIR))

    # Do not treat unmatched stale workspaces as approved for deletion.
    # Their ownership must first be verified against Jenkins.

    approved_workspaces = []

    # Only list Terraform directories in workspaces older than 90 days
    # that have an exact Jenkins job match. These are candidates only;
    # job inactivity has not been independently verified.

    terraform_candidates = []

    for path in terraform_dirs:
        workspace = os.path.dirname(path)

        while os.path.dirname(workspace) != ROOT_DIR:
            if workspace == ROOT_DIR:
                break
            workspace = os.path.dirname(workspace)

        if workspace not in stale_workspaces:
            continue

        if find_matching_job(workspace, jobs):
            terraform_candidates.append(path)

    print("======================================")
    print("JENKINS EFS CLEANUP - DRY RUN")
    print("======================================")
    print(f"Retention period: {STALE_DAYS} days")
    print("Mode: DRY-RUN")
    print()

    total_size = 0

    for path in terraform_candidates:
        size = get_dir_size_fast(path)
        total_size += size

        print(f"WOULD DELETE: {path}")
        print(f"Size        : {size / (1024 ** 3):.2f} GiB")
        print()

    print("======================================")
    print("DRY-RUN SUMMARY")
    print("======================================")
    print(f"Directories listed : {len(terraform_candidates)}")
    print(f"Estimated size     : {total_size / (1024 ** 3):.2f} GiB")
    print("Directories deleted: 0")
    print("======================================")
    print("DRY-RUN: No directories were deleted.")


if __name__ == "__main__":
    main()
