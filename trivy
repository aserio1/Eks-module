
#!/usr/bin/env python3

# This script identifies recursively .terraform dirs
# found in /home/jenkins/workspace.
# Lists .terraform directories older than 90 days.
# Executed via a Jenkins job that runs daily during off hours.
# DRY-RUN ONLY - no directories are deleted.

import os
import sys
import time
import argparse
from concurrent.futures import ThreadPoolExecutor, as_completed
from threading import Lock

ROOT_DIR = "/home/jenkins/workspace"
MAX_WORKERS = 8  # Tune based on EFS throughput limits
STALE_DAYS = 90

print_lock = Lock()


def get_dir_size_fast(path):
    """Use os.scandir recursively for faster size calculation."""
    total = 0

    try:
        with os.scandir(path) as it:
            for entry in it:
                try:
                    if entry.is_file(follow_symlinks=False):
                        total += entry.stat(
                            follow_symlinks=False
                        ).st_size

                    elif entry.is_dir(follow_symlinks=False):
                        total += get_dir_size_fast(entry.path)

                except (PermissionError, FileNotFoundError):
                    pass

    except (PermissionError, FileNotFoundError):
        pass

    return total


def find_terraform_dirs(root):
    """
    Find all .terraform directories recursively.
    Do not traverse inside .terraform directories.
    """
    try:
        with os.scandir(root) as it:
            for entry in it:
                try:
                    if not entry.is_dir(follow_symlinks=False):
                        continue

                    if entry.name == ".terraform":
                        yield entry.path
                    else:
                        yield from find_terraform_dirs(entry.path)

                except (PermissionError, FileNotFoundError):
                    pass

    except (PermissionError, FileNotFoundError) as e:
        print(f"Cannot access {root}: {e}", file=sys.stderr)


def is_stale_directory(path):
    """
    Check whether a directory is older than
    the configured retention period.
    """
    cutoff = time.time() - (STALE_DAYS * 86400)

    try:
        return os.stat(
            path,
            follow_symlinks=False
        ).st_mtime < cutoff

    except (PermissionError, FileNotFoundError):
        return False


def main():
    parser = argparse.ArgumentParser()

    parser.add_argument(
        "--execute",
        action="store_true",
        help="Execution disabled - dry-run only"
    )

    args = parser.parse_args()

    if args.execute:
        print("ERROR: Deletion is disabled.")
        sys.exit(1)

    if not os.path.isdir(ROOT_DIR):
        print(f"ERROR: Workspace root not found: {ROOT_DIR}")
        sys.exit(1)

    print("======================================")
    print("JENKINS EFS CLEANUP - DRY RUN")
    print("======================================")
    print(f"Scanning         : {ROOT_DIR}")
    print(f"Retention period : {STALE_DAYS} days")
    print("Mode             : DRY-RUN")
    print()

    terraform_dirs = list(find_terraform_dirs(ROOT_DIR))

    candidates = [
        path for path in terraform_dirs
        if is_stale_directory(path)
    ]

    total_size = 0

    with ThreadPoolExecutor(max_workers=MAX_WORKERS) as executor:
        results = {
            executor.submit(get_dir_size_fast, path): path
            for path in candidates
        }

        for future in as_completed(results):
            path = results[future]
            size = future.result()

            total_size += size

            with print_lock:
                print(f"CANDIDATE: {path}")
                print(
                    f"Size     : "
                    f"{size / (1024 ** 3):.2f} GiB"
                )
                print()

    print("======================================")
    print("DRY-RUN SUMMARY")
    print("======================================")
    print(f"Terraform directories found : {len(terraform_dirs)}")
    print(f"Cleanup candidates          : {len(candidates)}")
    print(f"Candidate directory size    : {total_size / (1024 ** 3):.2f} GiB")
    print("Directories deleted         : 0")
    print("======================================")
    print("DRY-RUN: No directories were deleted.")


if __name__ == "__main__":
    main()
