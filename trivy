  target_group_arns            = module.base_infrastructure.target_group_arns
  efs_mount_target             = module.base_infrastructure.efs_mount_target
  jenkins_idp_entity_id        = var.jenkins_idp_entity_id
  jenkins_idp_metadata_url     = var.jenkins_idp_metadata_url
  kms_key_arn                  = data.aws_kms_alias.ebs_kms_key.target_key_arn
  cw_retention                 = var.cw_retention
  enable_cloudwatch_build_logs = var.enable_cloudwatch_build_logs

  ecr_repo_account_id = local.ecr_repo_account_id
  controller_image    = local.controller_image
  controller_tag      = local.controller_tag
  tags                = local.tags
}
