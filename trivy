
#!/usr/bin/env python3

# Jenkins EFS Cleanup
# Fast dynamic dry-run
#
# EFS Mount: /jenkins_jobs
# Retention: 90 days
#
# No hardcoded Jenkins job folders.
# No ls -lrt.
# No recursive size calculations.
# No deletion.

import os
import sys
import time
import argparse

ROOT_DIR = "/jenkins_jobs"
STALE_DAYS = 90

PROGRESS_INTERVAL = 5000

# Exclude only common generated/internal directories
# when optional recursive scanning is enabled.
SKIP_DIRS = {
    ".git",
    ".svn",
    ".hg",
    "node_modules",
    "__pycache__",
    ".venv",
    "venv",
    ".cache",
    ".mypy_cache",
    ".pytest_cache",
    ".tox",
    ".gradle",
    ".m2",
    ".terraform"
}


def scan_efs(root, stale_days, recursive=False):
    """
    Scan EFS dynamically.

    Default:
        Scan immediate children of /jenkins_jobs.

    Optional recursive mode:
        Inspect nested job directories.

    This is a dry-run inventory only.
    """

    cutoff = time.time() - (stale_days * 86400)
    start_time = time.monotonic()

    results = {
        "scanned": 0,
        "files": 0,
        "directories": 0,
        "stale_files": 0,
        "stale_directories": 0,
        "skipped": 0,
        "errors": 0
    }

    stack = [root]

    while stack:
        current = stack.pop()

        try:
            with os.scandir(current) as entries:
                for entry in entries:

                    try:
                        results["scanned"] += 1

                        is_dir = entry.is_dir(
                            follow_symlinks=False
                        )

                        if is_dir and entry.name in SKIP_DIRS:
                            results["skipped"] += 1
                            continue

                        info = entry.stat(
                            follow_symlinks=False
                        )

                        is_stale = info.st_mtime < cutoff

                        if is_dir:
                            results["directories"] += 1

                            if is_stale:
                                results["stale_directories"] += 1

                            if recursive:
                                stack.append(entry.path)

                        else:
                            results["files"] += 1

                            if is_stale:
                                results["stale_files"] += 1

                        if (
                            results["scanned"] %
                            PROGRESS_INTERVAL == 0
                        ):
                            print(
                                f"Scanned: {results['scanned']} | "
                                f"Stale directories: "
                                f"{results['stale_directories']} | "
                                f"Stale files: "
                                f"{results['stale_files']}",
                                flush=True
                            )

                    except OSError:
                        results["errors"] += 1

        except OSError:
            results["errors"] += 1

    results["elapsed"] = time.monotonic() - start_time

    return results


def main():

    parser = argparse.ArgumentParser(
        description="Fast Jenkins EFS dry-run inventory"
    )

    parser.add_argument(
        "--root",
        default=ROOT_DIR
    )

    parser.add_argument(
        "--stale-days",
        type=int,
        default=STALE_DAYS
    )

    parser.add_argument(
        "--recursive",
        action="store_true",
        help="Scan nested directories (slower)"
    )

    parser.add_argument(
        "--execute",
        action="store_true",
        help="Deletion is disabled"
    )

    args = parser.parse_args()

    if args.execute:
        print("ERROR: Deletion is disabled.")
        sys.exit(1)

    if args.stale_days < 0:
        parser.error("--stale-days must be >= 0")

    if not os.path.isdir(args.root):
        print(
            f"ERROR: EFS mount not found: {args.root}",
            file=sys.stderr
        )
        sys.exit(1)

    start = time.monotonic()

    print("======================================")
    print("JENKINS EFS CLEANUP - FAST DRY RUN")
    print("======================================")
    print(f"EFS root         : {args.root}")
    print(f"Retention period : {args.stale_days} days")
    print(f"Recursive scan   : {'YES' if args.recursive else 'NO'}")
    print("Mode             : DRY-RUN")
    print()

    results = scan_efs(
        args.root,
        args.stale_days,
        args.recursive
    )

    print()
    print("======================================")
    print("DRY-RUN SUMMARY")
    print("======================================")
    print(f"Entries scanned            : {results['scanned']}")
    print(f"Directories found          : {results['directories']}")
    print(f"Files found                : {results['files']}")
    print(f"Stale directories          : {results['stale_directories']}")
    print(f"Stale files                : {results['stale_files']}")
    print(f"Directories skipped        : {results['skipped']}")
    print(f"Scan errors                : {results['errors']}")
    print(f"Execution time             : {results['elapsed']:.2f} seconds")
    print("Directories deleted        : 0")
    print("Files deleted              : 0")
    print("======================================")
    print("DRY-RUN COMPLETE - NOTHING DELETED")
    print("======================================")


if __name__ == "__main__":
    main()
