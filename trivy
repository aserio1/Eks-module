
#!/usr/bin/env python3

# This script performs a DRY RUN to identify old .terraform dirs
# found in the Jenkins EFS mount at /jenkins_jobs.
# Executed via a Jenkins job that runs daily during off hours.
#
# No files or directories are deleted.

import os
import time
import sys
import argparse

ROOT_DIR = "/jenkins_jobs"
MAX_WORKERS = 8
STALE_DAYS = 90
MAX_SCAN_SECONDS = 300
PROGRESS_INTERVAL = 5000

# Skip irrelevant directories during scanning.
# These names are not Jenkins project exclusions.
SKIP_DIRS = {
    ".git",
    ".svn",
    ".hg",
    "node_modules",
    "__pycache__",
    ".venv",
    "venv",
    ".cache",
    ".mypy_cache",
    ".pytest_cache",
    ".tox",
    ".gradle",
    ".m2",
    "target",
    "dist",
    "build",
    "coverage",
    ".next",
    ".idea",
    ".vscode"
}


def find_terraform_dirs(root, stale_days, max_scan_seconds):
    """
    Walk the directory tree using os.scandir.

    Skip irrelevant directories and do not descend
    into .terraform directories.

    Count .terraform directories older than stale_days.

    DRY-RUN ONLY.
    """

    cutoff = time.time() - (stale_days * 86400)
    start_time = time.monotonic()

    stack = [root]

    scanned = 0
    terraform_found = 0
    stale_terraform = 0
    skipped = 0
    errors = 0
    timed_out = False

    while stack:

        if time.monotonic() - start_time >= max_scan_seconds:
            timed_out = True
            break

        current = stack.pop()
        scanned += 1

        if scanned % PROGRESS_INTERVAL == 0:
            print(
                f"Progress: scanned {scanned} directories, "
                f"found {terraform_found} .terraform directories, "
                f"stale {stale_terraform}",
                flush=True
            )

        try:
            with os.scandir(current) as it:
                for entry in it:

                    try:
                        if not entry.is_dir(
                            follow_symlinks=False
                        ):
                            continue

                        if entry.name == ".terraform":
                            terraform_found += 1

                            info = entry.stat(
                                follow_symlinks=False
                            )

                            if info.st_mtime < cutoff:
                                stale_terraform += 1

                            continue

                        if entry.name in SKIP_DIRS:
                            skipped += 1
                            continue

                        stack.append(entry.path)

                    except OSError:
                        errors += 1

        except OSError:
            errors += 1

    return {
        "scanned": scanned,
        "terraform_found": terraform_found,
        "stale_terraform": stale_terraform,
        "skipped": skipped,
        "errors": errors,
        "timed_out": timed_out,
        "elapsed": time.monotonic() - start_time
    }


def main():

    parser = argparse.ArgumentParser()

    parser.add_argument(
        "--root",
        default=ROOT_DIR,
        help="EFS mount directory"
    )

    parser.add_argument(
        "--stale-days",
        type=int,
        default=STALE_DAYS
    )

    parser.add_argument(
        "--max-seconds",
        type=int,
        default=MAX_SCAN_SECONDS
    )

    parser.add_argument(
        "--execute",
        action="store_true",
        help="Deletion is disabled"
    )

    args = parser.parse_args()

    if args.execute:
        print("ERROR: Deletion is disabled.")
        sys.exit(1)

    if args.stale_days < 0 or args.max_seconds <= 0:
        parser.error(
            "--stale-days must be >= 0 and "
            "--max-seconds must be > 0"
        )

    if not os.path.isdir(args.root):
        print("======================================")
        print("JENKINS EFS CLEANUP - MOUNT ERROR")
        print("======================================")
        print(f"EFS directory not accessible: {args.root}")
        print()
        print("The Jenkins execution environment cannot")
        print("access the EFS mount at this path.")
        print()
        print("Verify the mount on the Jenkins agent or")
        print("inside the Jenkins container.")
        print()
        print("No directories were scanned or deleted.")
        sys.exit(1)

    print("======================================")
    print("JENKINS EFS CLEANUP - FAST DRY RUN")
    print("======================================")
    print(f"Scanning         : {args.root}")
    print(f"Retention period : {args.stale_days} days")
    print(f"Max scan time    : {args.max_seconds} seconds")
    print("Mode             : DRY-RUN")
    print()

    results = find_terraform_dirs(
        args.root,
        args.stale_days,
        args.max_seconds
    )

    print()
    print("======================================")
    print("DRY-RUN SUMMARY")
    print("======================================")
    print(f"Directories scanned          : {results['scanned']}")
    print(f"Terraform directories found  : {results['terraform_found']}")
    print(f"Stale Terraform directories  : {results['stale_terraform']}")
    print(f"Irrelevant directories skipped: {results['skipped']}")
    print(f"Scan errors                  : {results['errors']}")
    print(f"Execution time               : {results['elapsed']:.2f} seconds")
    print(
        f"Scan status                  : "
        f"{'PARTIAL' if results['timed_out'] or results['errors'] else 'COMPLETE WITH EXCLUSIONS'}"
    )
    print("Directories deleted          : 0")
    print("======================================")
    print("DRY-RUN COMPLETE - NO DELETION")
    print("======================================")


if __name__ == "__main__":
    main()
