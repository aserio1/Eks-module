set -euo pipefail

PLUGIN_CACHE_DIR="/tmp/jenkins-plugin-cache"
S3_PLUGIN_CACHE="s3://jenkins-binaries-213141505949/jenkins-plugin-cache/"

mkdir -p "$PLUGIN_CACHE_DIR"

echo "Copying Jenkins Controller plugins..."

docker cp \
  jenkins:/home/jenkins/plugins/. \
  "$PLUGIN_CACHE_DIR/"

PLUGIN_COUNT=$(find "$PLUGIN_CACHE_DIR" -maxdepth 1 -type f \
  \( -name "*.jpi" -o -name "*.hpi" \) | wc -l)

echo "Plugins found: $PLUGIN_COUNT"

if [ "$PLUGIN_COUNT" -eq 0 ]; then
  echo "ERROR: No plugins found."
  exit 1
fi

echo "Uploading plugins to S3..."

aws s3 sync \
  "$PLUGIN_CACHE_DIR/" \
  "$S3_PLUGIN_CACHE" \
  --exclude "*" \
  --include "*.jpi" \
  --include "*.hpi" \
  --region us-east-1

echo "Verifying S3 cache..."

aws s3 ls "$S3_PLUGIN_CACHE" \
  --recursive \
  --region us-east-1 \
  | awk '$4 ~ /\.(jpi|hpi)$/ {n++} END {print "Plugins in S3:", n+0}'

echo "Upload completed successfully."
