data.tf


data "aws_region" "current" {}

data "aws_caller_identity" "current" {}

data "aws_ecr_image" "controller_image" {
  repository_name = var.controller_image
  image_tag       = var.controller_tag
}

# This data source will error out on plan/apply if the AMI no longer exists,
# rather than silently succeeding and failing later at instance launch time.
data "aws_ami" "validate_pinned" {
  filter {
    name   = "image-id"
    values = [var.ami_id]
  }
}

locals {
  jenkins_cwagent_config = var.enable_cloudwatch_build_logs ? templatefile(
    "${path.module}/templates/cw-agent-config.json.tpl",
    {
      log_group_name = aws_cloudwatch_log_group.jenkins_build_logs[0].name
    }
  ) : ""
}
