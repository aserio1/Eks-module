
customPath = "workspace/${env.JOB_NAME.replace('%2F','/')}/${env.BUILD_NUMBER}"

pipeline {
    agent { label jte.keywords.project }

    triggers {
        cron('0 2 * * 1-5') // Every Monday-Friday at 2:00 AM Jenkins server time.
    }

    stages {
        stage('Disable Concurrent Builds') {
            steps {
                echo "Disabling Concurrent Builds"
                script {
                    disable_concurrent_builds()
                }
            }
        }

        stage('Checkout') {
            steps {
                script {
                    git_checkout()
                }
            }
        }

        stage('Run EFS Cleanup') {
            steps {
                echo "Starting EFS Cleanup..."
                script {
                    setup()

                    ws("${customPath}/admin/scripts") {
                        sh """
                            echo "======================================"
                            echo "Checking Jenkins Workspace Storage"
                            echo "======================================"

                            df -hT /home/jenkins/workspace
                            findmnt -T /home/jenkins/workspace || true

                            echo "======================================"
                            echo "Running Jenkins EFS Cleanup"
                            echo "======================================"

                            /home/jenkins/anaconda3/envs/python312/bin/python3 -u \
                                cleanup_jenkins_efs.py \
                                --csv jenkins_stale_list.csv \
                                --stale-days 90 \
                                --max-seconds 1800
                        """
                    }
                }
            }
        }
    }

    post {
        always {
            script {
                ws("${customPath}/admin/scripts") {
                    echo "======================================"
                    echo "Archiving Jenkins stale CSV"
                    echo "======================================"

                    archiveArtifacts artifacts: 'jenkins_stale_list.csv',
                                     allowEmptyArchive: true,
                                     fingerprint: true,
                                     onlyIfSuccessful: false
                }
            }
        }

        success {
            echo 'EFS Cleanup completed successfully!'
        }

        failure {
            echo 'EFS Cleanup failed. Check console output for details.'
            // email_via_sns()
        }
    }
}
