#!/usr/bin/env python3

# Recursively remove .terraform directories of any age.
# Report stale numeric Jenkins build directories older than 90 days (DRY RUN).
# Numeric directories under main branches remain protected.

import os
import shutil
import time
from datetime import datetime
from concurrent.futures import ThreadPoolExecutor, as_completed
from threading import Lock

ROOT_DIR = "/home/jenkins/workspace"
MAX_WORKERS = 8
STALE_DAYS = 90
MAX_SCAN_SECONDS = 300
MAX_SIZE_SECONDS = 120
PROGRESS_INTERVAL = 5000

SKIP_DIRS = {
    ".git", ".svn", ".hg", "node_modules", "__pycache__",
    ".venv", "venv", ".cache", ".mypy_cache", ".pytest_cache",
    ".tox", ".gradle", ".m2", ".idea", ".vscode"
}

print_lock = Lock()


def get_dir_size_fast(path, deadline):
    """Measure regular file sizes without following symbolic links."""
    total = 0
    stack = [path]
    complete = True

    while stack:
        if time.monotonic() >= deadline:
            complete = False
            break

        current = stack.pop()

        try:
            with os.scandir(current) as entries:
                for entry in entries:
                    if time.monotonic() >= deadline:
                        complete = False
                        break

                    try:
                        if entry.is_file(follow_symlinks=False):
                            total += entry.stat(
                                follow_symlinks=False
                            ).st_size

                        elif entry.is_dir(follow_symlinks=False):
                            stack.append(entry.path)

                    except OSError:
                        complete = False

        except OSError:
            complete = False

        if not complete:
            break

    return total, complete


def safe_terraform_path(path):
    """Only permit .terraform directories strictly inside ROOT_DIR."""
    root = os.path.realpath(ROOT_DIR)
    candidate = os.path.abspath(path)

    if os.path.basename(candidate) != ".terraform":
        return False

    if os.path.islink(candidate):
        return False

    if os.path.commonpath([root, candidate]) != root or candidate == root:
        return False

    if os.path.realpath(os.path.dirname(candidate)) != os.path.dirname(candidate):
        return False

    return os.path.isdir(candidate)


def process_candidate(item, deadline):
    path = item["path"]
    size, complete = get_dir_size_fast(path, deadline)

    if item["type"] == "Numeric Build":
        with print_lock:
            if complete:
                print(
                    f"DRY RUN - Would delete: {path} "
                    f"({size / (1024 ** 2):.2f} MB)",
                    flush=True
                )
            else:
                print(
                    f"DRY RUN - Would delete: {path} "
                    f"(size incomplete; at least "
                    f"{size / (1024 ** 2):.2f} MB measured)",
                    flush=True
                )

        return {
            "type": "Numeric Build",
            "deleted": False,
            "size": size,
            "complete": complete,
            "error": False
        }

    if not safe_terraform_path(path):
        with print_lock:
            print(
                f"SKIPPED - Unsafe or missing Terraform directory: {path}",
                flush=True
            )

        return {
            "type": "Terraform",
            "deleted": False,
            "size": 0,
            "complete": False,
            "error": True
        }

    try:
        shutil.rmtree(path)

        with print_lock:
            if complete:
                print(
                    f"DELETED - Terraform: {path} "
                    f"({size / (1024 ** 2):.2f} MB)",
                    flush=True
                )
            else:
                print(
                    f"DELETED - Terraform: {path} "
                    f"(size incomplete; at least "
                    f"{size / (1024 ** 2):.2f} MB measured)",
                    flush=True
                )

        return {
            "type": "Terraform",
            "deleted": True,
            "size": size,
            "complete": complete,
            "error": False
        }

    except OSError as error:
        with print_lock:
            print(
                f"FAILED - Terraform: {path} ({error})",
                flush=True
            )

        return {
            "type": "Terraform",
            "deleted": False,
            "size": 0,
            "complete": False,
            "error": True
        }


def find_stale_dirs(root, cutoff):
    """Find all .terraform directories and stale numeric builds outside main."""
    stack = [(root, False)]
    stale_dirs = []

    scanned = 0
    skipped = 0
    errors = 0
    timed_out = False

    start_time = time.monotonic()
    now = time.time()

    while stack:
        if time.monotonic() - start_time >= MAX_SCAN_SECONDS:
            timed_out = True
            break

        current, under_main = stack.pop()
        scanned += 1

        if scanned % PROGRESS_INTERVAL == 0:
            print(
                f"Scanned: {scanned} | "
                f"Cleanup candidates: {len(stale_dirs)}",
                flush=True
            )

        try:
            with os.scandir(current) as entries:
                for entry in entries:

                    if time.monotonic() - start_time >= MAX_SCAN_SECONDS:
                        timed_out = True
                        break

                    try:
                        if not entry.is_dir(follow_symlinks=False):
                            continue

                        if entry.name in SKIP_DIRS:
                            skipped += 1
                            continue

                        is_terraform = entry.name == ".terraform"
                        is_main_branch = under_main or entry.name == "main"
                        is_numeric = entry.name.isdigit()

                        if is_terraform or (is_numeric and not is_main_branch):
                            modified = entry.stat(
                                follow_symlinks=False
                            ).st_mtime

                            if is_terraform or modified < cutoff:
                                age_days = int(
                                    (now - modified) / 86400
                                )

                                item = {
                                    "path": entry.path,
                                    "type": (
                                        "Terraform"
                                        if is_terraform
                                        else "Numeric Build"
                                    ),
                                    "modified": modified,
                                    "age_days": age_days
                                }

                                stale_dirs.append(item)

                                print(
                                    f"CANDIDATE ({age_days} days) | "
                                    f"Type: {item['type']} | "
                                    f"Last Modified: "
                                    f"{datetime.fromtimestamp(modified).strftime('%Y-%m-%d %H:%M:%S')} | "
                                    f"{entry.path}",
                                    flush=True
                                )

                                # Avoid duplicate counting.
                                continue

                        # Continue scanning main directories to find
                        # .terraform caches, but protect numeric builds.
                        stack.append((entry.path, is_main_branch))

                    except OSError as error:
                        errors += 1
                        print(
                            f"Cannot inspect {entry.path}: {error}",
                            flush=True
                        )

        except OSError as error:
            errors += 1
            print(
                f"Cannot access {current}: {error}",
                flush=True
            )

    return stale_dirs, {
        "scanned": scanned,
        "skipped": skipped,
        "errors": errors,
        "timed_out": timed_out,
        "elapsed": time.monotonic() - start_time
    }


def main():
    start_time = time.monotonic()
    cutoff = time.time() - STALE_DAYS * 86400

    print("======================================")
    print("JENKINS WORKSPACE CLEANUP - MIXED MODE")
    print("======================================")
    print(f"Scanning         : {ROOT_DIR}")
    print(f"Build retention  : {STALE_DAYS} days")
    print("Terraform cleanup: DELETE, all ages, all branches")
    print("Numeric builds   : DRY RUN only; main excluded")
    print(f"Max scan time    : {MAX_SCAN_SECONDS} seconds")
    print(f"Max size time    : {MAX_SIZE_SECONDS} seconds")
    print()

    if not os.path.isdir(ROOT_DIR) or os.path.islink(ROOT_DIR):
        print(
            f"ERROR: Missing or symlinked root directory: {ROOT_DIR}"
        )
        raise SystemExit(1)

    stale_dirs, stats = find_stale_dirs(ROOT_DIR, cutoff)

    terraform_count = sum(
        item["type"] == "Terraform"
        for item in stale_dirs
    )

    numeric_count = sum(
        item["type"] == "Numeric Build"
        for item in stale_dirs
    )

    print(f"\nFound {len(stale_dirs)} cleanup candidates")
    print(
        "Deleting Terraform directories; "
        "reporting stale builds only...\n"
    )

    size_deadline = time.monotonic() + MAX_SIZE_SECONDS
    results = []

    with ThreadPoolExecutor(max_workers=MAX_WORKERS) as executor:
        futures = [
            executor.submit(
                process_candidate, item, size_deadline
            )
            for item in stale_dirs
        ]

        for future in as_completed(futures):
            results.append(future.result())

    deleted = [
        r for r in results
        if r["type"] == "Terraform" and r["deleted"]
    ]

    dry_run = [
        r for r in results
        if r["type"] == "Numeric Build"
    ]

    failed = sum(r["error"] for r in results)
    complete_sizes = sum(r["complete"] for r in results)
    incomplete_sizes = len(results) - complete_sizes

    actual_bytes = sum(r["size"] for r in deleted)
    potential_bytes = sum(r["size"] for r in dry_run)

    print("\n======================================")
    print("CLEANUP SUMMARY")
    print("======================================")
    print(f"Directories scanned          : {stats['scanned']}")
    print(f"Directories skipped          : {stats['skipped']}")
    print(f"Terraform directories found  : {terraform_count}")
    print(f"Terraform directories deleted: {len(deleted)}")
    print(f"Terraform deletion failures  : {failed}")
    print(f"Stale numeric directories    : {numeric_count}")
    print("Stale numeric deleted        : 0 (DRY RUN)")
    print(f"Total cleanup candidates     : {len(stale_dirs)}")
    print(f"Sizes fully calculated       : {complete_sizes}")
    print(f"Sizes incomplete             : {incomplete_sizes}")
    print(
        f"Deleted Terraform data size  : "
        f"{actual_bytes / (1024 ** 3):.2f} GB (estimated)"
    )
    print(
        f"Potential stale build saving : "
        f"{potential_bytes / (1024 ** 3):.2f} GB"
    )
    print(
        f"Space estimate               : "
        f"{'PARTIAL' if incomplete_sizes else 'COMPLETE'}"
    )
    print(f"Scan errors                  : {stats['errors']}")
    print(
        f"Execution time               : "
        f"{time.monotonic() - start_time:.2f} seconds"
    )

    scan_status = (
        "PARTIAL"
        if stats["timed_out"] or stats["errors"]
        else "COMPLETE WITH EXCLUSIONS"
    )

    print(f"Scan status                  : {scan_status}")
    print("======================================")

    if failed:
        raise SystemExit(1)


if __name__ == "__main__":
    main()



