echo "========================================"
echo "Checking Jenkins container directories"
echo "========================================"

docker exec jenkins sh -c '
echo "Current user:"
whoami

echo ""
echo "JENKINS_HOME:"
echo "$JENKINS_HOME"

echo ""
echo "Checking common plugin locations:"

for dir in \
  /home/jenkins/plugins \
  /var/jenkins_home/plugins \
  /usr/share/jenkins/ref/plugins \
  /home/jenkins/jobs
do
  if [ -d "$dir" ]; then
    echo "FOUND: $dir"
    find "$dir" -maxdepth 1 -type f \( -name "*.jpi" -o -name "*.hpi" \) 2>/dev/null | wc -l
  else
    echo "NOT FOUND: $dir"
  fi
done

echo ""
echo "Searching for plugin archives:"
find /home /opt /usr/share /var -type f \
  \( -name "*.jpi" -o -name "*.hpi" \) \
  2>/dev/null | head -30
'
