set -euo pipefail

PLUGIN_CACHE_DIR="/tmp/jenkins-plugin-cache"
S3_PLUGIN_CACHE="s3://jenkins-binaries-213141505949/jenkins-plugin-cache/"

echo "========================================"
echo "Jenkins Plugin Cache Upload"
echo "========================================"

# Verify Jenkins container is running
docker inspect -f '{{.State.Running}}' jenkins | grep -qx true

# Create a clean local cache directory
rm -rf "$PLUGIN_CACHE_DIR"
mkdir -p "$PLUGIN_CACHE_DIR"

# Copy installed plugins from Jenkins Controller
echo "Copying Jenkins plugins from container..."

docker cp \
  jenkins:/home/jenkins/plugins/. \
  "$PLUGIN_CACHE_DIR/"

# Count plugin archives
PLUGIN_COUNT=$(find "$PLUGIN_CACHE_DIR" -maxdepth 1 -type f \
  \( -name "*.jpi" -o -name "*.hpi" \) | wc -l)

echo "Plugins found: $PLUGIN_COUNT"

# Stop if no plugins exist
if [ "$PLUGIN_COUNT" -eq 0 ]; then
  echo "ERROR: No plugin archives found. Upload cancelled."
  exit 1
fi

# Upload plugins to S3
echo "Uploading plugins to S3..."

aws s3 sync \
  "$PLUGIN_CACHE_DIR/" \
  "$S3_PLUGIN_CACHE" \
  --exclude "*" \
  --include "*.jpi" \
  --include "*.hpi" \
  --region us-east-1

echo "========================================"
echo "Upload completed successfully"
echo "========================================"
