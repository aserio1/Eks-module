# Retrieve the private key from SSM Parameter Store dynamically based on the environment
data "aws_ssm_parameter" "jenkins_agent_private_key" {
  name            = "/ec2/keypair/${var.prefix}_jenkins_agent_private_key"
  with_decryption = true
}

# Retrieve the public key from SSM Parameter Store
data "aws_ssm_parameter" "jenkins_agent_public_key" {
  name            = "/ec2/keypair/${var.prefix}_jenkins_agent_public_key"
  with_decryption = true
}

# Retrieve the key pair
data "aws_key_pair" "jenkins_agent_linux" {
  key_name = "${var.prefix}_jenkins_agent_private_key"
}

data "aws_ecr_image" "agent_image" {
  repository_name = var.agent_image
  image_tag       = var.agent_tag
}

# Fetch the Tenable key from SSM
data "aws_ssm_parameter" "tenable_agent_key" {
  name            = "/imac/jenkins/tenable-agent-key"
  with_decryption = true
}

# This data source will error out on plan/apply if the AMI no longer exists,
# rather than silently succeeding and failing later at instance launch time.
data "aws_ami" "validate_pinned" {
  filter {
    name   = "image-id"
    values = [var.ami_id]
  }
}



