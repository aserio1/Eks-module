variable.tf
#############
variable "jenkins_docker_tag_dev" {
  type        = string
  description = "Docker image tag for Jenkins controller and agents in DEV"
}

variable "jenkins_docker_tag_prod" {
  type        = string
  description = "Docker image tag for Jenkins controller and agents in PROD"
}


locals.tf
######
controller_tag = (
  var.prefix == "prod"
  ? var.jenkins_docker_tag_prod
  : var.jenkins_docker_tag_dev
)

default_agent_tag = (
  var.prefix == "prod"
  ? var.jenkins_docker_tag_prod
  : var.jenkins_docker_tag_dev
)

######
tfvars

prefix = "dev"

jenkins_docker_tag_dev  = "DEV_IMAGE_TAG"
jenkins_docker_tag_prod = "PROD_IMAGE_TAG"


prefix = "prod"

jenkins_docker_tag_dev  = "DEV_IMAGE_TAG"
jenkins_docker_tag_prod = "PROD_IMAGE_TAG"
