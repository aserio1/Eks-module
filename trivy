echo "=== AWS Identity ==="
aws sts get-caller-identity

echo "=== Jenkins Container ==="
docker ps --filter "name=^/jenkins$"

echo "=== Jenkins Home ==="
docker exec jenkins sh -c 'echo "$JENKINS_HOME"'

echo "=== Plugin Directory ==="
docker exec jenkins sh -c '
ls -ld /home/jenkins/plugins 2>&1
find /home/jenkins/plugins -maxdepth 1 -type f \
  \( -name "*.jpi" -o -name "*.hpi" \) 2>/dev/null | wc -l
'
