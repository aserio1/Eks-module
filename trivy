pipeline_policy_check.sh
######################
#!/bin/bash
set -euo pipefail

# Use OPA_DECISION and INPUT_JSON env var from Groovy, default to required_scan_steps if not set
POLICIES_ROOT_DIR="opa_policies"
DECISION="${OPA_DECISION:-cdo/pipelines/required_steps/deny}"
INPUT_JSON="${OPA_INPUT_JSON:-policy_input.json}"
TECH_STACK_FILE="tech_stack.json"
PIPELINE_STEPS_FILE="pipeline_steps.json"

echo "[GOVERNANCE] Starting OPA pipeline policy evaluation..." >&2
echo "[GOVERNANCE] Using decision: ${DECISION}" >&2
echo "[GOVERNANCE] Using input JSON: ${INPUT_JSON}" >&2

# Only build/merge input when using the default required-scan input file.
if [[ "${INPUT_JSON}" == "policy_input.json" ]]; then
  echo "[GOVERNANCE] Merging tech stack + Jenkins pipeline steps into ${INPUT_JSON}" >&2

  if [[ -f "${TECH_STACK_FILE}" ]]; then
    tech_runtimes=$(jq -r '.tech_stack // []' "${TECH_STACK_FILE}")
  else
    tech_runtimes="[]"
  fi

  if [[ -f "${PIPELINE_STEPS_FILE}" ]]; then
    pipeline_steps=$(jq -r '.gov_steps // []' "${PIPELINE_STEPS_FILE}")
  else
    pipeline_steps="[]"
  fi

  jq -n \
    --argjson runtimes "${tech_runtimes}" \
    --argjson steps "${pipeline_steps}" \
    '{ tech: { runtimes: $runtimes }, jenkins: { steps: $steps } }' \
    > "${INPUT_JSON}"

  if [[ "${GOVERNANCE_DEBUG:-false}" == "true" ]]; then
    echo "[GOVERNANCE] Generated OPA pipeline input:" >&2
    cat "${INPUT_JSON}" >&2
  fi
else
  if [[ ! -f "${INPUT_JSON}" ]]; then
    echo "[GOVERNANCE] ERROR: Input JSON not found: ${INPUT_JSON}" >&2
    exit 1
  fi
  if [[ "${GOVERNANCE_DEBUG:-false}" == "true" ]]; then
    echo "[GOVERNANCE] Using pre-built input JSON:" >&2
    cat "${INPUT_JSON}" >&2
  fi
fi

# OPA_NEVER_FAIL=true skips --fail-non-empty for warn-only decisions, where a
# non-empty result is expected and should not fail the build.
OPA_ARGS=(--format json --decision "${DECISION}" --bundle "${POLICIES_ROOT_DIR}")
if [[ "${OPA_NEVER_FAIL:-false}" != "true" ]]; then
  OPA_ARGS+=(--fail-non-empty)
fi

echo "[GOVERNANCE] Running OPA exec with decision: ${DECISION}" >&2
if opa exec "${OPA_ARGS[@]}" "${INPUT_JSON}"; then
  echo "[GOVERNANCE] OPA pipeline policy check PASSED: ${DECISION}" >&2
else
  if [[ "${OPA_NEVER_FAIL:-false}" == "true" ]]; then
    echo "[GOVERNANCE] OPA pipeline policy check completed with warnings (non-blocking): ${DECISION}" >&2
  else
    echo "[GOVERNANCE] OPA pipeline policy check FAILED: ${DECISION}" >&2
    exit 1
  fi
fi

echo "[GOVERNANCE] OPA pipeline policy evaluation complete." >&2
