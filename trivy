
#!/usr/bin/env python3

# This script identifies recursively .terraform dirs
# found in /home/jenkins/workspace.
# Also identifies stale Jenkins workspaces older than 90 days
# and checks whether the corresponding Jenkins job still exists.
# Executed via a Jenkins job that runs daily during off hours.
# DRY-RUN only until active-build validation is implemented.

import os
import sys
import time
import shutil
import argparse
import json
import urllib.request
import urllib.parse
import urllib.error
import base64
import re
from concurrent.futures import ThreadPoolExecutor, as_completed
from threading import Lock

ROOT_DIR = "/home/jenkins/workspace"
MAX_WORKERS = 8  # Tune based on EFS throughput limits
STALE_DAYS = 90

print_lock = Lock()
stats_lock = Lock()
freed_space = 0


def get_dir_size_fast(path):
    """Use os.scandir recursively for faster size calculation."""
    total = 0
    try:
        with os.scandir(path) as it:
            for entry in it:
                try:
                    if entry.is_file(follow_symlinks=False):
                        total += entry.stat(follow_symlinks=False).st_size
                    elif entry.is_dir(follow_symlinks=False):
                        total += get_dir_size_fast(entry.path)
                except (PermissionError, FileNotFoundError):
                    pass
    except (PermissionError, FileNotFoundError):
        pass
    return total


def delete_directory(path):
    """Delete a directory and return estimated bytes freed."""
    try:
        root = os.path.realpath(ROOT_DIR)
        target = os.path.realpath(path)

        if os.path.commonpath([root, target]) != root:
            raise ValueError("Directory is outside workspace root")

        if target == root:
            raise ValueError("Cannot delete workspace root")

        if os.path.islink(path):
            raise ValueError("Cannot delete symbolic link")

        size = get_dir_size_fast(path)

        shutil.rmtree(path)

        with print_lock:
            print(f"Deleted: {path}")

        return size

    except Exception as e:
        with print_lock:
            print(f"Failed to delete {path}: {e}")
        return 0


def delete_terraform_dir(path):
    """Delete a single .terraform dir and return bytes freed."""
    return delete_directory(path)


def delete_stale_workspace(path):
    """Delete a stale Jenkins workspace and return bytes freed."""
    return delete_directory(path)


def find_terraform_dirs(root):
    """
    Walk the tree with os.scandir and prune traversal into .terraform dirs
    (no need to recurse into them — we're deleting the whole thing).
    """
    try:
        with os.scandir(root) as it:
            for entry in it:
                if not entry.is_dir(follow_symlinks=False):
                    continue
                if entry.name == ".terraform":
                    yield entry.path
                else:
                    yield from find_terraform_dirs(entry.path)
    except (PermissionError, FileNotFoundError) as e:
        print(f"Cannot access {root}: {e}")


def find_stale_workspaces(root):
    """
    Find top-level Jenkins workspace directories older than 90 days.
    Includes old PR workspaces, @tmp, @2, and @3 directories.
    """
    cutoff = time.time() - (STALE_DAYS * 86400)

    try:
        with os.scandir(root) as it:
            for entry in it:
                try:
                    if not entry.is_dir(follow_symlinks=False):
                        continue

                    if entry.stat(follow_symlinks=False).st_mtime < cutoff:
                        yield entry.path

                except (PermissionError, FileNotFoundError):
                    pass

    except (PermissionError, FileNotFoundError) as e:
        print(f"Cannot access {root}: {e}")


def get_jenkins_jobs():
    """
    Retrieve Jenkins jobs using the existing Jenkins controller environment.
    No Jenkins credential configuration is modified.
    """
    jenkins_url = os.environ.get("JENKINS_URL", "").rstrip("/")

    if not jenkins_url:
        raise RuntimeError("JENKINS_URL is not available")

    jenkins_user = os.environ.get("JENKINS_USER", "")
    jenkins_token = os.environ.get("JENKINS_API_TOKEN", "")

    headers = {
        "Accept": "application/json"
    }

    if jenkins_user and jenkins_token:
        credentials = base64.b64encode(
            f"{jenkins_user}:{jenkins_token}".encode()
        ).decode()

        headers["Authorization"] = f"Basic {credentials}"

    jobs = {}
    pending = [(jenkins_url, "")]

    while pending:
        url, parent = pending.pop()

        request = urllib.request.Request(
            url + "/api/json?tree=jobs[name,url,_class]",
            headers=headers
        )

        with urllib.request.urlopen(request, timeout=30) as response:
            data = json.load(response)

        if "jobs" not in data:
            raise RuntimeError(
                f"Jenkins job listing unavailable at {url}"
            )

        for job in data["jobs"]:
            name = job["name"]
            full_name = f"{parent}/{name}" if parent else name

            jobs[full_name] = job

            job_class = job.get("_class", "")

            if any(value in job_class for value in (
                "Folder",
                "WorkflowMultiBranchProject",
                "OrganizationFolder"
            )):
                pending.append((job["url"].rstrip("/"), full_name))

    return jobs


def get_workspace_job_name(path):
    """
    Normalize Jenkins workspace names.
    Remove @tmp and concurrent workspace suffixes.
    """
    name = os.path.basename(path)

    if name.endswith("@tmp"):
        name = name[:-4]

    name = re.sub(r"@\d+$", "", name)

    return name


def find_matching_job(workspace, jobs):
    """
    Match workspace against existing Jenkins jobs.
    Matching is informational, not deletion authorization.
    """
    name = get_workspace_job_name(workspace)

    if name in jobs:
        return name

    matches = []

    for full_name in jobs:
        if full_name.replace("/", "_") == name:
            matches.append(full_name)

    if len(matches) == 1:
        return matches[0]

    return None


def main():
    global freed_space

    parser = argparse.ArgumentParser()
    parser.add_argument(
        "--execute",
        action="store_true",
        help="Reserved for validated production cleanup"
    )
    args = parser.parse_args()

    print(f"Scanning: {ROOT_DIR}\n")
    print(f"Retention period: {STALE_DAYS} days")
    print(f"Mode: {'EXECUTE' if args.execute else 'DRY-RUN'}\n")

    if not os.path.isdir(ROOT_DIR):
        print(f"ERROR: Workspace root not found: {ROOT_DIR}")
        sys.exit(1)

    if args.execute:
        print("ERROR: Execution is disabled until active-build")
        print("and Jenkins workspace validation are implemented.")
        sys.exit(1)

    try:
        jobs = get_jenkins_jobs()
        print(f"Retrieved {len(jobs)} Jenkins jobs\n")

    except Exception as e:
        print(f"WARNING: Unable to validate Jenkins jobs: {e}")
        print("Workspace matches will be reported as UNKNOWN.\n")
        jobs = None

    stale_workspaces = list(find_stale_workspaces(ROOT_DIR))
    print(f"Found {len(stale_workspaces)} stale workspaces\n")

    stale_space = 0

    for workspace in stale_workspaces:
        size = get_dir_size_fast(workspace)
        stale_space += size

        if jobs is None:
            status = "UNKNOWN - Jenkins API unavailable"
        else:
            job = find_matching_job(workspace, jobs)

            if job:
                status = f"SKIPPED - Jenkins job exists ({job})"
            else:
                status = "REVIEW REQUIRED - Jenkins job not matched"

        print(f"Workspace: {workspace}")
        print(f"Status   : {status}")
        print(f"Size     : {size / (1024 ** 3):.2f} GiB\n")

    terraform_dirs = list(find_terraform_dirs(ROOT_DIR))

    print(f"\nFound {len(terraform_dirs)} .terraform directories\n")

    terraform_space = 0

    for path in terraform_dirs:
        size = get_dir_size_fast(path)
        terraform_space += size

        print(f"Terraform directory: {path}")
        print(f"Size               : {size / (1024 ** 3):.2f} GiB\n")

    print("======================================")
    print("JENKINS EFS CLEANUP DRY-RUN SUMMARY")
    print("======================================")
    print(f"Jenkins jobs found       : {len(jobs) if jobs is not None else 'UNKNOWN'}")
    print(f"Stale workspaces found   : {len(stale_workspaces)}")
    print(f"Stale workspace size     : {stale_space / (1024 ** 3):.2f} GiB")
    print(f"Terraform dirs found     : {len(terraform_dirs)}")
    print(f"Terraform directory size : {terraform_space / (1024 ** 3):.2f} GiB")
    print("Estimated space freed    : Not calculated (deletion not approved)")
    print("======================================")
    print("DRY-RUN: No directories were deleted.")
    print("Cleanup scan completed.")


if __name__ == "__main__":
    main()
