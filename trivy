
#!/usr/bin/env python3

# Jenkins Workspace Cleanup - FAST DRY RUN
#
# Uses Jenkins workspace pattern:
# workspace/${JOB_NAME.replace('%2F','/')}/${BUILD_NUMBER}
#
# No hardcoded Jenkins project folders.
# No EFS mount requirement.
# No recursive size calculations.
# No files or directories deleted.

import os
import sys
import time
from pathlib import Path

MAX_WORKERS = 8
STALE_DAYS = 90

MAX_SCAN_SECONDS = 300
PROGRESS_INTERVAL = 5000


def get_workspace_root():
    """
    Derive workspace root from Jenkins environment.

    Expected pattern:
      <root>/<JOB_NAME>/<BUILD_NUMBER>

    JOB_NAME may contain nested folders and branch names.
    """

    workspace = os.environ.get("WORKSPACE")
    job_name = os.environ.get("JOB_NAME")
    build_number = os.environ.get("BUILD_NUMBER")

    if not all((workspace, job_name, build_number)):
        print(
            "ERROR: WORKSPACE, JOB_NAME and BUILD_NUMBER "
            "must be available."
        )
        sys.exit(1)

    if not build_number.isdigit():
        print("ERROR: Invalid BUILD_NUMBER.")
        sys.exit(1)

    job_parts = [
        part
        for part in job_name.replace("%2F", "/").split("/")
        if part
    ]

    # Resolve the known Jenkins workspace suffix.
    suffix = Path(*job_parts, build_number)

    workspace_path = Path(workspace).resolve()

    # Jenkins ws() may be nested further for script execution.
    # Find the expected job/build suffix in the workspace path.
    parts = workspace_path.parts
    suffix_parts = suffix.parts

    for i in range(len(parts) - len(suffix_parts) + 1):
        if tuple(parts[i:i + len(suffix_parts)]) == suffix_parts:
            return Path(*parts[:i])

    print(
        "ERROR: Cannot derive workspace root from "
        "WORKSPACE/JOB_NAME/BUILD_NUMBER."
    )
    print(f"WORKSPACE    : {workspace}")
    print(f"JOB_NAME     : {job_name}")
    print(f"BUILD_NUMBER : {build_number}")
    sys.exit(1)


def scan_workspaces(root, current_workspace):
    """
    Find stale numeric build directories.

    Does not recurse into numeric build directories.
    Does not inspect file contents.
    Does not delete anything.
    """

    cutoff = time.time() - (STALE_DAYS * 86400)
    start = time.monotonic()

    stack = [Path(root)]
    current = Path(current_workspace).resolve()

    scanned = 0
    stale = 0
    skipped = 0
    errors = 0
    timed_out = False

    while stack:

        if time.monotonic() - start >= MAX_SCAN_SECONDS:
            timed_out = True
            break

        directory = stack.pop()

        try:
            with os.scandir(directory) as entries:
                for entry in entries:

                    try:
                        if not entry.is_dir(
                            follow_symlinks=False
                        ):
                            continue

                        scanned += 1
                        path = Path(entry.path)

                        # Skip the current job workspace and
                        # all of its parent directories.
                        resolved = path.resolve()

                        if (
                            resolved == current
                            or resolved in current.parents
                        ):
                            skipped += 1

                            # Still need to traverse parent
                            # folders to discover other jobs.
                            if resolved != current:
                                stack.append(path)

                            continue

                        if entry.name.isdigit():
                            info = entry.stat(
                                follow_symlinks=False
                            )

                            if info.st_mtime < cutoff:
                                stale += 1

                            # Do not scan inside build folders.
                            continue

                        stack.append(path)

                        if scanned % PROGRESS_INTERVAL == 0:
                            print(
                                f"Scanned: {scanned} | "
                                f"Stale build folders: {stale}",
                                flush=True
                            )

                    except OSError:
                        errors += 1

        except OSError:
            errors += 1

    return {
        "scanned": scanned,
        "stale": stale,
        "skipped": skipped,
        "errors": errors,
        "timed_out": timed_out,
        "elapsed": time.monotonic() - start
    }


def main():

    root = get_workspace_root()
    current_workspace = os.environ["WORKSPACE"]

    if not root.is_dir():
        print(f"ERROR: Workspace root not found: {root}")
        sys.exit(1)

    print("======================================")
    print("JENKINS WORKSPACE CLEANUP - DRY RUN")
    print("======================================")
    print(f"Workspace root : {root}")
    print(f"Current job    : {os.environ['JOB_NAME']}")
    print(f"Build number   : {os.environ['BUILD_NUMBER']}")
    print(f"Retention      : {STALE_DAYS} days")
    print("Mode           : DRY-RUN")
    print()

    results = scan_workspaces(root, current_workspace)

    print()
    print("======================================")
    print("DRY-RUN SUMMARY")
    print("======================================")
    print(f"Directories scanned       : {results['scanned']}")
    print(f"Stale build directories   : {results['stale']}")
    print(f"Directories skipped       : {results['skipped']}")
    print(f"Scan errors               : {results['errors']}")
    print(f"Execution time            : {results['elapsed']:.2f} seconds")
    print(
        f"Scan status               : "
        f"{'PARTIAL' if results['timed_out'] or results['errors'] else 'COMPLETE'}"
    )
    print("Directories deleted       : 0")
    print("Files deleted             : 0")
    print("======================================")
    print("DRY-RUN COMPLETE - NO DELETION")
    print("======================================")


if __name__ == "__main__":
    main()
