################################################################################
# modules/jenkins_agent/variables.tf
################################################################################

variable "prefix" {
  type        = string
  description = "Prefix for all resources created."
}

variable "project" {
  type        = string
  description = "Project to associate the node with. Should contain letters and '-', no spaces."
}

variable "jenkins_main_url" {
  type        = string
  description = "URL of the ALB for the main Jenkins node"
}

variable "ami_id" {
  type        = string
  description = "Hardened AMI to build off of"
}

variable "subnet_ids" {
  type        = list(string)
  description = "Subnet to build in"
}

variable "instance_type" {
  type        = string
  description = "AWS EC2 Instance Type"
  default     = "t3.medium"
}

variable "ebs_size" {
  type        = number
  description = "Size of the root EBS node"
}

variable "security_group_ids" {
  type        = list(any)
  description = "SGs to associate with the agent"
}

variable "jenkins_controller_policies" {
  type        = set(string)
  description = "Additional policies needed for each agent. Not used when agent_type is 'scanner'."
  default     = []
}

variable "environments" {
  type        = list(map(string))
  description = "List of all ENVs. Not used when agent_type is 'scanner'."
  default     = []
}

variable "username" {
  type        = string
  description = "Admin username of the main instance"
  default     = "SVC-Jenkins-Agent"
}

variable "efs_mount_target" {
  type        = string
  description = "Mount point for the EFS volume."
}

variable "ecr_repo_account_id" {
  type        = string
  description = "AWS Account ID of the ECR repo to pull from"
}

variable "agent_image" {
  type        = string
  description = "Docker Image to use for the Jenkins Agents"
  default     = "jenkins_agent"
}

variable "agent_tag" {
  type        = string
  description = "Which version of the docker image to use"
  default     = "latest"
}

variable "tags" {
  type        = map(string)
  description = "Default tags to apply to resources"
}

variable "kms_key_arn" {
  description = "KMS key ARN for EBS encryption"
  type        = string
}

variable "agent_asg_instance_size" {
  type        = number
  description = "Size of the Jenkins agent ASG min/max. Not used when agent_type is 'scanner' — hardcoded to 1."
  default     = 1
}

variable "always_on_agent_nodes" {
  type        = list(string)
  description = "Jenkins agent nodes that need to keep running. Not used when agent_type is 'scanner'."
  default     = []
}

variable "agent_type" {
  type        = string
  description = "Type of Jenkins agent. Controls user_data template and IAM policies applied."
  default     = "regular"

  validation {
    condition     = contains(["regular", "scanner"], var.agent_type)
    error_message = "agent_type must be either 'regular' or 'scanner'."
  }
}

variable "reports_bucket_arn" {
  type        = string
  description = "ARN of the S3 bucket where scanner reports are written. Required when agent_type is 'scanner'."
  default     = null
}


