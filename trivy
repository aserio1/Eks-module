variable.tf
###############
################################################################################
# jenkins/variables.tf
################################################################################

variable "prefix" {
  type        = string
  description = "Prefix for all resources created."
}

variable "allowed_agents" {
  type        = list(string)
  description = "List of agents to deploy.  Should be in the form of $team_$environment."
  default     = []
}

variable "jenkins_controller_size" {
  type        = string
  description = "Instance size of the controller node."
}

variable "jenkins_docker_tag" {
  type        = string
  description = "Docker TAG to use for agent and controller images"
}

variable "jenkins_idp_entity_id" {
  type        = string
  description = "The SP Entity Identifier of the authentication identity provider application for Jenkins"
}

variable "jenkins_idp_metadata_url" {
  type        = string
  description = "The metadata url of the authentication identity provider application for Jenkins"
}

variable "monitored_agent" {
  type        = string
  description = "Agent name to be monitored"
}

variable "team_email" {
  type        = string
  description = "Team email address for Jenkins alerts"
}
variable "jenkins_email_subscriptions" {
  type = list(object({
    email         = string
    filter_policy = map(list(string))
  }))
  description = "List of email subscriptions with their filter policies"
}

variable "base_ami_id" {
  description = <<-EOT
    Pinned AMI ID for Jenkins, shared by the OCIO team from account 415774707382.
    This is intentionally NOT a dynamic lookup (see https://alm.aws.hhsoig.gov/browse/IMAC-1341:
    a `most_recent` lookup picked up a newly-published AMI which was later deleted,
    causing an ASG scale-up failure).

    To update: use the current stable AMI ID from the OCIO team (via email/teams)
    and bump this value via PR. Do not revert to a dynamic data source lookup.
  EOT
  type        = string

  validation {
    condition     = can(regex("^ami-[a-f0-9]{8,17}$", var.base_ami_id))
    error_message = "base_ami_id must be a valid AMI ID (e.g. ami-0123456789abcdef0)."
  }
}

variable "agent_asg_instance_size" {
  type        = number
  description = "Size of the Jenkins agent instance min/max size"
}

variable "efs_threshold_gib" {
  description = "Size threshold in GiB at which to alarm"
  type        = number
}

variable "always_on_agent_nodes" {
  type        = list(string)
  description = "Jenkins agent nodes that need to keep running in an environment"
}

variable "cw_retention" {
  description = "Cloudwatch log group retention days"
  type        = number
}

variable "enable_cloudwatch_build_logs" {
  description = "Set to true|false to include the cloudwatch agent configuration"
  type        = bool
}
