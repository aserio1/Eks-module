
#!/usr/bin/env python3

# Jenkins EFS Cleanup
#
# Deletes .terraform directories found in Jenkins workspace.
# Identifies stale Jenkins build directories older than 90 days.
# Generates a CSV report for Jenkins artifacts.
# Uses df to calculate filesystem usage before and after cleanup.
#
# .terraform directories: DELETE
# Stale Jenkins build directories: REPORT ONLY

import os
import sys
import csv
import time
import shutil
import argparse
import subprocess

from datetime import datetime, timezone
from concurrent.futures import ThreadPoolExecutor, as_completed
from threading import Lock

ROOT_DIR = "/home/jenkins/workspace"
MAX_WORKERS = 8
STALE_DAYS = 90

MAX_SCAN_SECONDS = 300
PROGRESS_INTERVAL = 5000

CSV_FILE = "jenkins_stale_list.csv"

print_lock = Lock()


def format_date(timestamp):
    """Convert modification timestamp to readable UTC date."""

    return datetime.fromtimestamp(
        timestamp,
        tz=timezone.utc
    ).strftime("%Y-%m-%d %H:%M:%S UTC")


def get_filesystem_usage(path):
    """
    Retrieve filesystem usage using df.

    This reports the entire mounted filesystem,
    not the size of the workspace directory alone.
    """

    try:
        result = subprocess.run(
            ["df", "-B1", "-P", path],
            capture_output=True,
            text=True,
            check=True,
            timeout=30
        )

        lines = result.stdout.strip().splitlines()

        if len(lines) < 2:
            raise RuntimeError("Unexpected df output")

        fields = lines[-1].split()

        return {
            "filesystem": fields[0],
            "total": int(fields[1]),
            "used": int(fields[2]),
            "available": int(fields[3])
        }

    except Exception as error:
        print(
            f"WARNING: Unable to retrieve filesystem usage: {error}",
            flush=True
        )
        return None


def get_dir_size_fast(path):
    """
    Calculate file sizes inside a .terraform directory only.

    Does not calculate the entire workspace size.
    """

    total = 0
    stack = [path]

    while stack:

        current = stack.pop()

        try:
            with os.scandir(current) as entries:

                for entry in entries:

                    try:
                        if entry.is_file(follow_symlinks=False):

                            total += entry.stat(
                                follow_symlinks=False
                            ).st_size

                        elif entry.is_dir(follow_symlinks=False):

                            stack.append(entry.path)

                    except OSError:
                        pass

        except OSError:
            pass

    return total


def scan_workspaces(root, stale_days, max_seconds):
    """
    Discover:
      1. All .terraform directories.
      2. Numeric Jenkins build-directory candidates
         older than the retention period.

    Stop scanning when the configured time limit is reached.
    """

    cutoff = time.time() - (stale_days * 86400)
    start_time = time.monotonic()

    stack = [root]

    terraform_dirs = []
    stale_build_dirs = []

    stats = {
        "directories_scanned": 0,
        "terraform_found": 0,
        "stale_terraform": 0,
        "build_dirs_found": 0,
        "stale_build_dirs": 0,
        "errors": 0,
        "timed_out": False
    }

    while stack:

        if time.monotonic() - start_time >= max_seconds:
            stats["timed_out"] = True
            break

        current = stack.pop()
        stats["directories_scanned"] += 1

        if stats["directories_scanned"] % PROGRESS_INTERVAL == 0:

            print(
                f"Scanned: {stats['directories_scanned']} | "
                f"Terraform: {stats['terraform_found']} | "
                f"Stale builds: {stats['stale_build_dirs']}",
                flush=True
            )

        try:

            with os.scandir(current) as entries:

                for entry in entries:

                    try:

                        if not entry.is_dir(follow_symlinks=False):
                            continue

                        info = entry.stat(follow_symlinks=False)

                        if entry.name == ".terraform":

                            stats["terraform_found"] += 1

                            if info.st_mtime < cutoff:
                                stats["stale_terraform"] += 1

                            terraform_dirs.append({
                                "path": entry.path,
                                "mtime": info.st_mtime
                            })

                            continue

                        if entry.name.isdigit():

                            stats["build_dirs_found"] += 1

                            if info.st_mtime < cutoff:

                                stats["stale_build_dirs"] += 1

                                stale_build_dirs.append({
                                    "path": entry.path,
                                    "mtime": info.st_mtime
                                })

                        stack.append(entry.path)

                    except OSError as error:

                        stats["errors"] += 1

                        print(
                            f"WARNING: Cannot inspect "
                            f"{entry.path}: {error}",
                            flush=True
                        )

        except OSError as error:

            stats["errors"] += 1

            print(
                f"WARNING: Cannot scan {current}: {error}",
                flush=True
            )

    stats["elapsed"] = time.monotonic() - start_time

    return terraform_dirs, stale_build_dirs, stats


def delete_terraform_dir(item):
    """
    Delete a .terraform directory and estimate bytes reclaimed.

    All discovered .terraform directories are deleted
    regardless of age, matching the original cleanup job.
    """

    path = item["path"]

    try:

        size = get_dir_size_fast(path)

        shutil.rmtree(path)

        with print_lock:

            print(
                f"Deleted: {path} | "
                f"Estimated reclaimed: "
                f"{size / (1024 ** 2):.2f} MB",
                flush=True
            )

        return {
            **item,
            "status": "Deleted",
            "bytes_freed": size
        }

    except Exception as error:

        with print_lock:

            print(
                f"Failed to delete {path}: {error}",
                flush=True
            )

        return {
            **item,
            "status": f"Failed: {error}",
            "bytes_freed": 0
        }


def write_csv(filename, terraform_results, stale_build_dirs):
    """
    Generate CSV report of Terraform cleanup and
    stale Jenkins build-directory candidates.
    """

    now = time.time()

    with open(
        filename,
        "w",
        newline="",
        encoding="utf-8"
    ) as csvfile:

        writer = csv.writer(csvfile)

        writer.writerow([
            "Type",
            "Directory Path",
            "Last Modified",
            "Age (Days)",
            "Cleanup Status",
            "Space Reclaimed (MB)"
        ])

        for item in sorted(
            terraform_results,
            key=lambda x: x["path"]
        ):

            writer.writerow([
                ".terraform",
                item["path"],
                format_date(item["mtime"]),
                int((now - item["mtime"]) / 86400),
                item["status"],
                round(
                    item.get("bytes_freed", 0) / (1024 ** 2),
                    2
                )
            ])

        for item in sorted(
            stale_build_dirs,
            key=lambda x: x["path"]
        ):

            writer.writerow([
                "Stale Build Directory",
                item["path"],
                format_date(item["mtime"]),
                int((now - item["mtime"]) / 86400),
                "Dry Run - Not Deleted",
                0
            ])

    print(
        f"CSV report generated: {os.path.abspath(filename)}",
        flush=True
    )


def main():

    parser = argparse.ArgumentParser(
        description="Jenkins EFS cleanup with CSV reporting"
    )

    parser.add_argument(
        "--root",
        default=ROOT_DIR
    )

    parser.add_argument(
        "--stale-days",
        type=int,
        default=STALE_DAYS
    )

    parser.add_argument(
        "--max-seconds",
        type=int,
        default=MAX_SCAN_SECONDS
    )

    parser.add_argument(
        "--csv",
        default=CSV_FILE
    )

    args = parser.parse_args()

    if args.stale_days < 0 or args.max_seconds <= 0:
        parser.error("Invalid retention or scan-time value")

    root = os.path.abspath(args.root)
    csv_path = os.path.abspath(args.csv)

    print("======================================")
    print("JENKINS EFS CLEANUP")
    print("======================================")
    print(f"Scanning          : {root}")
    print(f"Retention period  : {args.stale_days} days")
    print(f"Max scan time     : {args.max_seconds} seconds")
    print(f"CSV report        : {csv_path}")
    print("Terraform cleanup : ENABLED")
    print("Stale builds      : REPORT ONLY")
    print()

    if not os.path.isdir(root):

        print(
            f"ERROR: Workspace directory not accessible: {root}",
            file=sys.stderr
        )

        sys.exit(1)

    # Retrieve initial filesystem usage without recursive scanning.
    initial_usage = get_filesystem_usage(root)

    if initial_usage:
        print(
            f"Initial filesystem used: "
            f"{initial_usage['used'] / (1024 ** 3):.2f} GB",
            flush=True
        )

    # Discover Terraform and stale build directories.
    terraform_dirs, stale_build_dirs, stats = scan_workspaces(
        root,
        args.stale_days,
        args.max_seconds
    )

    terraform_results = []

    # Delete discovered Terraform directories.
    with ThreadPoolExecutor(
        max_workers=MAX_WORKERS
    ) as executor:

        futures = [
            executor.submit(delete_terraform_dir, item)
            for item in terraform_dirs
        ]

        for future in as_completed(futures):
            terraform_results.append(future.result())

    # Generate CSV report for Jenkins artifact archiving.
    write_csv(
        csv_path,
        terraform_results,
        stale_build_dirs
    )

    # Retrieve final filesystem usage.
    final_usage = get_filesystem_usage(root)

    deleted = sum(
        item["status"] == "Deleted"
        for item in terraform_results
    )

    failed = sum(
        item["status"].startswith("Failed:")
        for item in terraform_results
    )

    freed_bytes = sum(
        item.get("bytes_freed", 0)
        for item in terraform_results
    )

    print()
    print("======================================")
    print("JENKINS EFS CLEANUP SUMMARY")
    print("======================================")
    print(f"Directories scanned          : {stats['directories_scanned']}")
    print(f"Terraform directories found  : {stats['terraform_found']}")
    print(f"Stale Terraform directories  : {stats['stale_terraform']}")
    print(f"Terraform directories deleted: {deleted}")
    print(f"Terraform deletion failures  : {failed}")
    print(f"Numeric directories found    : {stats['build_dirs_found']}")
    print(f"Stale build directories      : {stats['stale_build_dirs']}")
    print(f"Scan errors                  : {stats['errors']}")
    print(f"Directory inventory time     : {stats['elapsed']:.2f} seconds")

    if initial_usage:
        print(
            f"Initial filesystem usage     : "
            f"{initial_usage['used'] / (1024 ** 3):.2f} GB"
        )

    if final_usage:
        print(
            f"Final filesystem usage       : "
            f"{final_usage['used'] / (1024 ** 3):.2f} GB"
        )

    if initial_usage and final_usage:
        usage_change = initial_usage["used"] - final_usage["used"]

        print(
            f"Filesystem usage reduction   : "
            f"{usage_change / (1024 ** 3):.2f} GB"
        )

    print(
        f"Estimated Terraform reclaimed: "
        f"{freed_bytes / (1024 ** 3):.2f} GB"
    )

    print(f"CSV report                   : {csv_path}")

    print(
        f"Scan status                  : "
        f"{'PARTIAL' if stats['timed_out'] or stats['errors'] else 'COMPLETE'}"
    )

    print("Stale build folders deleted  : 0")
    print("======================================")

    if stats["timed_out"]:
        print(
            "WARNING: Inventory reached its time limit. "
            "The CSV contains only directories discovered so far.",
            flush=True
        )

    if failed or stats["errors"]:
        sys.exit(1)


if __name__ == "__main__":
    main()
