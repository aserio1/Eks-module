
#!/usr/bin/env python3

# This script identifies recursively .terraform dirs
# found in /home/jenkins/workspace.
# Lists .terraform directories older than 90 days.
# Displays ls -lrt style information and generates a CSV report.
# Executed via a Jenkins job that runs daily during off hours.
# DRY-RUN ONLY - no directories are deleted.

import os
import sys
import time
import csv
import stat
import pwd
import grp
import argparse
from datetime import datetime
from concurrent.futures import ThreadPoolExecutor
from threading import Lock

ROOT_DIR = "/home/jenkins/workspace"
MAX_WORKERS = 8  # Tune based on EFS throughput limits
STALE_DAYS = 90
PROGRESS_INTERVAL = 1000

print_lock = Lock()


def get_dir_size_fast(path):
    """Use os.scandir recursively for directory size calculation."""
    total = 0
    stack = [path]

    while stack:
        current = stack.pop()

        try:
            with os.scandir(current) as it:
                for entry in it:
                    try:
                        if entry.is_file(follow_symlinks=False):
                            total += entry.stat(
                                follow_symlinks=False
                            ).st_size

                        elif entry.is_dir(follow_symlinks=False):
                            stack.append(entry.path)

                    except (PermissionError, FileNotFoundError):
                        pass

        except (PermissionError, FileNotFoundError):
            pass

    return total


def find_terraform_dirs(root):
    """
    Find all .terraform directories recursively.

    Uses os.scandir and skips traversing inside
    .terraform directories to reduce EFS metadata I/O.

    Prints progress every 1000 scanned directories.
    """
    stack = [root]
    scanned_count = 0
    terraform_count = 0

    while stack:
        current = stack.pop()
        scanned_count += 1

        if scanned_count % PROGRESS_INTERVAL == 0:
            print(
                f"Progress: scanned {scanned_count} directories, "
                f"found {terraform_count} .terraform directories",
                flush=True
            )

        try:
            with os.scandir(current) as it:
                for entry in it:
                    try:
                        if not entry.is_dir(
                            follow_symlinks=False
                        ):
                            continue

                        if entry.name == ".terraform":
                            terraform_count += 1
                            yield entry.path
                        else:
                            stack.append(entry.path)

                    except (PermissionError, FileNotFoundError):
                        pass

        except (PermissionError, FileNotFoundError) as e:
            print(
                f"Cannot access {current}: {e}",
                file=sys.stderr,
                flush=True
            )

    print(
        f"Scan completed: {scanned_count} directories scanned, "
        f"{terraform_count} .terraform directories found",
        flush=True
    )


def get_stale_directory_info(path, cutoff):
    """
    Return metadata for .terraform directories
    older than the configured retention period.
    """
    try:
        info = os.stat(
            path,
            follow_symlinks=False
        )

        if info.st_mtime >= cutoff:
            return None

        try:
            owner = pwd.getpwuid(info.st_uid).pw_name
        except KeyError:
            owner = str(info.st_uid)

        try:
            group = grp.getgrgid(info.st_gid).gr_name
        except KeyError:
            group = str(info.st_gid)

        return {
            "path": path,
            "mtime": info.st_mtime,
            "modified": datetime.fromtimestamp(
                info.st_mtime
            ).strftime("%Y-%m-%d %H:%M:%S"),
            "owner": owner,
            "group": group,
            "permissions": stat.filemode(info.st_mode),
            "size": None,
            "status": "PROPOSED DELETE - REVIEW REQUIRED"
        }

    except (PermissionError, FileNotFoundError):
        return None


def get_ls_lrt_output(candidate):
    """
    Generate ls -lrt -d style output using
    already collected directory metadata.

    Avoids launching an ls subprocess for each directory.
    """
    return (
        f"{candidate['permissions']} "
        f"{candidate['owner']} "
        f"{candidate['group']} "
        f"{candidate['modified']} "
        f"{candidate['path']}"
    )


def inspect_candidate(candidate, calculate_size=False):
    """
    Inspect candidate and optionally calculate
    recursive directory size.
    """
    candidate["ls_output"] = get_ls_lrt_output(candidate)

    if calculate_size:
        candidate["size"] = get_dir_size_fast(
            candidate["path"]
        )

    return candidate


def main():
    parser = argparse.ArgumentParser()

    parser.add_argument(
        "--execute",
        action="store_true",
        help="Execution disabled - dry-run only"
    )

    parser.add_argument(
        "--calculate-size",
        action="store_true",
        help="Calculate recursive directory sizes (slower on EFS)"
    )

    parser.add_argument(
        "--output",
        default="jenkins_efs_cleanup_dry_run.csv",
        help="CSV output filename"
    )

    args = parser.parse_args()

    if args.execute:
        print("ERROR: Deletion is disabled.")
        sys.exit(1)

    if not os.path.isdir(ROOT_DIR):
        print(f"ERROR: Workspace root not found: {ROOT_DIR}")
        sys.exit(1)

    start_time = time.monotonic()
    cutoff = time.time() - (STALE_DAYS * 86400)

    print("======================================")
    print("JENKINS EFS CLEANUP - DRY RUN")
    print("======================================")
    print(f"Scanning         : {ROOT_DIR}")
    print(f"Retention period : {STALE_DAYS} days")
    print(f"Workers          : {MAX_WORKERS}")
    print("Mode             : DRY-RUN")
    print(
        f"Calculate sizes  : "
        f"{'YES' if args.calculate_size else 'NO'}"
    )
    print()

    terraform_count = 0
    candidates = []

    print(
        "Scanning for stale .terraform directories...",
        flush=True
    )

    for path in find_terraform_dirs(ROOT_DIR):
        terraform_count += 1

        candidate = get_stale_directory_info(
            path,
            cutoff
        )

        if candidate:
            candidates.append(candidate)

    # Sort oldest to newest, matching ls -lrt ordering.
    candidates.sort(key=lambda item: item["mtime"])

    print()
    print("======================================")
    print("PROPOSED DELETION ITEMS - LS -LRT")
    print("======================================")

    total_size = 0

    if args.calculate_size:
        with ThreadPoolExecutor(
            max_workers=MAX_WORKERS
        ) as executor:
            sizes = list(
                executor.map(
                    get_dir_size_fast,
                    [item["path"] for item in candidates]
                )
            )

        for candidate, size in zip(candidates, sizes):
            candidate["size"] = size

    for candidate in candidates:
        candidate = inspect_candidate(
            candidate,
            calculate_size=False
        )

        print()
        print(f"STATUS       : {candidate['status']}")
        print(f"DIRECTORY    : {candidate['path']}")
        print(f"LAST MODIFIED: {candidate['modified']}")
        print(f"OWNER        : {candidate['owner']}")
        print(f"GROUP        : {candidate['group']}")
        print(f"PERMISSIONS  : {candidate['permissions']}")
        print("LS -LRT:")
        print(candidate["ls_output"])

        if candidate["size"] is not None:
            total_size += candidate["size"]

            print(
                f"ESTIMATED SIZE: "
                f"{candidate['size'] / (1024 ** 3):.2f} GiB"
            )

        print("--------------------------------------")

    with open(
        args.output,
        "w",
        newline="",
        encoding="utf-8"
    ) as csvfile:

        writer = csv.writer(csvfile)

        writer.writerow([
            "Status",
            "Directory",
            "Last Modified",
            "Owner",
            "Group",
            "Permissions",
            "Estimated Size GiB",
            "LS -LRT"
        ])

        for candidate in candidates:
            writer.writerow([
                candidate["status"],
                candidate["path"],
                candidate["modified"],
                candidate["owner"],
                candidate["group"],
                candidate["permissions"],
                (
                    f"{candidate['size'] / (1024 ** 3):.2f}"
                    if candidate["size"] is not None
                    else "Not calculated"
                ),
                candidate["ls_output"]
            ])

    elapsed = time.monotonic() - start_time

    print()
    print("======================================")
    print("DRY-RUN SUMMARY")
    print("======================================")
    print(f"Terraform directories found : {terraform_count}")
    print(f"Proposed deletion items      : {len(candidates)}")

    if args.calculate_size:
        print(
            f"Estimated candidate size     : "
            f"{total_size / (1024 ** 3):.2f} GiB"
        )
    else:
        print(
            "Estimated candidate size     : "
            "Not calculated (fast mode)"
        )

    print("Directories deleted          : 0")
    print(f"CSV report                   : {args.output}")
    print(f"Execution time               : {elapsed:.2f} seconds")
    print("======================================")
    print("DRY-RUN: No directories were deleted.")


if __name__ == "__main__":
    main()
