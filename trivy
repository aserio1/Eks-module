    current_workspace = os.environ["WORKSPACE"]
    parser = argparse.ArgumentParser(
        description="Jenkins workspace cleanup dry-run"
    )

    parser.add_argument(
        "--root",
        default=ROOT_DIR,
        help="Workspace storage path visible to this process"
    )

    parser.add_argument(
        "--stale-days",
        type=int,
        default=STALE_DAYS
    )

    parser.add_argument(
        "--max-seconds",
        type=int,
        default=MAX_SCAN_SECONDS
    )

    if not root.is_dir():
        print(f"ERROR: Workspace root not found: {root}")
