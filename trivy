
#!/usr/bin/env python3

# Jenkins Workspace Cleanup - FAST DRY RUN
# Jenkins EFS Cleanup
#
# Uses Jenkins workspace pattern:
# workspace/${JOB_NAME.replace('%2F','/')}/${BUILD_NUMBER}
#
# Fast DRY-RUN inventory of:
#   1. Stale .terraform directories
#   2. Potential stale Jenkins build workspaces
#
# No hardcoded Jenkins project folders.
# No recursive size calculations.
# No files or directories deleted.

import os
import sys
import time
import csv
import argparse
from pathlib import Path
from datetime import datetime, timezone

ROOT_DIR = "/home/jenkins/workspace"
MAX_WORKERS = 8
STALE_DAYS = 90

MAX_SCAN_SECONDS = 300
PROGRESS_INTERVAL = 5000
DRY_RUN = True

SKIP_DIRS = {
    ".git",
    ".svn",
    ".hg",
    "node_modules",
    "__pycache__",
    ".venv",
    "venv",
    ".cache",
    ".mypy_cache",
    ".pytest_cache",
    ".tox",
    ".gradle",
    ".m2",
    "target",
    "dist",
    "build",
    "coverage",
    ".next",
    ".idea",
    ".vscode"
}


def get_workspace_root():
    """
    Derive the workspace root from the Jenkins environment.

    Expected pattern:
      <root>/<JOB_NAME>/<BUILD_NUMBER>

    Jenkins ws() may include additional subdirectories.
    """

    workspace = os.environ.get("WORKSPACE")
    job_name = os.environ.get("JOB_NAME")
    build_number = os.environ.get("BUILD_NUMBER")

    if not all((workspace, job_name, build_number)):
        print(
            "WARNING: Jenkins workspace environment unavailable. "
            "Using configured root."
        )
        return Path(ROOT_DIR).resolve()

    if not build_number.isdigit():
        print("ERROR: Invalid BUILD_NUMBER.")
        sys.exit(1)

    job_parts = [
        part
        for part in job_name.replace("%2F", "/").split("/")
        if part
    ]

    suffix = Path(*job_parts, build_number)
    workspace_path = Path(workspace).resolve()

    parts = workspace_path.parts
    suffix_parts = suffix.parts

    for i in range(len(parts) - len(suffix_parts) + 1):
        if tuple(parts[i:i + len(suffix_parts)]) == suffix_parts:
            return Path(*parts[:i])

    print(
        "WARNING: Cannot derive workspace root from "
        "WORKSPACE/JOB_NAME/BUILD_NUMBER."
    )

    return Path(ROOT_DIR).resolve()


def scan_workspaces(root, current_workspace, stale_days, max_seconds):
    """
    Find stale Terraform caches and numeric build directories.

    No recursive size calculations.
    No deletion operations.
    """

    cutoff = time.time() - (stale_days * 86400)
    start = time.monotonic()

    stack = [Path(root)]
    current = (
        Path(current_workspace).resolve()
        if current_workspace
        else None
    )

    results = {
        "directories_scanned": 0,
        "terraform_found": 0,
        "stale_terraform": 0,
        "build_dirs_found": 0,
        "stale_build_dirs": 0,
        "skipped": 0,
        "errors": 0,
        "timed_out": False,
        "candidates": []
    }

    while stack:

        if time.monotonic() - start >= max_seconds:
            results["timed_out"] = True
            break

        directory = stack.pop()

        try:
            with os.scandir(directory) as entries:
                for entry in entries:

                    if time.monotonic() - start >= max_seconds:
                        results["timed_out"] = True
                        break

                    try:
                        if not entry.is_dir(follow_symlinks=False):
                            continue

                        results["directories_scanned"] += 1

                        if results["directories_scanned"] % PROGRESS_INTERVAL == 0:
                            print(
                                f"Scanned: {results['directories_scanned']} | "
                                f"Stale Terraform: {results['stale_terraform']} | "
                                f"Stale build folders: {results['stale_build_dirs']}",
                                flush=True
                            )

                        if entry.name in SKIP_DIRS:
                            results["skipped"] += 1
                            continue

                        path = Path(entry.path)

                        # Protect current Jenkins workspace.
                        if current:
                            resolved = path.resolve()

                            if resolved == current:
                                results["skipped"] += 1
                                continue

                            if current in resolved.parents:
                                results["skipped"] += 1
                                continue

                        if entry.name == ".terraform":
                            results["terraform_found"] += 1

                            info = entry.stat(follow_symlinks=False)

                            if info.st_mtime < cutoff:
                                results["stale_terraform"] += 1
                                results["candidates"].append({
                                    "type": "Stale Terraform Directory",
                                    "path": str(path),
                                    "modified": info.st_mtime,
                                    "age": int(
                                        (time.time() - info.st_mtime) / 86400
                                    )
                                })

                            continue

                        if entry.name.isdigit():
                            results["build_dirs_found"] += 1

                            info = entry.stat(follow_symlinks=False)

                            if info.st_mtime < cutoff:
                                results["stale_build_dirs"] += 1
                                results["candidates"].append({
                                    "type": "Stale Numeric Workspace",
                                    "path": str(path),
                                    "modified": info.st_mtime,
                                    "age": int(
                                        (time.time() - info.st_mtime) / 86400
                                    )
                                })

                            continue

                        stack.append(path)

                    except OSError as error:
                        results["errors"] += 1
                        print(f"WARNING: {entry.path}: {error}")

                if results["timed_out"]:
                    break

        except OSError as error:
            results["errors"] += 1
            print(f"WARNING: {directory}: {error}")

    results["elapsed"] = time.monotonic() - start

    return results


def write_csv(results, csv_file):
    """
    Write stale workspace and Terraform candidates to CSV.
    """

    with open(csv_file, "w", newline="", encoding="utf-8") as file:
        writer = csv.writer(file)

        writer.writerow([
            "Type",
            "Directory Path",
            "Last Modified",
            "Age (Days)",
            "Cleanup Status"
        ])

        for candidate in sorted(
            results["candidates"],
            key=lambda item: item["path"]
        ):
            modified = datetime.fromtimestamp(
                candidate["modified"],
                timezone.utc
            ).strftime("%Y-%m-%d %H:%M:%S UTC")

            writer.writerow([
                candidate["type"],
                candidate["path"],
                modified,
                candidate["age"],
                "Dry Run - Not Deleted"
            ])

    print(f"CSV report generated: {Path(csv_file).resolve()}")


def main():

    parser = argparse.ArgumentParser(
        description="Jenkins workspace cleanup dry-run"
    )

    parser.add_argument(
        "--root",
        default=ROOT_DIR,
        help="Workspace storage path visible to this process"
    )

    parser.add_argument(
        "--stale-days",
        type=int,
        default=STALE_DAYS
    )

    parser.add_argument(
        "--max-seconds",
        type=int,
        default=MAX_SCAN_SECONDS
    )

    parser.add_argument(
        "--csv",
        default="jenkins_stale_list.csv",
        help="CSV output filename"
    )

    parser.add_argument(
        "--execute",
        action="store_true",
        help="Deletion is disabled"
    )

    args = parser.parse_args()

    if args.execute:
        print("ERROR: Deletion is disabled.")
        sys.exit(1)

    if args.stale_days < 0 or args.max_seconds <= 0:
        parser.error("Invalid retention or scan-time value")

    root = Path(args.root).resolve()

    if not root.is_dir():
        print(f"ERROR: Workspace root not found: {root}")
        sys.exit(1)

    current_workspace = os.environ.get("WORKSPACE")

    print("======================================")
    print("JENKINS EFS CLEANUP - DRY RUN")
    print("======================================")
    print(f"Workspace root   : {root}")
    print(f"Retention        : {args.stale_days} days")
    print(f"Max scan time    : {args.max_seconds} seconds")
    print(f"CSV report       : {Path(args.csv).resolve()}")
    print("Terraform cleanup: DRY RUN")
    print("Stale builds     : DRY RUN")
    print("Deletion enabled : NO")
    print()

    results = scan_workspaces(
        root,
        current_workspace,
        args.stale_days,
        args.max_seconds
    )

    write_csv(results, args.csv)

    print()
    print("======================================")
    print("JENKINS EFS CLEANUP - DRY RUN SUMMARY")
    print("======================================")
    print(f"Directories scanned         : {results['directories_scanned']}")
    print(f"Terraform directories found : {results['terraform_found']}")
    print(f"Stale Terraform directories : {results['stale_terraform']}")
    print(f"Numeric directories found   : {results['build_dirs_found']}")
    print(f"Stale numeric directories   : {results['stale_build_dirs']}")
    print(f"Directories skipped         : {results['skipped']}")
    print(f"Scan errors                 : {results['errors']}")
    print(f"Execution time              : {results['elapsed']:.2f} seconds")

    scan_status = (
        "PARTIAL"
        if results["timed_out"] or results["errors"]
        else "COMPLETE"
    )

    print(f"Scan status                 : {scan_status}")
    print("Directories deleted         : 0")
    print("Files deleted               : 0")
    print("======================================")
    print("DRY RUN COMPLETE - NOTHING DELETED")
    print("======================================")

    if results["timed_out"]:
        print(
            "WARNING: Scan reached its time limit. "
            "CSV contains only discovered candidates."
        )


if __name__ == "__main__":
    main()
