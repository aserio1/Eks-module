#########################################
#!/bin/bash

################################################################################
# jenkins_agent/scripts/user_data.tpl
################################################################################

exec > >(tee /var/log/user-data.log|logger -t user-data -s 2>/dev/console) 2>&1

# ------------------------------------------------------------------------
# This AMI's root volume auto-expands, but other LVM volumes do not.
# The following section extends the /var volume using available disk space.
# ------------------------------------------------------------------------
echo "Expanding /var partition..."
growpart /dev/nvme0n1 2
pvresize /dev/nvme0n1p2
lvextend -l +100%FREE /dev/VolGroup00/varVol
xfs_growfs /var
echo "/var partition successfully resized."
# ------------------------------------------------------------------------

# Enable privileged containers
echo 4 > /proc/sys/user/max_user_namespaces

# Update and install essential packages
dnf upgrade -y --exclude=kernel*
dnf install -y \
  aws-cli \
  jq \
  python3 \
  wget \
  unzip \
  docker \
  amazon-efs-utils

# Docker is available in the default AL2023 package repository,
# so you can install it directly with dnf.
systemctl enable docker
systemctl start docker

# Create mount point and mount EFS Write to fstab so it persists across reboots
mkdir -p /jenkins_jobs
echo "${efs_mount_target}:/ /jenkins_jobs efs _netdev,tls 0 0" >> /etc/fstab
mount -a

# Set shared workspace permissions
groupadd -g 2000 jenkins
useradd -N -u 2000 -g 2000 -l -m -s /bin/bash jenkins
chown jenkins:jenkins /jenkins_jobs

# Setup SSH key
cat >> agent_ssh.pem << EOF
${agent_pem}
EOF

# Get Jenkins agent password from Secrets Manager
export PW=$(aws secretsmanager get-secret-value --secret-id ${prefix}-svc-jenkins-agent-token --region us-east-1 | jq -r .SecretString)

# Login to ECR
aws ecr get-login-password --region us-east-1 | docker login --username AWS --password-stdin ${ecr_repo_account_id}.dkr.ecr.us-east-1.amazonaws.com
docker pull ${ecr_repo_account_id}.dkr.ecr.us-east-1.amazonaws.com/${agent_image}:${agent_tag}

# Install Trivy on EC2
export TRIVY_VERSION=0.72.0
dnf install -y https://github.com/aquasecurity/trivy/releases/download/v$${TRIVY_VERSION}/trivy_$${TRIVY_VERSION}_Linux-64bit.rpm

# Install Python packages
python3 -m pip install --upgrade pip
python3 -m pip install boto3 requests

# ------------------------------------------------------------------------
# Tenable Agent Reset and Relink Configuration
# ------------------------------------------------------------------------
echo "Resetting and configuring Tenable Nessus Agent..."
# Stop the agent service in case it started automatically on boot
systemctl stop nessusagent

# Prep agent to ensure a clean slate
/opt/nessus_agent/sbin/nessuscli prepare-image

# Link the agent to the Tenable manager using the proxy and the key from SSM
/opt/nessus_agent/sbin/nessuscli agent link --host=tenable-proxy-lza.aws.hhsoig.gov --port=443 --key=${tenable_linking_key} --groups="AWS,Servers"

# Start the agent service
systemctl start nessusagent
echo "Tenable Nessus Agent reset, re-linked, and started."
# ------------------------------------------------------------------------

# Download Jenkins agent vulnerability scan script
curl -k -o /usr/local/bin/trivy_jenkins_agents_scan.py "https://raw.git.aws.hhsoig.gov/CDO/imac-jenkins/main/infrastructure/terraform/modules/jenkins_agent/scripts/trivy_jenkins_agents_scan.py"
chmod +x /usr/local/bin/trivy_jenkins_agents_scan.py

# Schedule daily EC2 trivy scan at 12PM ET (16:00 UTC)
(crontab -l 2>/dev/null; echo "0 16 * * * /usr/local/bin/trivy_jenkins_agents_scan.py") | crontab -

# Set up AWS profiles
mkdir -p ~/.aws
cat >> ~/.aws/config << EOF
%{for environment in environments ~}
[profile ${environment.name}]
role_arn = ${environment.target_account_role}
credential_source = Ec2InstanceMetadata
region = us-east-1
%{ endfor ~}
EOF

# Fix Docker socket permissions for Jenkins
chown jenkins /var/run/docker.sock
chgrp jenkins /var/run/docker.sock

# Detect instance type and set Redis memory accordingly
INSTANCE_TYPE=$(ec2-metadata --instance-type | cut -d ' ' -f 2)

case $INSTANCE_TYPE in
  t3.small)
    REDIS_MAXMEM="256mb"
    ;;
  t3.medium)
    REDIS_MAXMEM="1gb"
    ;;
  t3.large)
    REDIS_MAXMEM="2gb"
    ;;
  t3.xlarge)
    REDIS_MAXMEM="4gb"
    ;;
  *)
    # Default fallback
    REDIS_MAXMEM="2gb"
    ;;
esac

echo "Instance type: $INSTANCE_TYPE, Redis max memory: $REDIS_MAXMEM"

# Create network
docker network create jenkins-net

# Start Redis container (Container hosted in OIG ECR repo as opposed to DockerHub)
docker run -d \
  --name redis-container \
  --network jenkins-net \
  --restart=always \
  -p 6379:6379 \
  ${ecr_repo_account_id}.dkr.ecr.us-east-1.amazonaws.com/oig/imac/redis:latest redis-server \
    --bind 0.0.0.0 \
    --protected-mode no \
    --maxmemory $REDIS_MAXMEM \
    --maxmemory-policy allkeys-lru \
    --save "" \
    --appendonly no

# Wait for Redis
until docker exec redis-container redis-cli PING > /dev/null 2>&1; do
  echo "Waiting for Redis..."
  sleep 2
done

# Start Trivy server
docker run -d \
  --name trivy-server \
  --network jenkins-net \
  --restart=always \
  -p 0.0.0.0:4954:4954 \
  -e TRIVY_CACHE_BACKEND=redis://redis-container:6379 \
  ${ecr_repo_account_id}.dkr.ecr.us-east-1.amazonaws.com/ecr-public/aquasecurity/trivy-security:${TRIVY_VERSION} \
    server \
    --listen 0.0.0.0:4954 \
    --cache-backend redis://redis-container:6379

# Wait for Trivy server
until curl -sf http://localhost:4954/healthz > /dev/null 2>&1; do
  echo "Waiting for Trivy server..."
  sleep 2
done

# Test Redis from Trivy server container
docker exec trivy-server ping -c 1 redis-container

# Download vulnerability DB
docker exec trivy-server trivy image \
  --db-repository ${ecr_repo_account_id}.dkr.ecr.us-east-1.amazonaws.com/ecr-public/aquasecurity/trivy-db:2 \
  --download-db-only

# Get Redis container IP
redis_container_ip=$(docker inspect -f '{{range.NetworkSettings.Networks}}{{.IPAddress}}{{end}}' redis-container)

# Start Jenkins agent container
docker run -d -t \
    --name jenkins \
    --network jenkins-net \
    --restart always \
    --cap-add=sys_admin \
    --cap-add mknod \
    --device=/dev/fuse \
    --security-opt seccomp=unconfined \
    --security-opt label=disable \
    --privileged \
    -p 8022:22 \
    -p 8080:8080 \
    -e JENKINS_MAIN_IP=${jenkins_main_url} \
    -e AGENT_IP=$(ip -o -4 addr list ens5 | head -n1 | awk '{print $4}' | cut -d/ -f1) \
    -e PASSWORD=$PW \
    -e USERNAME=${username} \
    -e NODE_NAME=${project} \
    -e PROJECT=${project} \
    -e ACCOUNT_ID=$(aws sts get-caller-identity | jq --raw-output .Account) \
    -e REDIS_CONTAINER_IP=$redis_container_ip \
    -v `pwd`/agent_ssh.pem:/home/jenkins/agent_ssh.pem \
    -v /root/.ssh/authorized_keys:/home/jenkins/.ssh/host_authorized_keys \
    -v /root/.aws/config:/home/jenkins/.aws/host_config \
    -v /jenkins_jobs:/home/jenkins/workspace \
    -v /var/run/docker.sock:/var/run/docker.sock \
    ${ecr_repo_account_id}.dkr.ecr.us-east-1.amazonaws.com/${agent_image}:${agent_tag}
