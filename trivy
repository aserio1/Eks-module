#!/usr/bin/env bash
set -Eeuo pipefail

# ---------------------------------------------------------------------------
# detect_sast_dast: inspect the checked-out repo and emit the applicability +
# step document for the required_security_steps policy.
#
# SAST applies to every project (enforced unconditionally by the policy), so
# nothing to detect there beyond whether the step actually runs. This script
# produces:
#   signals.is_frontend        : package.json declares a web framework
#   signals.has_api_gateway    : Terraform provisions API Gateway (v1 or v2)
#   signals.has_http_listener  : Terraform provisions an ALB HTTP/HTTPS listener
#   signals.target_url_output  : (informational) name of a TF output emitting a
#                                URL; NOT used for applicability
#   pipeline_steps             : sast/dast INVOKED in the Jenkinsfile (authoritative)
#   loaded_libraries           : sast/dast LOADED in pipeline_config.groovy (secondary)
#   dast_target_url            : URL argument passed to dast(...) — the reliable
#                                targetUrl source
#
# The Rego decides applicability from these; jobs/{project}.json can override.
#
# FAILURE PHILOSOPHY: this script must never hard-fail the build. Wiring bugs
# and unexpected data get reported as invocation_check_failed=true so the
# policy emits a loud, non-blocking warn instead of a false denial or a crash.
# ---------------------------------------------------------------------------

REPO_ROOT="${WORKSPACE:-.}"
OUTPUT_FILE="dast_input.json"

# ── Fail-safe emitter ───────────────────────────────────────────────────────
# On ANY unexpected error, emit a minimal input marked unverified and exit 0.
# The policy suspends invocation-based denials and fires its warn decision,
# making the breakage visible in the build log without killing the pipeline.
# (Incident this guards against: a multi-document JSON value reaching
# --argjson crashed the script with exit 2; the sh step was outside catchError,
# so the whole pipeline aborted before the security checks even ran.)
emit_failsafe() {
    local line="${1:-?}"
    {
        echo "[GOVERNANCE] ERROR: detect_sast_dast.sh hit an unexpected error near line ${line}."
        echo "[GOVERNANCE]        Emitting fail-safe input (invocation_check_failed=true): the"
        echo "[GOVERNANCE]        policy will WARN, not deny, and the build will not crash here."
    } >&2
    jq -n \
        --arg repo "${REPO_URL:-}" \
        --arg jenkinsfile "${JENKINSFILE:-${JENKINSFILE_PATH:-}}" \
        '{
            repo: $repo,
            jenkinsfile: $jenkinsfile,
            pipeline_steps: [],
            loaded_libraries: [],
            dast_target_url: null,
            dast_blocking: true,
            invocation_check_failed: true,
            signals: {}
        }' > "$OUTPUT_FILE" || true
    exit 0
}
trap 'emit_failsafe $LINENO' ERR

# ── JSON hygiene helpers ────────────────────────────────────────────────────
# The old guards used `echo "$val" | jq -e .`, which ACCEPTS a stream of
# multiple JSON documents — but --argjson requires exactly ONE JSON text, so a
# multi-document value passed validation and then crashed the final jq -n.
# These normalizers guarantee exactly one well-typed value or a safe default.

# Exactly one compact JSON array, else [].
as_json_array() {
    printf '%s' "${1:-}" \
        | jq -ces 'if (length == 1) and (.[0] | type == "array") then .[0] else empty end' 2>/dev/null \
        || printf '[]'
}

# Exactly the literal true/false, else the supplied default.
as_json_bool() {
    case "${1:-}" in
        true|false) printf '%s' "$1" ;;
        *)          printf '%s' "$2" ;;
    esac
}

# JENKINSFILE_PATH must be passed in explicitly by the hook (same variable
# detect_restricted_steps.sh relies on). Do NOT default this to a bare
# "Jenkinsfile" — several repos (e.g. sie-frontend) have no file with that
# exact name, only variants like Jenkinsfile.main / Jenkinsfile.feature. A
# silent default here scans the wrong (nonexistent) file, finds no invoked
# steps, and produces a false "library loaded but never invoked" violation
# against a fully compliant pipeline. Fail loudly instead.
if [ -z "${JENKINSFILE_PATH:-}" ]; then
    echo "[GOVERNANCE] ERROR: JENKINSFILE_PATH is not set. Cannot reliably detect" >&2
    echo "[GOVERNANCE]        invoked security steps. Refusing to guess a filename." >&2
    JENKINSFILE=""
else
    JENKINSFILE="$JENKINSFILE_PATH"
fi
PIPELINE_CONFIG="${PIPELINE_CONFIG_PATH:-pipeline_config.groovy}"

echo "[GOVERNANCE] detect_sast_dast scanning repo at: ${REPO_ROOT}"
echo "[GOVERNANCE] JENKINSFILE_PATH received: ${JENKINSFILE_PATH:-<unset>} (resolved: ${JENKINSFILE:-<none>})"

# ── Tier 1: front-end web framework in package.json ─────────────────────────
# Cheapest, strongest signal. Reads top-level deps + devDeps only (not the
# lockfile), so transitive pulls don't produce false positives.
WEB_FRAMEWORKS='["next","react","react-dom","vue","@angular/core","svelte","express"]'
IS_FRONTEND=false
while IFS= read -r pkg; do
    [ -z "$pkg" ] && continue
    match=$(jq --argjson fw "$WEB_FRAMEWORKS" '
        ((.dependencies // {}) + (.devDependencies // {}))
        | keys
        | any(. as $k | $fw | index($k))
    ' "$pkg" 2>/dev/null || echo false)
    # A malformed package.json (or a multi-document file) can yield a
    # multi-line result; keep only the first line before comparing.
    match="${match%%$'\n'*}"
    if [ "$match" = "true" ]; then
        IS_FRONTEND=true
        break
    fi
done < <(find "$REPO_ROOT" -name package.json -not -path '*/node_modules/*' 2>/dev/null)

# ── Tier 2: Terraform HTTP surface ──────────────────────────────────────────
# Grep resource declarations across all .tf files. Cheap, no HCL parsing.
TF_FILES=$(find "$REPO_ROOT" -name '*.tf' -not -path '*/.terraform/*' 2>/dev/null || true)

HAS_API_GATEWAY=false
HAS_HTTP_LISTENER=false
TARGET_URL_OUTPUT=""

if [ -n "$TF_FILES" ]; then
    # API Gateway (v1 REST or v2 HTTP/WebSocket)
    if echo "$TF_FILES" | xargs grep -lE 'resource[[:space:]]+"aws_(api_gateway_rest_api|apigatewayv2_api)"' >/dev/null 2>&1; then
        HAS_API_GATEWAY=true
    fi

    # ALB/NLB listener speaking HTTP or HTTPS. Require an HTTP(S) protocol
    # somewhere in the .tf files, not just the listener resource, to reduce
    # internal/TCP-only noise.
    if echo "$TF_FILES" | xargs grep -lE 'resource[[:space:]]+"aws_lb_listener"' >/dev/null 2>&1; then
        if echo "$TF_FILES" | xargs grep -hE 'protocol[[:space:]]*=[[:space:]]*"HTTPS?"' >/dev/null 2>&1; then
            HAS_HTTP_LISTENER=true
        fi
    fi

    # A Terraform output emitting a reachable URL. INFORMATIONAL ONLY — this is
    # a best-effort convenience; its absence must never affect applicability.
    # Custom-domain APIs (aws_apigatewayv2_domain_name) frequently expose a URL
    # that is never emitted as an output, so a miss here is expected. The
    # authoritative targetUrl comes from the dast() call argument below.
    TARGET_URL_OUTPUT=$(echo "$TF_FILES" | xargs grep -hEA3 '^[[:space:]]*output[[:space:]]+"' 2>/dev/null \
        | awk '
            /^[[:space:]]*output[[:space:]]+"/ {
                if (match($0, /output[[:space:]]+"[^"]+"/)) {
                    s = substr($0, RSTART, RLENGTH)
                    gsub(/output[[:space:]]+"/, "", s); gsub(/"/, "", s)
                    name = s
                }
                next
            }
            /execute-api|dns_name|api_url/ { if (name != "") { print name; name="" } }
        ' \
        | head -n1 || true)
fi

# Sanitize the booleans no matter which code path set them.
IS_FRONTEND=$(as_json_bool "$IS_FRONTEND" false)
HAS_API_GATEWAY=$(as_json_bool "$HAS_API_GATEWAY" false)
HAS_HTTP_LISTENER=$(as_json_bool "$HAS_HTTP_LISTENER" false)

echo "[GOVERNANCE] signals: is_frontend=${IS_FRONTEND} has_api_gateway=${HAS_API_GATEWAY} has_http_listener=${HAS_HTTP_LISTENER} target_url_output=${TARGET_URL_OUTPUT:-<none>}"

# ── Detect which security steps actually run ─────────────────────────────────
# JTE steps appear two ways, meaning different things:
#   1. LOADED as a library in pipeline_config.groovy → capability available.
#   2. INVOKED in the Jenkinsfile, e.g. sast(true) / dast("https://...")
#      → the step actually runs. Authoritative for a required-steps check.
#
# invocation_check_failed is true when we could not read the Jenkinsfile at
# all (unset path, or path resolved but file missing). In that case
# CALLED_STEPS is [] but that MUST NOT be read as "steps are absent" — it means
# "we don't know." The policy should not deny for missing/dormant steps when
# this flag is set.
INVOCATION_CHECK_FAILED=true
CALLED_STEPS='[]'
DAST_TARGET_URL=""
DAST_BLOCKING=true

if [ -n "$JENKINSFILE" ] && [ -f "$JENKINSFILE" ]; then
    INVOCATION_CHECK_FAILED=false

    # (1) Invoked steps: sast(...) / dast(...) at line start (indentation
    #     allowed) or via jte.libraries.<lib>.<step>(...). Match the step name
    #     before a paren.
    #     `|| true`: grep exits 1 on no matches, which under `set -e` + pipefail
    #     would otherwise kill the script on a Jenkinsfile with no sast/dast calls.
    CALLED_STEPS_RAW=$(grep -oP '(?:^\s*|\.)\K(sast|dast)(?=\s*\()' "$JENKINSFILE" 2>/dev/null | sort -u || true)
    if [ -z "$CALLED_STEPS_RAW" ]; then
        CALLED_STEPS='[]'
    else
        CALLED_STEPS=$(printf '%s\n' "$CALLED_STEPS_RAW" | jq -R . | jq -cs . 2>/dev/null || true)
    fi
    # Normalize: exactly one compact array, or []. This closes the loophole
    # where a multi-document stream passed `jq -e` validation but crashed
    # --argjson (single-JSON-text required).
    CALLED_STEPS=$(as_json_array "$CALLED_STEPS")
    echo "[GOVERNANCE] security steps INVOKED in ${JENKINSFILE}: ${CALLED_STEPS}"

    # (3) Target URL: the reliable source is the dast() call argument itself.
    DAST_TARGET_URL=$(grep -oP 'dast\(\s*"\K[^"]+' "$JENKINSFILE" 2>/dev/null | head -n1 || true)
    echo "[GOVERNANCE] dast target URL from Jenkinsfile: ${DAST_TARGET_URL:-<none>}"

    # (4) Blocking flag: dast.groovy is call(String targetUrl, Boolean blocking=true).
    #     A second argument of `false` means the author chose non-blocking.
    if grep -qP 'dast\(\s*"[^"]*"\s*,\s*false\s*\)' "$JENKINSFILE" 2>/dev/null; then
        DAST_BLOCKING=false
    fi
    DAST_BLOCKING=$(as_json_bool "$DAST_BLOCKING" true)
    echo "[GOVERNANCE] dast blocking mode: ${DAST_BLOCKING}"
else
    echo "[GOVERNANCE] WARNING: Jenkinsfile not readable at '${JENKINSFILE:-<empty>}'." >&2
    echo "[GOVERNANCE] WARNING: Invocation status is UNKNOWN, not absent. The policy" >&2
    echo "[GOVERNANCE]          will skip invocation-based denials for this run." >&2
fi

# (2) Loaded libraries: sast / dast inside the libraries { } block. This reads
# pipeline_config.groovy, a fixed filename, so it is unaffected by which
# Jenkinsfile variant this build used.
LOADED_LIBS_RAW=$(awk '
    /libraries[[:space:]]*\{/ { inblock=1; depth=0 }
    inblock {
        depth += gsub(/\{/, "{")
        depth -= gsub(/\}/, "}")
        if ($0 ~ /^[[:space:]]*(sast|dast)([[:space:]]*\{)?[[:space:]]*$/) {
            gsub(/[^a-z]/, ""); print
        }
        if (depth <= 0 && inblock && NR>1) inblock=0
    }
' "$PIPELINE_CONFIG" 2>/dev/null | sort -u || true)

if [ -z "$LOADED_LIBS_RAW" ]; then
    LOADED_LIBS='[]'
else
    LOADED_LIBS=$(printf '%s\n' "$LOADED_LIBS_RAW" | jq -R . | jq -cs . 2>/dev/null || true)
fi
# Same normalization as CALLED_STEPS: one compact array or [].
LOADED_LIBS=$(as_json_array "$LOADED_LIBS")

if [ -f "$PIPELINE_CONFIG" ]; then
    echo "[GOVERNANCE] security libraries LOADED in ${PIPELINE_CONFIG}: ${LOADED_LIBS}"
else
    echo "[GOVERNANCE] WARNING: pipeline config not found at ${PIPELINE_CONFIG}."
fi

INVOCATION_CHECK_FAILED=$(as_json_bool "$INVOCATION_CHECK_FAILED" true)

# Authoritative present-steps = invoked steps. The policy keys on these.
STEPS="$CALLED_STEPS"

# ── Emit policy input ───────────────────────────────────────────────────────
# Every --argjson value below has been normalized to exactly one well-typed
# JSON value; if anything slips through anyway, the ERR trap emits the
# fail-safe document instead of crashing the build.
jq -n \
    --argjson is_frontend "$IS_FRONTEND" \
    --argjson has_api_gateway "$HAS_API_GATEWAY" \
    --argjson has_http_listener "$HAS_HTTP_LISTENER" \
    --arg target_url_output "$TARGET_URL_OUTPUT" \
    --argjson steps "$STEPS" \
    --argjson loaded_libs "$LOADED_LIBS" \
    --arg dast_target_url "$DAST_TARGET_URL" \
    --argjson dast_blocking "$DAST_BLOCKING" \
    --argjson invocation_check_failed "$INVOCATION_CHECK_FAILED" \
    --arg repo "${REPO_URL:-}" \
    --arg jenkinsfile "${JENKINSFILE:-}" \
    '{
        repo: $repo,
        jenkinsfile: $jenkinsfile,
        pipeline_steps: $steps,
        loaded_libraries: $loaded_libs,
        dast_target_url: (if $dast_target_url == "" then null else $dast_target_url end),
        dast_blocking: $dast_blocking,
        invocation_check_failed: $invocation_check_failed,
        signals: {
            is_frontend:       $is_frontend,
            has_api_gateway:   $has_api_gateway,
            has_http_listener: $has_http_listener,
            target_url_output: (if $target_url_output == "" then null else $target_url_output end)
        }
    }' \
    > "$OUTPUT_FILE"

echo "[GOVERNANCE] SAST/DAST input written to: ${OUTPUT_FILE}"
if [ "${GOVERNANCE_DEBUG:-false}" = "true" ]; then
    cat "$OUTPUT_FILE"
fi


