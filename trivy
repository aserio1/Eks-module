
#!/usr/bin/env python3

# This script identifies recursively .terraform dirs
# found in /home/jenkins/workspace.
# Lists .terraform directories older than 90 days.
# Displays ls -lrt information and generates a CSV report.
# Executed via a Jenkins job that runs daily during off hours.
# DRY-RUN ONLY - no directories are deleted.

import os
import sys
import time
import csv
import stat
import pwd
import grp
import argparse
import subprocess
from datetime import datetime
from concurrent.futures import ThreadPoolExecutor, as_completed
from threading import Lock

ROOT_DIR = "/home/jenkins/workspace"
MAX_WORKERS = 8  # Tune based on EFS throughput limits
STALE_DAYS = 90

print_lock = Lock()


def get_dir_size_fast(path):
    """Use os.scandir recursively for faster size calculation."""
    total = 0

    try:
        with os.scandir(path) as it:
            for entry in it:
                try:
                    if entry.is_file(follow_symlinks=False):
                        total += entry.stat(
                            follow_symlinks=False
                        ).st_size

                    elif entry.is_dir(follow_symlinks=False):
                        total += get_dir_size_fast(entry.path)

                except (PermissionError, FileNotFoundError):
                    pass

    except (PermissionError, FileNotFoundError):
        pass

    return total


def find_terraform_dirs(root):
    """
    Find all .terraform directories recursively.
    Do not traverse inside .terraform directories.
    """
    stack = [root]

    while stack:
        current = stack.pop()

        try:
            with os.scandir(current) as it:
                for entry in it:
                    try:
                        if not entry.is_dir(
                            follow_symlinks=False
                        ):
                            continue

                        if entry.name == ".terraform":
                            yield entry.path
                        else:
                            stack.append(entry.path)

                    except (PermissionError, FileNotFoundError):
                        pass

        except (PermissionError, FileNotFoundError) as e:
            print(
                f"Cannot access {current}: {e}",
                file=sys.stderr
            )


def get_stale_directory_info(path, cutoff):
    """
    Return metadata for directories older than
    the configured retention period.
    """
    try:
        info = os.stat(
            path,
            follow_symlinks=False
        )

        if info.st_mtime >= cutoff:
            return None

        try:
            owner = pwd.getpwuid(info.st_uid).pw_name
        except KeyError:
            owner = str(info.st_uid)

        try:
            group = grp.getgrgid(info.st_gid).gr_name
        except KeyError:
            group = str(info.st_gid)

        return {
            "path": path,
            "mtime": info.st_mtime,
            "modified": datetime.fromtimestamp(
                info.st_mtime
            ).strftime("%Y-%m-%d %H:%M:%S"),
            "owner": owner,
            "group": group,
            "permissions": stat.filemode(info.st_mode),
            "size": None,
            "status": "PROPOSED DELETE - REVIEW REQUIRED"
        }

    except (PermissionError, FileNotFoundError):
        return None


def get_ls_lrt(path):
    """
    Execute ls -lrt -d to display metadata
    for the candidate directory itself.
    """
    try:
        result = subprocess.run(
            ["ls", "-lrt", "-d", "--", path],
            capture_output=True,
            text=True,
            timeout=30,
            check=False
        )

        if result.returncode == 0:
            return result.stdout.strip()

        return f"ERROR: {result.stderr.strip()}"

    except Exception as e:
        return f"ERROR: {e}"


def inspect_candidate(candidate, calculate_size):
    """
    Inspect candidate metadata and optionally
    calculate recursive directory size.
    """
    candidate["ls_output"] = get_ls_lrt(
        candidate["path"]
    )

    if calculate_size:
        candidate["size"] = get_dir_size_fast(
            candidate["path"]
        )

    return candidate


def main():
    parser = argparse.ArgumentParser()

    parser.add_argument(
        "--execute",
        action="store_true",
        help="Execution disabled - dry-run only"
    )

    parser.add_argument(
        "--fast",
        action="store_true",
        help="Skip recursive size calculations"
    )

    parser.add_argument(
        "--output",
        default="jenkins_efs_cleanup_dry_run.csv",
        help="CSV output filename"
    )

    args = parser.parse_args()

    if args.execute:
        print("ERROR: Deletion is disabled.")
        sys.exit(1)

    if not os.path.isdir(ROOT_DIR):
        print(f"ERROR: Workspace root not found: {ROOT_DIR}")
        sys.exit(1)

    start_time = time.monotonic()
    cutoff = time.time() - (STALE_DAYS * 86400)

    print("======================================")
    print("JENKINS EFS CLEANUP - DRY RUN")
    print("======================================")
    print(f"Scanning         : {ROOT_DIR}")
    print(f"Retention period : {STALE_DAYS} days")
    print(f"Workers          : {MAX_WORKERS}")
    print(f"Mode             : DRY-RUN")
    print(f"Fast mode        : {'YES' if args.fast else 'NO'}")
    print()

    terraform_count = 0
    candidates = []

    print("Scanning for stale .terraform directories...")

    for path in find_terraform_dirs(ROOT_DIR):
        terraform_count += 1

        candidate = get_stale_directory_info(
            path,
            cutoff
        )

        if candidate:
            candidates.append(candidate)

    candidates.sort(
        key=lambda item: item["mtime"]
    )

    print(f"Found {terraform_count} .terraform directories")
    print(f"Found {len(candidates)} cleanup candidates")
    print()

    total_size = 0

    with ThreadPoolExecutor(
        max_workers=MAX_WORKERS
    ) as executor:

        results = executor.map(
            lambda candidate: inspect_candidate(
                candidate,
                not args.fast
            ),
            candidates
        )

        print("======================================")
        print("PROPOSED DELETION ITEMS - LS -LRT")
        print("======================================")

        completed = []

        for result in results:
            completed.append(result)

            print()
            print(f"STATUS       : {result['status']}")
            print(f"DIRECTORY    : {result['path']}")
            print(f"LAST MODIFIED: {result['modified']}")
            print(f"OWNER        : {result['owner']}")
            print(f"GROUP        : {result['group']}")
            print(f"PERMISSIONS  : {result['permissions']}")
            print("LS -LRT:")
            print(result["ls_output"])

            if result["size"] is not None:
                total_size += result["size"]

                print(
                    f"ESTIMATED SIZE: "
                    f"{result['size'] / (1024 ** 3):.2f} GiB"
                )

            print("--------------------------------------")

    with open(
        args.output,
        "w",
        newline="",
        encoding="utf-8"
    ) as csvfile:

        writer = csv.writer(csvfile)

        writer.writerow([
            "Status",
            "Directory",
            "Last Modified",
            "Owner",
            "Group",
            "Permissions",
            "Estimated Size GiB",
            "LS -LRT"
        ])

        for item in completed:
            writer.writerow([
                item["status"],
                item["path"],
                item["modified"],
                item["owner"],
                item["group"],
                item["permissions"],
                (
                    f"{item['size'] / (1024 ** 3):.2f}"
                    if item["size"] is not None
                    else "Not calculated"
                ),
                item["ls_output"]
            ])

    elapsed = time.monotonic() - start_time

    print()
    print("======================================")
    print("DRY-RUN SUMMARY")
    print("======================================")
    print(f"Terraform directories found : {terraform_count}")
    print(f"Proposed deletion items      : {len(candidates)}")

    if not args.fast:
        print(
            f"Estimated candidate size     : "
            f"{total_size / (1024 ** 3):.2f} GiB"
        )
    else:
        print("Estimated candidate size     : Not calculated")

    print("Directories deleted          : 0")
    print(f"CSV report                   : {args.output}")
    print(f"Execution time               : {elapsed:.2f} seconds")
    print("======================================")
    print("DRY-RUN: No directories were deleted.")


if __name__ == "__main__":
    main()
