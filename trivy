
customPath = "workspace/${env.JOB_NAME.replace('%2F','/')}/${env.BUILD_NUMBER}"

pipeline {
    agent { label jte.keywords.project }

    triggers {
        cron('0 2 * * 1-5') // Every Monday-Friday at 2:00 AM Jenkins server time.
    }

    stages {
        stage('Disable Concurrent Builds') {
            steps {
                echo "Disabling Concurrent Builds"
                script {
                    disable_concurrent_builds()
                }
            }
        }

        stage('Checkout') {
            steps {
                script {
                    git_checkout()
                }
            }
        }

        stage('Run EFS Cleanup - Dry Run') {
            steps {
                echo "Starting EFS Cleanup DRY RUN..."
                script {
                    setup()

                    ws("${customPath}/admin/scripts") {
                        sh '''
                            set -e

                            echo "======================================"
                            echo "Verifying Dry Run Script"
                            echo "======================================"

                            grep -n 'DRY_RUN = True' cleanup_jenkins_efs.py
                            grep -n 'Deletion enabled : NO' cleanup_jenkins_efs.py

                            if grep -nE 'shutil.rmtree\\(|os.remove\\(|os.unlink\\(' cleanup_jenkins_efs.py; then
                                echo "ERROR: Deletion operation detected."
                                exit 1
                            fi

                            echo "======================================"
                            echo "Running Jenkins EFS Cleanup"
                            echo "======================================"

                            /home/jenkins/anaconda3/envs/python312/bin/python3 -u \
                                cleanup_jenkins_efs.py \
                                --root /home/jenkins/workspace \
                                --stale-days 90 \
                                --max-seconds 300 \
                                --csv jenkins_stale_list.csv

                            echo "======================================"
                            echo "Verifying Generated CSV"
                            echo "======================================"

                            test -s jenkins_stale_list.csv

                            echo "CSV successfully generated:"
                            ls -lh jenkins_stale_list.csv

                            echo "======================================"
                            echo "JENKINS EFS DRY RUN CSV REPORT"
                            echo "======================================"

                            cat jenkins_stale_list.csv
                        '''

                        echo "======================================"
                        echo "Archiving Jenkins EFS Cleanup CSV"
                        echo "======================================"

                        archiveArtifacts artifacts: 'jenkins_stale_list.csv',
                                         allowEmptyArchive: false,
                                         fingerprint: true,
                                         onlyIfSuccessful: false

                        echo "======================================"
                        echo "Jenkins EFS Cleanup Completed"
                        echo "======================================"
                    }
                }
            }
        }
    }

    post {
        success {
            echo 'EFS Cleanup dry run completed successfully. No files deleted.'
        }

        failure {
            echo 'EFS Cleanup dry run failed. Check console output.'
            // email_via_sns()
        }
    }
}
