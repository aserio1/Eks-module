
# ------------------------------------------------------------------------
# Jenkins CloudWatch heartbeat monitoring
# Generate heartbeat logs on EFS every minute
# ------------------------------------------------------------------------

echo "Configuring Jenkins CloudWatch heartbeat on EFS..."

# Install and enable cron
dnf install -y cronie
systemctl enable --now crond

# Create heartbeat directory on Jenkins EFS
mkdir -p /jenkins_jobs/.jenkins-cwagent/heartbeat

# Create heartbeat log file
touch /jenkins_jobs/.jenkins-cwagent/heartbeat/heartbeat.log

# Configure permissions
chmod 755 /jenkins_jobs/.jenkins-cwagent/heartbeat
chmod 644 /jenkins_jobs/.jenkins-cwagent/heartbeat/heartbeat.log

# Create heartbeat script
cat > /usr/local/bin/jenkins-cw-heartbeat.sh <<'EOF'
#!/bin/bash

echo "$(date -u +%Y-%m-%dT%H:%M:%SZ) JENKINS_CW_HEARTBEAT" \
  >> /jenkins_jobs/.jenkins-cwagent/heartbeat/heartbeat.log
EOF

chmod 755 /usr/local/bin/jenkins-cw-heartbeat.sh

# Schedule heartbeat every minute
cat > /etc/cron.d/jenkins-cw-heartbeat <<'EOF'
* * * * * root /usr/local/bin/jenkins-cw-heartbeat.sh
EOF

chmod 644 /etc/cron.d/jenkins-cw-heartbeat

# Generate initial heartbeat
/usr/local/bin/jenkins-cw-heartbeat.sh

echo "Jenkins CloudWatch EFS heartbeat configured successfully."
