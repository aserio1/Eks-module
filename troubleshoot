
name: IMAC Configuration Pipeline

on:
  push:
    branches:
      - main
      - feature-IMAC-1262

  workflow_dispatch:

############################################################
# Prevent concurrent builds
############################################################

concurrency:
  group: imac-config-${{ github.ref }}
  cancel-in-progress: false

############################################################
# IMAC DEV Configuration
############################################################

env:
  PROJECT: imac
  ENV_SHORT_NAME: dev

  AWS_ACCOUNT_ID: "213141505949"

  WORKING_DIRECTORY: infrastructure/terraform

jobs:

  imac-config:

    name: IMAC Configuration Pipeline

    runs-on: [self-hosted, imac]

    permissions:
      contents: read

    steps:

      ##########################################################
      # Git Checkout
      ##########################################################

      - name: Checkout IMAC Config
        uses: actions/checkout@v4

      ##########################################################
      # Verify AWS Identity
      ##########################################################

      - name: Verify AWS Identity
        shell: bash
        run: |
          set -euo pipefail

          echo "[AWS] Verifying AWS identity..."

          # Auth comes from the runner's baked-in AWS profiles.
          # Same authentication approach as Jenkins agents.

          ACTUAL_ACCOUNT=$(
            aws sts get-caller-identity \
              --profile "${AWS_ACCOUNT_ID}" \
              --query Account \
              --output text
          )

          echo "[AWS] Account: ${ACTUAL_ACCOUNT}"

          if [[ "${ACTUAL_ACCOUNT}" != "${AWS_ACCOUNT_ID}" ]]; then
            echo "[AWS] ERROR: Incorrect AWS account."
            exit 1
          fi

          echo "[AWS] AWS identity verified successfully."

      ##########################################################
      # Scan Dependencies
      ##########################################################

      - name: Scan Dependencies
        shell: bash
        run: |
          set -euo pipefail

          echo "[IMAC] Starting dependency scan..."

          # TODO:
          # Implement the equivalent of the Jenkins
          # scan_dependencies() shared-library function.

          echo "[IMAC] Dependency scanning not yet implemented."
          exit 1

      ##########################################################
      # Lint Infrastructure
      ##########################################################

      - name: Lint Infrastructure
        shell: bash
        working-directory: ${{ env.WORKING_DIRECTORY }}
        env:
          AWS_PROFILE: ${{ env.AWS_ACCOUNT_ID }}
        run: |
          set -euo pipefail

          echo "[IMAC] Starting infrastructure linting..."

          terraform fmt -check -recursive

          terraform init -backend=false

          terraform validate

          echo "[IMAC] Terraform validation completed."

      ##########################################################
      # Scan Infrastructure
      ##########################################################

      - name: Scan Infrastructure
        shell: bash
        run: |
          set -euo pipefail

          echo "[IMAC] Starting infrastructure scan..."

          # TODO:
          # Implement the equivalent of the Jenkins
          # scan_infrastructure(true) shared-library function.

          echo "[IMAC] Infrastructure scanning not yet implemented."
          exit 1

      ##########################################################
      # Terraform Plan - DEV
      ##########################################################

      - name: Terraform Plan DEV
        id: terraform-plan
        uses: CDO/imac-shared-gh-actions/terraform/plan@v1
        with:
          project: imac
          env_short_name: dev
          working_directory: infrastructure/terraform
          aws_profile_override: "213141505949"

      ##########################################################
      # Terraform Deploy - DEV
      ##########################################################

      - name: Terraform Deploy DEV
        shell: bash
        working-directory: ${{ env.WORKING_DIRECTORY }}
        env:
          AWS_PROFILE: ${{ steps.terraform-plan.outputs.aws_profile }}
          PLAN_FILE: ${{ steps.terraform-plan.outputs.plan_file }}
        run: |
          set -euo pipefail

          echo "[IMAC] Starting DEV deployment..."

          echo "[IMAC] AWS Profile: ${AWS_PROFILE}"

          if [[ -z "${PLAN_FILE}" || ! -f "${PLAN_FILE}" ]]; then
            echo "[IMAC] ERROR: Terraform plan not found."
            exit 1
          fi

          terraform apply \
            -input=false \
            "${PLAN_FILE}"

          echo "[IMAC] DEV deployment completed."

      ##########################################################
      # Compile IMAC Configuration
      ##########################################################

      - name: Compile IMAC Configuration
        shell: bash
        env:
          AWS_PROFILE: ${{ env.AWS_ACCOUNT_ID }}
        run: |
          set -euo pipefail

          echo "[IMAC] Starting configuration compilation..."

          # TODO:
          # Implement the equivalent of the Jenkins
          # compile_config() shared-library function.
          #
          # This stage should compile the IMAC configuration
          # and publish it to the appropriate DynamoDB table.

          echo "[IMAC] Configuration compilation not yet implemented."
          exit 1
