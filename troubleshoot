#!/usr/bin/env bash

set -e

if ! command -v ~/anaconda3/bin/conda &> /dev/null
then
    wget https://repo.anaconda.com/archive/Anaconda3-2024.06-1-Linux-x86_64.sh
    bash Anaconda3-2024.06-1-Linux-x86_64.sh -b -u
fi

if ! ~/anaconda3/bin/conda info --envs |
    awk '{print $1}' |
    grep -Fxq "$ENV_NAME"
then
    ~/anaconda3/bin/conda create \
        -y \
        --name "$ENV_NAME" \
        python="$PYTHON_VERSION"
fi

echo "Activating Conda environment: $ENV_NAME"

set +x
source ~/anaconda3/bin/activate "$ENV_NAME"
set -x

python --version
python -m pip --version

DEPENDENCY_DIR="${WORKSPACE:-$(pwd)}/.python-deps/${ENV_NAME}"

echo "Using pipeline dependency directory: $DEPENDENCY_DIR"

rm -rf "$DEPENDENCY_DIR"
mkdir -p "$DEPENDENCY_DIR"

for req_file in $REQUIREMENTS
do
    matches=$(find . -type f -iname "$req_file")

    if [[ -z "$matches" ]]
    then
        echo "No matching requirements file found for: $req_file"
        continue
    fi

    while IFS= read -r requirements_file
    do
        echo "Installing requirements from $requirements_file"

        python -m pip install \
            --target "$DEPENDENCY_DIR" \
            --upgrade \
            --no-cache-dir \
            -i "https://repo.platform.aws.hhsoig.gov/repository/$REPO_NAME/simple" \
            --trusted-host repo.platform.aws.hhsoig.gov \
            --no-color \
            -r "$requirements_file"

    done <<< "$matches"
done

export PYTHONPATH="$DEPENDENCY_DIR${PYTHONPATH:+:$PYTHONPATH}"
export PATH="$DEPENDENCY_DIR/bin:$PATH"

echo "PYTHONPATH=$PYTHONPATH"

python -c '
import sys
print("Python executable:", sys.executable)
print("Dependency search paths:")
for path in sys.path:
    print(path)
'

python -m pip check

#######################################
