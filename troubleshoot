#### plan_infrastructure.groovy
void call(ev, profile="", s3_key = null, var_file=null, additional_params = []){
  String createTableScript = resource("create_state_table.sh")
  String terraformInitScript = resource("terraform_init.sh")
  String terraformPlanScript = resource("terraform_plan.sh")

  if (ev instanceof String) {
      ev = jte.application_environments[ev]
  }
  
  if (var_file == null) {
    var_file="${ev.short_name}.tfvars"
  }

  //construct a special formatted stage name for imac deployment
  //for other projects, the profile would be empty 
  def stage_name = ev.short_name
  if (profile != "" && jte.keywords.project == "imac") {
    stage_name = "profile: ${profile}, env: ${ev.short_name}"
  }

  node(jte.keywords.project) {
    
    ws("workspace/${env.JOB_NAME.replace('%2F','/')}/$BUILD_NUMBER") {
      stage("Terraform Plan: ${stage_name}"){
        dir("infrastructure/terraform") {

          tf_params = ""
          additional_params.each { param ->
              tf_params += " -var ${param.key}=${param.value} "
          }
          
          s3_key_param = ""
          if (s3_key) {
            s3_key_param = " --backend-config key=${s3_key} "
          }
        
          prefix = "${jte.keywords.project}-${ev.short_name}"
          
          if (profile != "" && jte.keywords.project == "imac") {
            println("Adding profile ${profile} to state prefixes.")
            prefix = "${prefix}-${profile}"
          }
      
          def aws_profile = ev.short_name
          if (profile != "" && jte.keywords.project == "imac") {
            aws_profile = profile
          }
          
          prefix = prefix.replaceAll("_", "-")

          // Store current environment for use by infra policy check
          writeFile(
            file: '.aws_profile.txt', 
            text: aws_profile
          )
          
          withEnv(["TF_STATE_BUCKET=${prefix}-tf-state-hhsoig",
                  "TF_STATE_TABLE=${prefix}-tf-lock-hhsoig",
                  "TF_VAR_FILE=${var_file}",
                  "TF_ADDITIONAL_VARS=${tf_params}",
                  "TF_S3_KEY=${s3_key_param}",
                  "AWS_PROFILE=${aws_profile}"]) {
              
            sh(
              label: '[Initialize TF_VAR_FILE]',
              script: "touch ${TF_VAR_FILE}"
            )
            
            sh(
              label: '[Create Initial State Buckets]',
              script: createTableScript
            )

            sh(
              label: '[Init Infrastructure]',
              script: terraformInitScript
            )

            sh(
              label: '[Plan Infrastructure]',
              script: terraformPlanScript
            )
          }
        }
      }
    }
  }
}

########## create_state_table.sh
set +x
bucket=$(aws s3api list-buckets --region us-east-1 | jq -r ".Buckets[] | select(.Name==\"${TF_STATE_BUCKET}\")")
if [[ -z "${bucket}" ]]; then
  aws s3api create-bucket --bucket ${TF_STATE_BUCKET} --region us-east-1 >/dev/null
  aws s3api put-bucket-encryption --bucket ${TF_STATE_BUCKET} --region us-east-1 --server-side-encryption-configuration "{\"Rules\": [{\"ApplyServerSideEncryptionByDefault\": {\"SSEAlgorithm\": \"AES256\"}}]}" >/dev/null
  aws s3api put-bucket-versioning --bucket ${TF_STATE_BUCKET} --region us-east-1 --versioning-configuration Status=Enabled >/dev/null
  aws s3api put-public-access-block --bucket ${TF_STATE_BUCKET} --region us-east-1 --public-access-block-configuration "BlockPublicAcls=true,IgnorePublicAcls=true,BlockPublicPolicy=true,RestrictPublicBuckets=true"
fi

tableExists=$(aws dynamodb list-tables --region us-east-1 | jq -r ".TableNames | index (\"${TF_STATE_TABLE}\") ")
if [[ "${tableExists}" == "null" ]]; then
  aws dynamodb create-table --region us-east-1 --table-name ${TF_STATE_TABLE} --key-schema AttributeName=LockID,KeyType=HASH --attribute-definitions AttributeName=LockID,AttributeType=S --billing-mode PAY_PER_REQUEST >/dev/null
fi

################ terraform_init.sh
echo "Running terraform init..."

# imac-jenkins-job will vendor a patched provider binary under infrastructure/terraform/tools/
# to work around bugs in third-party providers (see imac-jenkins-jobs, ref
# taiidani/terraform-provider-jenkins#269 for the taiidani/jenkins case).
# If present, point Terraform at it via dev_overrides instead of the registry
# version. Has no effect on projects that don't vendor anything here.
if [ -f "tools/terraform-provider-jenkins_v0.11.0" ]; then
  VENDOR_DIR="$(pwd)/tools"
  echo "Using vendored taiidani/jenkins provider from ${VENDOR_DIR}"
  cat > "${HOME}/.terraformrc" << EOF
provider_installation {
  dev_overrides {
    "taiidani/jenkins" = "${VENDOR_DIR}"
  }
  direct {}
}
EOF
fi

terraform init -no-color -backend-config region=us-east-1 -backend-config bucket=${TF_STATE_BUCKET} -backend-config dynamodb_table=${TF_STATE_TABLE} ${TF_S3_KEY} -upgrade -reconfigure

#############  terraform_plan.sh

echo "Running terraform plan..."

terraform plan -no-color --var-file=${TF_VAR_FILE} ${TF_ADDITIONAL_VARS} -lock=false --out=${AWS_PROFILE}.tfplan
