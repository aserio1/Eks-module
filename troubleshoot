void call() {

  stage("Publish to SNS") {
    node(jte.keywords.project) {
      ws("workspace/${env.JOB_NAME.replace('%2F','/')}/$BUILD_NUMBER") {
        println "Publishing a message to Jenkins SNS topic."

        script {
          def jenkins_env = "prod"

          if (env.JENKINS_URL.startsWith("https://dev")) {
            jenkins_env = "dev"
          }

          def sns_arn = sh(
            returnStdout: true,
            script: "unset AWS_PROFILE && aws sns list-topics --region us-east-1 --output text | grep ${jenkins_env}-jenkins-notifications | cut -d 'S' -f 2 | tr -d '\\t'"
          ).trim()

          def buildStatus = currentBuild.result

          // Use JOB_BASE_NAME instead of the full JOB_NAME.
          def subject = "JENKINS(${jenkins_env}): ${env.JOB_BASE_NAME} #${env.BUILD_NUMBER} ${buildStatus}"

          def message = "Please go to ${env.BUILD_URL} and verify the build"

          try {
            sh """
              unset AWS_PROFILE

              aws sns publish \
                --topic-arn '${sns_arn}' \
                --subject '${subject}' \
                --message '${message}' \
                --message-attributes '{"department":{"DataType":"String","StringValue":"${jte.keywords.project}"}}'
            """
          } catch (Exception e) {
            println "ERROR: Cannot publish message to the ${jenkins_env}-jenkins-notifications SNS topic..."
            throw e
          }
        }
      }
    }
  }
}
