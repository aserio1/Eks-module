################################################################################
# IMAC Jenkins Agent Docker Image
#
################################################################################

FROM AWS_ECR_ACCOUNT_ID.dkr.ecr.AWS_ECR_REGION.amazonaws.com/oig/omp/base/ib-python314:BASE_IMAGE_VERSION

LABEL   oig.imac.base.image.purpose="Jenkins Agent Docker image" \
        oig.imac.image.owner="Kate Rose" \
        oig.imac.image.engineer="Kent Rockwell" \
        oig.imac.base.image.parent="IMAC Jenkins base Docker image" \
        oig.imac.base.image.parent.registry="213141505949.dkr.ecr.us-east-1.amazonaws.com/oig/imac/base/jenkins:BASE_IMAGE_VERSION" \
        oig.imac.base.image.ontogeny.registry="registry1.dso.mil/ironbank" \
        oig.imac.base.image.ontogeny.image="registry1.dso.mil/ironbank/opensource/python:v3.14.5@sha256:be4255a2642bcf619c9594ebb4cbd8ac046ce9ce8c6e69b338048f53164e4b9a"

ARG user=jenkins
ARG group=jenkins
ARG uid=2000
ARG gid=2000
ARG JENKINS_HOME=/home/jenkins
ARG YQ_VERSION=4.53.3
ARG REGAL_VERSION=0.41.1
ARG OPA_VERSION=1.18.1
ARG TRIVY_VERSION=0.72.0
ARG SONAR_VERSION=8.0.1.6346
ARG OPENGREP_VERSION=1.16.3
ARG NUCLEI_VERSION=3.10.0
ARG NUCLEI_TEMPLATES_VERSION=10.3.9

WORKDIR /home/jenkins

USER root

# Create User
RUN mkdir -p $JENKINS_HOME && \
  chown ${uid}:${gid} $JENKINS_HOME && \
  groupadd -g ${gid} ${group} && \
  useradd -N -d "$JENKINS_HOME" -u ${uid} -g ${gid} -l -m -s /bin/bash ${user}

# Install OS Packages
RUN dnf -y install procps jq && \
  dnf -y module install nodejs:18/common && \
  npm install --global yarn && \
  yarn --version

# Install Repositories
RUN yum install -y yum-utils && \
  yum-config-manager --add-repo https://rpm.releases.hashicorp.com/RHEL/hashicorp.repo && \
  dnf config-manager --add-repo=https://download.docker.com/linux/centos/docker-ce.repo

RUN yum -y update && \
    yum -y install \
      java-21-openjdk \
      make \
      terraform \
      openssh-server && \
    yum clean all && \
    rm -rf /var/cache/yum/*

# Docker CLI only (Removes vulnerable containerd/runc engine)
RUN dnf install -y --nobest docker-ce-cli && \
    dnf remove -y docker-compose-plugin && \
    dnf clean all

# Update trivy to the specified version
RUN rpm -qa trivy && rpm -e trivy || true && \
    rpm -ivh https://github.com/aquasecurity/trivy/releases/download/v${TRIVY_VERSION}/trivy_${TRIVY_VERSION}_Linux-64bit.rpm && \
    mkdir -p /home/jenkins/.trivy && \
    trivy --version && \
    echo "jenkins ALL=(ALL) NOPASSWD: ALL" >> /etc/sudoers

################################################################################
# Install OpenGrep
################################################################################
RUN curl -fsSL https://github.com/opengrep/opengrep/releases/download/v${OPENGREP_VERSION}/opengrep-core_linux_x86.tar.gz -o ogc.tar.gz && \
    tar -xvzpf ogc.tar.gz && \
    chmod +x opengrep-core && \
    mv opengrep-core /usr/bin && \
    rm ogc.tar.gz

RUN mkdir -p ${JENKINS_HOME}/.opengrep && \
    cd ${JENKINS_HOME}/.opengrep && git clone https://github.com/opengrep/opengrep-rules.git && \
    find ${JENKINS_HOME}/.opengrep/opengrep-rules -name "*.yaml" -o -name "*.yml" | \
      xargs -I{} sh -c 'iconv -f utf-8 -t ascii "{}" > /dev/null 2>&1 || rm -f "{}"' && \
    rm -rf ${JENKINS_HOME}/.opengrep/opengrep-rules/.github ${JENKINS_HOME}/.opengrep/opengrep-rules/stats ${JENKINS_HOME}/.opengrep/opengrep-rules/scripts && \
    rm -f ${JENKINS_HOME}/.opengrep/opengrep-rules/.pre-commit-config.yaml ${JENKINS_HOME}/.opengrep/opengrep-rules/metadata-schema.yaml.schm && \
    find ${JENKINS_HOME}/.opengrep/opengrep-rules -name "*.test.yaml" -o -name "*.test.yml" | xargs rm -f && \
    # Strip non-rule test fixture files that contain example secrets/keys.
    # Opengrep only reads .yaml/.yml rule files — these .go/.txt/.jsx/.py/.js etc.
    # files are test data from the upstream repo that trigger false positive secret findings.
    find ${JENKINS_HOME}/.opengrep/opengrep-rules -type f \
      ! -name "*.yaml" ! -name "*.yml" \
      ! -name "LICENSE" ! -name "README*" ! -name "CODEOWNERS" \
      -delete && \
    chown -R jenkins:jenkins ${JENKINS_HOME}/.opengrep

################################################################################
# Install Nuclei
################################################################################
RUN curl -fsSL https://github.com/projectdiscovery/nuclei/releases/download/v${NUCLEI_VERSION}/nuclei_${NUCLEI_VERSION}_linux_amd64.zip -o nuclei.zip && \
    unzip nuclei.zip nuclei && \
    chmod +x nuclei && \
    mv nuclei /usr/bin && \
    rm -f nuclei.zip

RUN curl -fsSL https://github.com/projectdiscovery/nuclei-templates/archive/refs/tags/v${NUCLEI_TEMPLATES_VERSION}.tar.gz -o nuclei-templates.tar.gz && \
    tar -xzf nuclei-templates.tar.gz && \
    mkdir -p ${JENKINS_HOME}/.nuclei/nuclei-templates && \
    mv nuclei-templates-${NUCLEI_TEMPLATES_VERSION}/* ${JENKINS_HOME}/.nuclei/nuclei-templates/ && \
    rm -f nuclei-templates.tar.gz && \
    chown -R jenkins:jenkins ${JENKINS_HOME}/.nuclei

################################################################################
# Install yq (YAML processor)
################################################################################
RUN wget -q https://github.com/mikefarah/yq/releases/download/v${YQ_VERSION}/yq_linux_amd64 -O /usr/local/bin/yq && \
    chmod +x /usr/local/bin/yq && \
    yq --version

################################################################################
# Install tflint (terraform linter)
################################################################################
RUN curl -s https://raw.githubusercontent.com/terraform-linters/tflint/master/install_linux.sh | bash && \
    tflint --version

RUN chown -R jenkins:jenkins $JENKINS_HOME && \
    chown -R jenkins:jenkins /usr/local/lib/python3.14 && \
    chown -R jenkins:jenkins /usr/local/bin

USER jenkins

# Install python-docker and dependencies & patch conda base site-packages
RUN pip install --no-cache-dir PyYAML docker Jinja2 && \
    wget https://repo.anaconda.com/miniconda/Miniconda3-py310_24.7.1-0-Linux-x86_64.sh && \
    bash Miniconda3-py310_24.7.1-0-Linux-x86_64.sh -b -p $HOME/anaconda3 && \
    /home/jenkins/anaconda3/bin/python -m pip install --no-cache-dir -U \
      "brotli>=1.2.0" \
      "urllib3>=2.7.0" \
      "setuptools>=78.1.1" \
      "jaraco.context>=6.1.0" \
      "wheel>=0.46.3" \
      "cryptography>=46.0.5" \
      "policy_sentry==0.15.1"

COPY dependencies/python310.env.yml .
COPY dependencies/python312.env.yml .
COPY dependencies/python313.env.yml .
COPY dependencies/python314.env.yml .
RUN /home/jenkins/anaconda3/bin/conda env create -f python310.env.yml && \
    /home/jenkins/anaconda3/bin/conda env create -f python312.env.yml && \
    /home/jenkins/anaconda3/bin/conda env create -f python313.env.yml && \
    /home/jenkins/anaconda3/bin/conda env create -f python314.env.yml && \
    /home/jenkins/anaconda3/bin/conda clean -a -y && \
    /home/jenkins/anaconda3/bin/conda clean --force-pkgs-dirs -y

USER root

# Install Sonarqube Scanner
RUN aws s3 cp s3://jenkins-binaries-213141505949/sonar-scanner-cli-${SONAR_VERSION}-linux-x64.zip . && \
    unzip ./sonar-scanner-cli-${SONAR_VERSION}-linux-x64.zip -d /usr/lib/sonar-scanner && \
    chmod -R 755 /usr/lib/sonar-scanner && \
    rm -rf sonar-scanner-cli-${SONAR_VERSION}-linux-x64.zip && \
    ln -sf /usr/lib/sonar-scanner/sonar-scanner-${SONAR_VERSION}-linux-x64/bin/sonar-scanner /usr/local/bin/sonar-scanner

################################################################################
# Install OPA + Regal
################################################################################
RUN wget -q https://github.com/open-policy-agent/opa/releases/download/v${OPA_VERSION}/opa_linux_amd64_static -O /usr/local/bin/opa && \
    wget -q https://github.com/StyraInc/regal/releases/download/v${REGAL_VERSION}/regal_Linux_x86_64 -O /usr/local/bin/regal && \
    chmod +x /usr/local/bin/opa /usr/local/bin/regal && \
    opa version && \
    regal version

COPY dependencies/cred.xml $JENKINS_HOME/cred.xml
COPY dependencies/node.xml $JENKINS_HOME/node.xml
COPY dependencies/sonar-scanner.properties /usr/lib/sonar-scanner/sonar-scanner-4.7.0.2747-linux/conf/sonar-scanner.properties
COPY dependencies/register.sh $JENKINS_HOME/register.sh

RUN mkdir -p $JENKINS_HOME/.ssh && \
    mkdir -p $JENKINS_HOME/.aws

# Set up the properties file
ENV SONAR_SCANNER_OPTS="-Dsonar.host.url=https://sonar.platform.aws.hhsoig.gov/"
# Run Sonar Scanner
ENV SONAR_RUNNER_HOME=/usr/local/bin/sonar-scanner

RUN keytool -import -alias hhsoig -keystore /usr/lib/sonar-scanner/sonar-scanner-${SONAR_VERSION}-linux-x64/jre/lib/security/cacerts -file /etc/pki/ca-trust/source/anchors/sonar.platform.aws.hhsoig.gov.crt -storepass changeit -trustcacerts -noprompt

# Setup SSH
RUN ssh-keygen -A && \
    sed -i /etc/ssh/sshd_config \
        -e 's/#PermitRootLogin.*/PermitRootLogin no/' \
        -e 's/#PasswordAuthentication.*/PasswordAuthentication no/' \
        -e 's/#SyslogFacility.*/SyslogFacility AUTH/' \
        -e 's/#LogLevel.*/LogLevel INFO/' \
        -e 's/#PermitUserEnvironment.*/PermitUserEnvironment yes/' && \
    mkdir /var/run/sshd 
    
ENV JENKINS_HOME $JENKINS_HOME

VOLUME /var/lib/containers

CMD [ "./register.sh"]
