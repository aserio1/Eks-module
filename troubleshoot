package cdo.terraform.required_default_tagging

import rego.v1

import data.cdo.terraform.required_default_tagging as check


###############################################################################
# Mock dynamic tagging configuration
#
# This represents the data.json generated from imac-config.
# Legacy aliases such as dwb, mle, and arcgis are intentionally NOT included
# in projects because they are resolved by the policy to canonical Projects.
###############################################################################

mock_tagging := {
    "projects": [
        "cgap",
        "data_workbench",
        "gis",
        "ides",
        "imac",
        "ml-engineering",
        "oams",
        "salt",
        "sia",
        "sie",
        "swift-insights-explorer",
        "utility",
    ],
    "environments": {
        "cgap": ["dev", "test", "qa", "stage", "prod"],
        "data_workbench": ["dev", "predev", "test", "qa", "stage", "prod"],
        "gis": ["dev", "predev", "test", "qa", "stage", "prod"],
        "ides": ["dev", "test", "qa", "stage", "prod"],
        "imac": ["dev", "predev", "test", "qa", "stage", "prod", "dev-imac-lza"],
        "ml-engineering": ["dev", "test", "qa", "stage", "prod"],
        "oams": ["dev", "test", "qa", "stage", "prod"],
        "salt": ["dev", "prod"],
        "sia": ["dev", "prod"],
        "sie": ["dev", "qa", "stage", "prod"],
        "swift-insights-explorer": ["dev", "qa", "prod"],
        "utility": ["dev", "prod"],
    },
}


###############################################################################
# Dynamic Project / Environment tests
###############################################################################

test_valid_dynamic_project_environment if {
    result := check.deny
        with input as {
            "resource_changes": [],
        }
        with data.tagging as mock_tagging

    count(result) == 0
}


###############################################################################
# IMAC Environment tests
###############################################################################

# dev-imac-lza is defined under the IMAC environments in imac-config.
test_valid_imac_lza_environment if {
    result := check.valid_environment("imac", "dev-imac-lza")
        with data.tagging as mock_tagging

    result
}

# IMAC may use a 12-digit AWS account ID as Environment.
test_imac_account_id_environment_allowed if {
    result := check.valid_environment("imac", "123456789012")
        with data.tagging as mock_tagging

    result
}

# Other Projects cannot use an AWS account ID as Environment.
test_non_imac_account_id_environment_denied if {
    not check.valid_environment("sie", "123456789012")
        with data.tagging as mock_tagging
}


###############################################################################
# DWB legacy Project alias
#
# dwb -> data_workbench
###############################################################################

test_legacy_dwb_project_alias_allowed if {
    result := check.resolved_project("dwb")
        with data.tagging as mock_tagging

    result == "data_workbench"
}

test_legacy_dwb_environment_allowed if {
    canonical_project := check.resolved_project("dwb")
        with data.tagging as mock_tagging

    check.valid_environment(canonical_project, "dev")
        with data.tagging as mock_tagging
}

test_legacy_dwb_invalid_environment_denied if {
    canonical_project := check.resolved_project("dwb")
        with data.tagging as mock_tagging

    not check.valid_environment(canonical_project, "invalid-env")
        with data.tagging as mock_tagging
}


###############################################################################
# MLE legacy Project alias
#
# mle -> ml-engineering
###############################################################################

test_legacy_mle_project_alias_allowed if {
    result := check.resolved_project("mle")
        with data.tagging as mock_tagging

    result == "ml-engineering"
}

test_legacy_mle_environment_allowed if {
    canonical_project := check.resolved_project("mle")
        with data.tagging as mock_tagging

    check.valid_environment(canonical_project, "dev")
        with data.tagging as mock_tagging
}

test_legacy_mle_invalid_environment_denied if {
    canonical_project := check.resolved_project("mle")
        with data.tagging as mock_tagging

    not check.valid_environment(canonical_project, "invalid-env")
        with data.tagging as mock_tagging
}


###############################################################################
# ARCGIS legacy Project alias
#
# arcgis -> gis
#
# "arcgis" is intentionally not present in mock_tagging.projects.
# The policy must resolve it to the canonical "gis" Project and then use
# the dynamically loaded GIS Environment configuration.
###############################################################################

test_legacy_arcgis_project_alias_allowed if {
    result := check.resolved_project("arcgis")
        with data.tagging as mock_tagging

    result == "gis"
}

test_legacy_arcgis_environment_allowed if {
    canonical_project := check.resolved_project("arcgis")
        with data.tagging as mock_tagging

    check.valid_environment(canonical_project, "dev")
        with data.tagging as mock_tagging
}

test_legacy_arcgis_invalid_environment_denied if {
    canonical_project := check.resolved_project("arcgis")
        with data.tagging as mock_tagging

    not check.valid_environment(canonical_project, "invalid-env")
        with data.tagging as mock_tagging
}


###############################################################################
# Invalid dynamic configuration tests
###############################################################################

test_invalid_project_denied if {
    not check.resolved_project("not-a-project")
        with data.tagging as mock_tagging
}

test_invalid_environment_denied if {
    not check.valid_environment("gis", "invalid-env")
        with data.tagging as mock_tagging
}


###############################################################################
# Missing / malformed dynamic tagging data
###############################################################################

# No data.tagging document is supplied.
test_missing_dynamic_tagging_data if {
    result := check.deny
        with input as {
            "resource_changes": [],
        }

    "tagging data was not provided to policy evaluation" in result
}

# data.tagging exists but is empty.
test_empty_dynamic_tagging_data if {
    result := check.deny
        with input as {
            "resource_changes": [],
        }
        with data.tagging as {}

    "tagging data is empty" in result
}

# data.tagging exists but projects is missing.
test_missing_dynamic_projects_data if {
    result := check.deny
        with input as {
            "resource_changes": [],
        }
        with data.tagging as {
            "environments": {
                "imac": ["dev", "prod"],
            },
        }

    "tagging projects data was not provided to policy evaluation" in result
}

# data.tagging exists but environments is missing.
test_missing_dynamic_environments_data if {
    result := check.deny
        with input as {
            "resource_changes": [],
        }
        with data.tagging as {
            "projects": ["imac"],
        }

    "tagging environments data was not provided to policy evaluation" in result
}
