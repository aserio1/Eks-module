# Test that a resource with no tags/tags_all/tag fields (untaggable) is not denied
test_untaggable_resource_not_denied if {
	res := check.deny with input as {
		"format_version": "1.2",
		"terraform_version": "1.13.0",
		"resource_changes": [{
			"address": "aws_iam_role_policy.inline_policy",
			"mode": "managed",
			"type": "aws_iam_role_policy",
			"name": "inline_policy",
			"provider_name": "registry.terraform.io/hashicorp/aws",
			"change": {
				"actions": ["create"],
				"after": {
					"name": "my-inline-policy",
					"policy": "{\"Version\":\"2012-10-17\"}",
					"role": "my-role",
				},
				"after_unknown": {},
			},
		}],
	}

	# No tags/tags_all/tag fields present — collect_resource_tags returns {}
	# so the resource should be treated as untaggable and not denied
	count(res) == 0
}

