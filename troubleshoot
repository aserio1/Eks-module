package cdo.terraform.required_default_tagging

import rego.v1


###############################################################################
# Legacy Project aliases
#
# These Project names are used by existing resources but are not the canonical
# Project names stored in imac-config.
#
# Environment validation always uses the canonical Project's dynamically
# loaded Environment configuration.
###############################################################################

project_aliases := {
    "dwb": "data_workbench",
    "mle": "ml-engineering",
    "arcgis": "gis",
}


###############################################################################
# Required tag configuration
###############################################################################

required_tags := {
    "BusinessUnit": ["cdo"],
    "FISMABoundary": ["dsgss", "dwb"],
}

flexible_required_tags := {
    "ApplicationName",
    "OwnerContact",
    "CreatedBy",
}

# Project and Environment values are dynamically supplied by imac-config.
dynamic_required_tags := {
    "Environment",
    "Project",
}

all_required_tag_keys := object.keys(required_tags) |
    flexible_required_tags |
    dynamic_required_tags

valid_actions := {
    "create",
    "update",
}

# IMAC may use a 12-digit AWS account ID as its Environment value.
aws_account_id_pattern := `^\d{12}$`


###############################################################################
# Resources that should not be evaluated
#
# Keep/add the exact ignored resource types from your existing policy here.
###############################################################################

ignored_resource_types := {
    "aws_default_security_group",
    "aws_default_network_acl",
    "aws_default_route_table",
}


###############################################################################
# Dynamic tagging data validation
###############################################################################

# No tagging configuration was supplied to OPA.
deny contains msg if {
    not data.tagging

    msg := "tagging data was not provided to policy evaluation"
}

# Tagging configuration exists but contains no data.
deny contains msg if {
    data.tagging
    count(data.tagging) == 0

    msg := "tagging data is empty"
}

# Fail closed when the tagging object exists but the Project list is missing.
deny contains msg if {
    data.tagging
    count(data.tagging) > 0
    not data.tagging.projects

    msg := "tagging projects data was not provided to policy evaluation"
}

# Fail closed when the tagging object exists but the Environment mapping
# is missing.
deny contains msg if {
    data.tagging
    count(data.tagging) > 0
    not data.tagging.environments

    msg := "tagging environments data was not provided to policy evaluation"
}


###############################################################################
# Project validation and alias resolution
###############################################################################

# Canonical Project already exists in the Project list loaded from imac-config.
resolved_project(project) := project if {
    project in data.tagging.projects
}

# Resolve legacy Project names to the canonical Project stored in imac-config.
#
# dwb    -> data_workbench
# mle    -> ml-engineering
# arcgis -> gis
resolved_project(project) := canonical_project if {
    canonical_project := project_aliases[project]
    canonical_project in data.tagging.projects
}


###############################################################################
# Environment validation
###############################################################################

# Validate Environment against the dynamically loaded environments belonging
# to the canonical Project.
valid_environment(project, environment) if {
    project_environments := data.tagging.environments[project]
    environment in project_environments
}

# IMAC has an additional supported Environment format where the Environment
# can be a 12-digit AWS account ID.
valid_environment(project, environment) if {
    project == "imac"
    regex.match(aws_account_id_pattern, environment)
}


###############################################################################
# Resource helpers
###############################################################################

# Return tags from the Terraform resource's resulting state.
#
# object.get prevents an undefined-value error when a resource does not
# contain a tags attribute.
collect_resource_tags(resource) := tags if {
    after := object.get(resource.change, "after", {})
    tags := object.get(after, "tags", {})
}

# Resource must contain one of the actions evaluated by this policy.
resource_has_valid_action(resource) if {
    some action in resource.change.actions
    action in valid_actions
}

# Ignore resource types that do not need this tagging policy.
resource_is_ignored(resource) if {
    resource.type in ignored_resource_types
}


###############################################################################
# Missing required tags
###############################################################################

collect_missing_tags(resource) := missing if {
    resource_tags := collect_resource_tags(resource)

    missing := [tag |
        some tag in all_required_tag_keys
        value := object.get(resource_tags, tag, null)
        value == null
    ]
}


###############################################################################
# Empty required tags
###############################################################################

collect_empty_tags(resource) := empty if {
    resource_tags := collect_resource_tags(resource)

    empty := [tag |
        some tag in all_required_tag_keys
        value := object.get(resource_tags, tag, null)
        value != null
        value == ""
    ]
}


###############################################################################
# Invalid required tag values
###############################################################################

collect_invalid_tags(resource) := invalid if {
    resource_tags := collect_resource_tags(resource)

    # Validate tags with predefined static allowed values.
    invalid_static := [sprintf("%s=%s", [tag, value]) |
        some tag in object.keys(required_tags)

        value := object.get(resource_tags, tag, null)

        value != null
        value != ""

        not value in required_tags[tag]
    ]

    # Project must either exist directly in imac-config or resolve through
    # one of the supported legacy aliases.
    invalid_project := [sprintf("Project=%s", [project]) |
        project := object.get(resource_tags, "Project", null)

        project != null
        project != ""

        data.tagging.projects

        not resolved_project(project)
    ]

    # Environment validation uses the resolved canonical Project.
    #
    # Examples:
    #
    # dwb    -> data_workbench
    # mle    -> ml-engineering
    # arcgis -> gis
    #
    # Therefore Project=arcgis will use:
    #
    # data.tagging.environments["gis"]
    invalid_environment := [sprintf("Environment=%s", [environment]) |
        project := object.get(resource_tags, "Project", null)
        environment := object.get(resource_tags, "Environment", null)

        project != null
        project != ""

        environment != null
        environment != ""

        data.tagging.projects
        data.tagging.environments

        canonical_project := resolved_project(project)

        not valid_environment(canonical_project, environment)
    ]

    invalid := array.flatten([
        invalid_static,
        invalid_project,
        invalid_environment,
    ])
}


###############################################################################
# Terraform resource evaluation
###############################################################################

deny contains msg if {
    some resource in input.resource_changes

    resource_has_valid_action(resource)
    not resource_is_ignored(resource)

    missing := collect_missing_tags(resource)
    count(missing) > 0

    msg := sprintf(
        "Resource %s is missing required tags: %v",
        [resource.address, missing],
    )
}

deny contains msg if {
    some resource in input.resource_changes

    resource_has_valid_action(resource)
    not resource_is_ignored(resource)

    empty := collect_empty_tags(resource)
    count(empty) > 0

    msg := sprintf(
        "Resource %s has empty required tags: %v",
        [resource.address, empty],
    )
}

deny contains msg if {
    some resource in input.resource_changes

    resource_has_valid_action(resource)
    not resource_is_ignored(resource)

    invalid := collect_invalid_tags(resource)
    count(invalid) > 0

    msg := sprintf(
        "Resource %s has invalid tag values: %v",
        [resource.address, invalid],
    )
}





















