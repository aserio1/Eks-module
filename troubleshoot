# Confirm current branch and commit
git branch --show-current
git log -1 --oneline

# Confirm heartbeat Terraform resources are present
grep -R -n 'resource "aws_cloudwatch_log_metric_filter" "jenkins_heartbeat"' .
grep -R -n 'resource "aws_cloudwatch_metric_alarm" "jenkins_logs_missing"' .

# Check whether the resources are already managed in state
terraform state list | grep -E 'jenkins_heartbeat|jenkins_logs_missing'

# Check whether the user-data template is referenced
grep -R -n 'user_data.tpl\|cloudwatch_agent_json' .
