controller iam.tf
##################
resource "aws_iam_role" "jenkins_controller_ssm_role" {
  name = "${var.prefix}-jenkins_main_ssm_role"
  assume_role_policy = jsonencode({
    "Version" : "2012-10-17",
    "Statement" : [
      {
        "Sid" : "AssumeRoleSID",
        "Effect" : "Allow",
        "Principal" : {
          "Service" : "ec2.amazonaws.com"
        },
        "Action" : "sts:AssumeRole"
      }
    ]
  })
}

resource "aws_iam_role_policy_attachment" "jenkins_policy_attachment" {
  for_each = var.jenkins_controller_policies

  role       = aws_iam_role.jenkins_controller_ssm_role.name
  policy_arn = "arn:aws:iam::aws:policy/${each.key}"
}






