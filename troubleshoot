sudo find /jenkins_jobs \
  -mindepth 1 -maxdepth 1 \
  -type d -mtime +90 \
  -printf '%p\n' | wc -l

sudo find /jenkins_jobs \
  -mindepth 1 -maxdepth 1 \
  -type d -mtime +90 \
  -name '*@tmp' \
  -printf '%p\n' | wc -l


sudo find /jenkins_jobs \
  -mindepth 1 -maxdepth 1 \
  -type d -mtime +90 \
  -printf '%T@ %p\n' \
  | sort -n \
  | head -20
