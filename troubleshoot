sudo du -h --max-depth=1 /jenkins_jobs 2>/dev/null \
  | sort -hr | head -30

sudo du -sh /jenkins_jobs

sudo find /jenkins_jobs -type f -size +500M \
  -printf '%s %p\n' 2>/dev/null \
  | sort -nr | head -30 \
  | awk '{printf "%.2f GiB %s\n", $1/1024/1024/1024, $2}'


sudo find /jenkins_jobs -mindepth 1 -maxdepth 1 \
  -type d -mtime +90 \
  -printf '%TY-%Tm-%Td %p\n' \
  | sort

sudo find /jenkins_jobs -type d -name ".terraform" \
  -prune -print | wc -l

