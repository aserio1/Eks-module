# METADATA
# title: Check for missing AWS tags
# description: Check for missing aws tags to AWS resources defined by Terraform region.
# scope: package
# entrypoint: true
# custom:
#   id: CDO-TFPLAN-0002
#   avd_id: CDO-TFPLAN-0002
#   severity: CRITICAL
#   short_code: required-default-tagging
#   recommended_actions: Ensure you have the default tags set.
#   input:
#     selector:
#       - type: json
package cdo.terraform.required_default_tagging

import rego.v1


# Resources we want to ignore
ignored_resource_types := {
	"aws_api_gateway_documentation_part",
	"aws_api_gateway_integration",
	"aws_api_gateway_resource",
	"aws_apigatewayv2_integration",
	"aws_apigatewayv2_route",
	"aws_appconfig_hosted_configuration_version",
	"aws_backup_selection",
	"aws_cloudwatch_event_target",
	"aws_cloudwatch_log_subscription_filter",
	"aws_cognito_identity_provider",
	"aws_iam_role_policy",
	"aws_iam_policy_attachment",
	"aws_iam_role_policy_attachment",
	"aws_kms_alias",
	"aws_lakeformation_data_lake_setting",
	"aws_lakeformation_lf_tag",
	"aws_lakeformation_lf_tag_policy",
	"aws_lakeformation_permissions",
	"aws_lakeformation_resource",
	"aws_lakeformation_resource_lf_tags",
	"aws_lambda_layer_version",
	"aws_lambda_permission",
	"aws_lb_listener_rule",
	"aws_lb_listener",
	"aws_lb_target_group_attachment",
	"aws_s3_bucket_acl",
	"aws_s3_bucket_lifecycle_configuration",
	"aws_s3_bucket_policy",
	"aws_s3_bucket_public_access_block",
	"aws_s3_bucket_server_side_encryption_configuration",
	"aws_s3_bucket_versioning",
	"aws_sagemaker_image_version",
	"aws_scheduler_schedule",
	"aws_secretsmanager_secret_version",
	"aws_security_group_rule",
	"aws_sns_topic_subscription",
	"aws_ssoadmin_application_assignment",
	"aws_vpc_security_group_ingress_rule",
	"aws_vpc_security_group_egress_rule",
	"aws_vpc_endpoint_route_table_association",
	"aws_route_table_association",
	"aws_subnet_route_table_association",
	"jenkins_folder",
	"jenkins_job",
	"null_resource",
	"random_password",
	"terraform_data",
	"time_static",
}


# AWS account ID format.
# IMAC is allowed to use a 12-digit AWS account ID as Environment.
aws_account_id_pattern := `^\d{12}$`


# Required tags with fixed allowed values
required_tags := {
	"BusinessUnit": ["cdo"],
	"FISMABoundary": ["dsgss", "dwb"],
}


# Required tags whose values are not restricted to a predefined list
flexible_required_tags := {
	"ApplicationName",
	"OwnerContact",
	"CreatedBy",
}


# Required tags whose allowed values come dynamically from imac-config
dynamic_required_tags := {
	"Environment",
	"Project",
}


# Union of all required tag keys
all_required_tag_keys := object.keys(required_tags) |
	flexible_required_tags |
	dynamic_required_tags


# Only evaluate resources being created or updated
valid_actions := {
	"create",
	"update",
}


###############################################################################
# Dynamic tagging data validation
###############################################################################

# The tagging object must be provided to the policy.
deny contains msg if {
	not data.tagging

	msg := "tagging data was not provided to policy evaluation"
}


# The tagging object must not be empty.
deny contains msg if {
	count(data.tagging) == 0

	msg := "tagging data is empty"
}


# The tagging object must contain the dynamic Project list.
deny contains msg if {
	data.tagging
	not data.tagging.projects

	msg := "tagging projects data was not provided to policy evaluation"
}


# The tagging object must contain the project-specific Environment map.
deny contains msg if {
	data.tagging
	not data.tagging.environments

	msg := "tagging environments data was not provided to policy evaluation"
}


###############################################################################
# Missing required tags
###############################################################################

deny contains res if {
	some resource in input.resource_changes

	not ignored_resource_types[resource.type]

	some action in resource.change.actions
	valid_actions[action]

	# Only enforce tagging on resources that expose tags.
	count(collect_resource_tags(resource)) > 0

	missing_tags := collect_missing_tags(resource)

	count(missing_tags) > 0

	res := sprintf(
		"Resource %s is missing required tags: %v.",
		[
			resource.address,
			missing_tags,
		],
	)
}


###############################################################################
# Invalid required tag values
###############################################################################

deny contains res if {
	some resource in input.resource_changes

	not ignored_resource_types[resource.type]

	some action in resource.change.actions
	valid_actions[action]

	invalid_tags := collect_invalid_tags(resource)

	count(invalid_tags) > 0

	res := sprintf(
		"Resource '%s' has invalid tag values: %v",
		[
			resource.address,
			invalid_tags,
		],
	)
}


###############################################################################
# Required tags with empty values
###############################################################################

deny contains res if {
	some resource in input.resource_changes

	not ignored_resource_types[resource.type]

	some action in resource.change.actions
	valid_actions[action]

	count(collect_resource_tags(resource)) > 0

	not tags_are_unknown(resource)

	resource_tags := collect_resource_tags(resource)

	empty_tags := [tag |
		some tag in all_required_tag_keys

		resource_tags[tag] == ""
	]

	count(empty_tags) > 0

	res := sprintf(
		"Resource '%s' has empty values for required tags: %v",
		[
			resource.address,
			empty_tags,
		],
	)
}


###############################################################################
# Helper function to get missing required tags
###############################################################################

collect_missing_tags(resource) := missing if {
	not tags_are_unknown(resource)

	resource_tags := collect_resource_tags(resource)

	missing := [tag |
		some tag in all_required_tag_keys

		not resource_tags[tag]
	]
}


###############################################################################
# Helper function to get invalid tag values
###############################################################################

collect_invalid_tags(resource) := invalid if {
	resource_tags := collect_resource_tags(resource)


	# Validate fixed-value required tags.
	invalid_static := [sprintf("%s=%s", [tag, value]) |
		some tag in object.keys(required_tags)

		value := resource_tags[tag]

		value != null
		value != ""

		not value in required_tags[tag]
	]


	# Project must exist in the dynamically loaded project list.
	invalid_project := [sprintf("Project=%s", [project]) |
		project := resource_tags["Project"]

		project != null
		project != ""

		data.tagging.projects

		not project in data.tagging.projects
	]


	# Environment must be valid for the selected Project.
	# Only validate Environment after Project itself has been confirmed valid.
	invalid_environment := [sprintf("Environment=%s", [environment]) |
		project := resource_tags["Project"]
		environment := resource_tags["Environment"]

		project != null
		project != ""

		environment != null
		environment != ""

		data.tagging.projects
		data.tagging.environments

		project in data.tagging.projects

		not valid_environment(project, environment)
	]


	invalid := array.flatten([
		invalid_static,
		invalid_project,
		invalid_environment,
	])
}


###############################################################################
# Helper function to validate Environment for Project
###############################################################################

# Standard Project/Environment validation comes directly from imac-config.
valid_environment(project, environment) if {
	project_environments := data.tagging.environments[project]

	environment in project_environments
}


# IMAC can additionally use a 12-digit AWS account ID as Environment.
valid_environment(project, environment) if {
	project == "imac"

	regex.match(
		aws_account_id_pattern,
		environment,
	)
}


###############################################################################
# Helper function to extract resource tags
###############################################################################

collect_resource_tags(resource) := tags if {
	tags := resource.change.after.tags_all
} else := tags if {
	tags := resource.change.after.tags
} else := tags if {
	# Fallback for resources such as Auto Scaling Groups that expose
	# tags as tag blocks instead of a normal tags map.
	tags := {t.key: t.value |
		some t in resource.change.after.tag

		t.key != null
	}
} else := {}


###############################################################################
# Helper function to detect unknown/computed tags
###############################################################################

tags_are_unknown(resource) if {
	resource.change.after_unknown.tags
}


tags_are_unknown(resource) if {
	resource.change.after_unknown.tags_all
}






