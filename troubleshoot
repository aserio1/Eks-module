resource "jenkins_job" "job" {
  name = var.job_name
  #folder = "/job/${var.folder_name}" #jenkins prefixes everything (including folders) with /job
  folder = var.folder_name != "" ? "/job/${replace(var.folder_name, "/", "/job/")}" : null

  template = templatefile("${path.module}/template/job_template.xml", {
    repo_owner               = local.repo_owner,
    repository               = local.repository,
    repo_url                 = var.repo,
    jenkinsfile              = var.jenkinsfile,
    pipeline_config          = var.pipeline_config,
    triggered_branches_regex = var.triggered_branches_regex,
    suppression_strategy     = var.suppression_strategy,
    discover_tags            = var.discover_tags,
    display_name             = coalesce(var.display_name, "")
  })
}


########### also 
module "jenkins_job" {
  source = "./modules/jenkins_job"

  for_each = {
    for p in local.pipelines : "${p.folder_name}-${p.job_name}" => p
  }

  folder_name              = each.value.folder_name
  job_name                 = each.value.job_name
  repo                     = each.value.repo
  jenkinsfile              = each.value.jenkinsfile
  pipeline_config          = each.value.pipeline_config
  suppression_strategy     = each.value.suppression_strategy
  triggered_branches_regex = each.value.triggered_branches_regex
  discover_tags            = each.value.discover_tags
  display_name             = try(each.value.display_name, null)

  # Wait until all folder created before proceeding with jenkins job
  depends_on = [
    module.jenkins_folder_top,
    module.jenkins_folder_child
  ]
}

