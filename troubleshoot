TOPIC_ARN="arn:aws:sns:us-east-1:213141505949:dev-utility-jenkins-alerts"

KMS_KEY=$(aws sns get-topic-attributes \
  --topic-arn "$TOPIC_ARN" \
  --region us-east-1 \
  --query 'Attributes.KmsMasterKeyId' \
  --output text)

echo "$KMS_KEY"


aws kms get-key-policy \
  --key-id "$KMS_KEY" \
  --policy-name default \
  --region us-east-1 \
  --query Policy \
  --output text | jq .


