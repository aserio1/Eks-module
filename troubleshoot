###############################################################################
# Project resolution tests
###############################################################################

test_dynamic_project_resolves if {
    project := resolved_project("sie")
        with data.tagging as mock_tagging

    project == "sie"
}


###############################################################################
# DWB legacy Project alias
#
# dwb -> data_workbench
###############################################################################

test_legacy_dwb_project_alias_allowed if {
    project := resolved_project("dwb")
        with data.tagging as mock_tagging

    project == "data_workbench"
}

test_legacy_dwb_environment_allowed if {
    project := resolved_project("dwb")
        with data.tagging as mock_tagging

    valid_environment(project, "dev")
        with data.tagging as mock_tagging
}

test_legacy_dwb_invalid_environment_denied if {
    project := resolved_project("dwb")
        with data.tagging as mock_tagging

    not valid_environment(project, "invalid-env")
        with data.tagging as mock_tagging
}


###############################################################################
# MLE legacy Project alias
#
# mle -> ml-engineering
###############################################################################

test_legacy_mle_project_alias_allowed if {
    project := resolved_project("mle")
        with data.tagging as mock_tagging

    project == "ml-engineering"
}

test_legacy_mle_environment_allowed if {
    project := resolved_project("mle")
        with data.tagging as mock_tagging

    valid_environment(project, "dev")
        with data.tagging as mock_tagging
}

test_legacy_mle_invalid_environment_denied if {
    project := resolved_project("mle")
        with data.tagging as mock_tagging

    not valid_environment(project, "invalid-env")
        with data.tagging as mock_tagging
}


###############################################################################
# ArcGIS legacy Project alias
#
# arcgis -> gis
#
# arcgis is intentionally NOT included in mock_tagging.projects.
# imac-config contains the canonical Project "gis".
###############################################################################

test_legacy_arcgis_project_alias_allowed if {
    project := resolved_project("arcgis")
        with data.tagging as mock_tagging

    project == "gis"
}

test_legacy_arcgis_environment_allowed if {
    project := resolved_project("arcgis")
        with data.tagging as mock_tagging

    valid_environment(project, "dev")
        with data.tagging as mock_tagging
}

test_legacy_arcgis_invalid_environment_denied if {
    project := resolved_project("arcgis")
        with data.tagging as mock_tagging

    not valid_environment(project, "invalid-env")
        with data.tagging as mock_tagging
}


###############################################################################
# Dynamic Environment tests
###############################################################################

test_valid_dynamic_environment if {
    valid_environment("sie", "dev")
        with data.tagging as mock_tagging
}

test_invalid_dynamic_environment if {
    not valid_environment("sie", "invalid-env")
        with data.tagging as mock_tagging
}


###############################################################################
# IMAC Environment tests
###############################################################################

# dev-imac-lza is defined in imac-config for IMAC.
test_valid_imac_lza_environment if {
    valid_environment("imac", "dev-imac-lza")
        with data.tagging as mock_tagging
}

# IMAC may use a 12-digit AWS account ID as Environment.
test_imac_account_id_environment_allowed if {
    valid_environment("imac", "123456789012")
        with data.tagging as mock_tagging
}

# Other Projects cannot use an AWS account ID as Environment unless that
# account ID is explicitly configured as one of their environments.
test_non_imac_account_id_environment_denied if {
    not valid_environment("sie", "123456789012")
        with data.tagging as mock_tagging
}


###############################################################################
# Invalid Project
###############################################################################

test_invalid_project_denied if {
    not resolved_project("not-a-project")
        with data.tagging as mock_tagging
}


###############################################################################
# Missing dynamic configuration
###############################################################################

test_missing_dynamic_tagging_data if {
    result := deny
        with input as {
            "resource_changes": [],
        }

    "tagging data was not provided to policy evaluation" in result
}


###############################################################################
# Empty dynamic configuration
###############################################################################

test_empty_dynamic_tagging_data if {
    result := deny
        with input as {
            "resource_changes": [],
        }
        with data.tagging as {}

    "tagging data is empty" in result
}


###############################################################################
# Missing Projects configuration
###############################################################################

test_missing_dynamic_projects_data if {
    result := deny
        with input as {
            "resource_changes": [],
        }
        with data.tagging as {
            "environments": {
                "imac": [
                    "dev",
                    "prod",
                ],
            },
        }

    "tagging projects data was not provided to policy evaluation" in result
}


###############################################################################
# Missing Environments configuration
###############################################################################

test_missing_dynamic_environments_data if {
    result := deny
        with input as {
            "resource_changes": [],
        }
        with data.tagging as {
            "projects": [
                "imac",
            ],
        }

    "tagging environments data was not provided to policy evaluation" in result
}


###############################################################################
# Full ArcGIS resource validation
#
# This verifies the complete policy path rather than testing only the helper.
###############################################################################

test_arcgis_resource_allowed if {
    result := deny
        with input as {
            "resource_changes": [
                {
                    "address": "aws_instance.arcgis_test",
                    "type": "aws_instance",
                    "change": {
                        "actions": [
                            "create",
                        ],
                        "after": {
                            "tags": {
                                "BusinessUnit": "cdo",
                                "FISMABoundary": "dsgss",
                                "ApplicationName": "arcgis",
                                "OwnerContact": "test@example.com",
                                "CreatedBy": "terraform",
                                "Project": "arcgis",
                                "Environment": "dev",
                            },
                        },
                    },
                },
            ],
        }
        with data.tagging as mock_tagging

    count(result) == 0
}


###############################################################################
# ArcGIS invalid Environment
#
# arcgis resolves to gis, so its Environment must exist under:
#
# data.tagging.environments["gis"]
###############################################################################

test_arcgis_resource_invalid_environment_denied if {
    result := deny
        with input as {
            "resource_changes": [
                {
                    "address": "aws_instance.arcgis_test",
                    "type": "aws_instance",
                    "change": {
                        "actions": [
                            "create",
                        ],
                        "after": {
                            "tags": {
                                "BusinessUnit": "cdo",
                                "FISMABoundary": "dsgss",
                                "ApplicationName": "arcgis",
                                "OwnerContact": "test@example.com",
                                "CreatedBy": "terraform",
                                "Project": "arcgis",
                                "Environment": "invalid-env",
                            },
                        },
                    },
                },
            ],
        }
        with data.tagging as mock_tagging

    some msg in result
    contains(msg, "Environment=invalid-env")
}
