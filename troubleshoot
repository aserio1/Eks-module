Groovy script 
######## deploy_infrastructure.groovy
void call(ev, profile=""){
  String terraformApplyScript = resource("terraform_apply.sh")
  
  if (ev instanceof String) {
      ev = jte.application_environments[ev]
  }

  def stage_name = ev.short_name
  //construct a special formatted stage name for imac deployment
  //for other projects, the profile would be empty
  if (profile != "" && jte.keywords.project == "imac") {
      stage_name = "profile: ${profile}, env: ${ev.short_name}"
  }

  node(jte.keywords.project) {
    
    ws("workspace/${env.JOB_NAME.replace('%2F','/')}/$BUILD_NUMBER") {
      stage("Terraform Apply: ${stage_name}"){
        if (env.BRANCH_NAME =~ ev.deployment_branch) {
          dir("infrastructure/terraform") {
            def aws_profile = ev.short_name
            if (profile != "" && jte.keywords.project == "imac") {
              aws_profile = profile
            }
            
            withEnv([
              "AWS_PROFILE=${aws_profile}"
            ]) {
                  println "Deploying to ${aws_profile} for branch ${env.BRANCH_NAME}."

                  sh(
                    label: '[Deploy Infastructure]',
                    script: terraformApplyScript
                  )
            }
          }
        } else {
          println "Skipping deployment to ${ev.short_name} for branch ${env.BRANCH_NAME}."
        }
      }
    }
  }
}

############### terraform_apply.sh

echo "Running terraform apply..."

terraform apply -no-color -auto-approve ${AWS_PROFILE}.tfplan
