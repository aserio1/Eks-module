def call() {
  node(jte.keywords.project) {
    def isScannerAgent = env.NODE_NAME?.contains('sia') ?: false

    def envVars = isScannerAgent ? [] : ["AWS_PROFILE=dev"]

    withEnv(envVars) {
      def command = "aws dynamodb get-item --table-name dev-ImacConfigTable --key '{\"Name\": {\"S\":\"IMAC_CONFIG\"}}' --region us-east-1 || true"
      
      def output = sh(returnStdout: true, script: "#!/bin/sh -e\n" + command)
      
      def dbItem = readJSON(text: output)

      def configStr =  dbItem["Item"]["CONFIG_JSON"]["S"]

      configStr = configStr.replaceAll("\\\\\\\"","\\\"")
      configStr = configStr[1..-2]
      
      return readJSON(text: configStr)
    }
  }
}
