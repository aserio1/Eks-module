#!/usr/bin/env bash

set -e

if ! command -v ~/anaconda3/bin/conda &> /dev/null
then
    wget https://repo.anaconda.com/archive/Anaconda3-2024.06-1-Linux-x86_64.sh
    bash Anaconda3-2024.06-1-Linux-x86_64.sh -b -u
fi

BASE_ENV_NAME="$ENV_NAME"

if [[ -n "${BUILD_TAG:-}" ]]
then
    SAFE_BUILD_TAG=$(echo "$BUILD_TAG" | tr -c '[:alnum:]_-' '-')
    ENV_NAME="${BASE_ENV_NAME}-${SAFE_BUILD_TAG}"
elif [[ -n "${BUILD_NUMBER:-}" ]]
then
    ENV_NAME="${BASE_ENV_NAME}-${BUILD_NUMBER}"
else
    ENV_NAME="${BASE_ENV_NAME}-$$"
fi

echo "Creating isolated Conda environment: $ENV_NAME"

~/anaconda3/bin/conda create \
    -y \
    --name "$ENV_NAME" \
    python="$PYTHON_VERSION"

cleanup()
{
    echo "Removing isolated Conda environment: $ENV_NAME"

    set +e
    source ~/anaconda3/bin/deactivate
    ~/anaconda3/bin/conda env remove --name "$ENV_NAME" --yes
    set -e
}

trap cleanup EXIT

echo "Activating Conda environment: $ENV_NAME"

set +x
source ~/anaconda3/bin/activate "$ENV_NAME"
set -x

python --version
python -m pip --version

for req_file in $REQUIREMENTS
do
    matches=$(find . -type f -iname "$req_file")

    if [[ -n "$matches" ]]
    then
        while IFS= read -r requirements_file
        do
            echo "Installing requirements from $requirements_file"

            python -m pip install \
                -i "https://repo.platform.aws.hhsoig.gov/repository/$REPO_NAME/simple" \
                --trusted-host repo.platform.aws.hhsoig.gov \
                --no-color \
                -r "$requirements_file"

        done <<< "$matches"
    else
        echo "No matching requirements file found for: $req_file"
    fi
done


##########################################
Instead, the environment gets a unique name for every Jenkins build. For example:
Each build starts with:

conda create --name "$ENV_NAME" python="$PYTHON_VERSION"
This provides a clean Python environment with no packages left behind by previous repositories or builds.

At the end of the build, this cleanup runs automatically:

trap cleanup EXIT
