import requests
import os
import sys
import boto3
import json
import csv
from requests.auth import HTTPBasicAuth
from botocore.exceptions import ClientError

# Parameters
JENKINS_ENV = sys.argv[1].strip()
JENKINS_URL = "https://jenkins.aws.hhsoig.gov/"
USERNAME = "SVC-Jenkins-Agent"

# Output Files
# These are relative paths, so Jenkins creates them in the current workspace.
LIVE_JOBS_FILE = "live_jenkins_jobs.txt"
MANAGED_JOBS_FILE = "managed_jenkins_jobs.txt"
NONCOMPLIANT_JOBS_FILE = "noncompliant_jenkins_jobs.txt"
PIPELINE_CATALOG_FILE = "jenkins_pipeline_catalog.csv"


# Retrieves the username and token from AWS Secrets
def get_secret(secret_name, region_name="us-east-1"):
    """
    Retrieve a secret from AWS Secrets Manager.

    :param secret_name: The name of the secret.
    :param region_name: The AWS region where the secret is stored.
    :return: The secret value as a string, or None if error occurs.
    """

    client = boto3.client("secretsmanager", region_name=region_name)

    try:
        response = client.get_secret_value(SecretId=secret_name)

        if "SecretString" in response:
            secret = response["SecretString"]
        else:
            secret = response["SecretBinary"].decode("utf-8")

        return secret

    except ClientError as e:
        print(f"Error retrieving secret: {e}")
        return None


# Fetch the live jobs from Jenkins
def fetch_live_jobs(api_url, prefix=""):
    # Fetch latest token every time until token refresh is complete
    api_token = get_secret(
        JENKINS_ENV + "-svc-jenkins-agent-token",
        "us-east-1"
    )

    if not api_token:
        raise RuntimeError("Unable to retrieve Jenkins API token.")

    response = requests.get(
        api_url,
        verify=False,
        auth=HTTPBasicAuth(USERNAME, api_token)
    )

    response.raise_for_status()
    data = response.json()

    jobs = []

    for job in data.get("jobs", []):
        job_name = job["name"]
        full_path = f"{prefix}/{job_name}" if prefix else job_name
        job_class = job.get("_class", "")

        # Skip if it is a branch inside a multibranch pipeline.
        # Do not skip if it is a regular pipeline inside a folder.
        if (
            prefix
            and "/job/" in prefix
            and "/job/" in job.get("url", "")
            and job["url"].count("/job/") > prefix.count("job/")
        ):
            if job_class == "org.jenkinsci.plugins.workflow.job.WorkflowJob":
                continue

        # If it's a folder or multibranch pipeline with nested jobs, recurse
        if job_class in [
            "com.cloudbees.hudson.plugins.folder.Folder",
            "org.jenkinsci.plugins.workflow.multibranch.WorkflowMultiBranchProject"
        ]:
            nested_api_url = job["url"] + "api/json"
            jobs += fetch_live_jobs(
                nested_api_url,
                prefix=full_path
            )

        # Only include real jobs, not folders
        if job_class not in [
            "com.cloudbees.hudson.plugins.folder.Folder"
        ]:
            jobs.append(full_path)

    return jobs


# Fetch the codified jobs from project JSONs
def gather_jobs_from_jsons():
    managed_jobs = set()

    script_dir = os.path.dirname(os.path.abspath(__file__))
    jobs_dir = os.path.join(script_dir, "..", "jobs")

    if not os.path.isdir(jobs_dir):
        print(f"Jobs directory not found at: {jobs_dir}")
        return managed_jobs

    for filename in os.listdir(jobs_dir):
        if filename.endswith(".json"):
            filepath = os.path.join(jobs_dir, filename)

            try:
                with open(filepath) as f:
                    data = json.load(f)

                    for folder in data.get("folders", []):
                        folder_name = folder.get("name", "").strip()

                        # Pipelines directly under the folder
                        for pipe in folder.get("pipelines", []):
                            pipe_name = pipe.get("name", "").strip()

                            if folder_name and pipe_name:
                                managed_jobs.add(
                                    f"{folder_name}/{pipe_name}"
                                )

                        # Pipelines under subfolders
                        for subfolder in folder.get("subfolders", []):
                            subfolder_name = subfolder.get(
                                "name", ""
                            ).strip()

                            for pipe in subfolder.get("pipelines", []):
                                pipe_name = pipe.get("name", "").strip()

                                if (
                                    folder_name
                                    and subfolder_name
                                    and pipe_name
                                ):
                                    managed_jobs.add(
                                        f"{folder_name}/"
                                        f"{subfolder_name}/"
                                        f"{pipe_name}"
                                    )

            except json.JSONDecodeError as e:
                print(
                    f"Error parsing {filename}: {e}",
                    file=sys.stderr
                )

    return managed_jobs


# Write list to file system
def write_list_to_file(items, filepath):
    with open(filepath, "w") as f:
        for item in sorted(items):
            f.write(item + "\n")


# Generate CSV catalog of Jenkins pipelines by project
def write_pipeline_catalog(all_jobs, managed_jobs, filepath):
    """
    Generate a CSV catalog containing all live Jenkins pipelines.

    Project:
        Top-level Jenkins folder.

    Pipeline:
        Pipeline/job name.

    Full Path:
        Complete Jenkins folder/job path.

    Compliance Status:
        Managed     = job exists in project JSON definitions.
        Non-Compliant = live Jenkins job is not defined in project JSONs.
    """

    managed_jobs_set = set(managed_jobs)

    with open(filepath, "w", newline="", encoding="utf-8") as csvfile:
        writer = csv.writer(csvfile)

        writer.writerow([
            "Project",
            "Pipeline",
            "Full Path",
            "Compliance Status"
        ])

        for job in sorted(set(all_jobs)):
            parts = job.split("/")

            project = parts[0] if parts else ""
            pipeline = parts[-1] if parts else job

            if job in managed_jobs_set:
                compliance_status = "Managed"
            else:
                compliance_status = "Non-Compliant"

            writer.writerow([
                project,
                pipeline,
                job,
                compliance_status
            ])

    print(f"Pipeline catalog generated: {filepath}")


# Main function calling the other functions
# to perform the comparison audit action
def main():

    print("======================================")
    print("Jenkins Jobs Audit")
    print("======================================")

    # Fetch all live Jenkins jobs
    all_jobs = fetch_live_jobs(
        f"{JENKINS_URL}/api/json"
    )

    write_list_to_file(
        all_jobs,
        LIVE_JOBS_FILE
    )

    # Get managed Jenkins jobs
    managed_jobs = gather_jobs_from_jsons()

    write_list_to_file(
        managed_jobs,
        MANAGED_JOBS_FILE
    )

    # Determine non-compliant jobs
    non_compliant_jobs = sorted(
        set(all_jobs) - managed_jobs
    )

    write_list_to_file(
        non_compliant_jobs,
        NONCOMPLIANT_JOBS_FILE
    )

    # Generate Jenkins pipeline CSV catalog
    write_pipeline_catalog(
        all_jobs,
        managed_jobs,
        PIPELINE_CATALOG_FILE
    )

    print("")
    print("======================================")
    print("Audit Summary")
    print("======================================")

    print(f"Total live jobs fetched: {len(all_jobs)}")
    print(f"Written to: {LIVE_JOBS_FILE}")

    print(f"Total managed jobs: {len(managed_jobs)}")
    print(f"Written to: {MANAGED_JOBS_FILE}")

    print(f"CSV catalog written to: {PIPELINE_CATALOG_FILE}")

    if non_compliant_jobs:
        print(
            f"Total Non-compliant Jenkins jobs found: "
            f"{len(non_compliant_jobs)}"
        )

        print(
            f"Written to: {NONCOMPLIANT_JOBS_FILE}"
        )

        for job in non_compliant_jobs:
            print(f" - {job}")

    else:
        print("")
        print(
            "All Jenkins jobs are compliant per managed jobs "
            "defined in project JSONs."
        )


if __name__ == "__main__":
    main()
