data "aws_ami" "centos_stig_ami" {
  most_recent = true

  owners = [
    var.al2023_ami_owner_account_id
  ]

  filter {
    name = "name"

    values = [
      var.al2023_ami_name_pattern
    ]
  }

  filter {
    name = "state"

    values = [
      "available"
    ]
  }

  filter {
    name = "architecture"

    values = [
      "x86_64"
    ]
  }

  filter {
    name = "root-device-type"

    values = [
      "ebs"
    ]
  }

  filter {
    name = "virtualization-type"

    values = [
      "hvm"
    ]
  }
}


################## variables


variable "al2023_ami_owner_account_id" {
  type        = string
  description = "AWS account ID that owns and shares the approved AL2023 AMIs."
}

variable "al2023_ami_name_pattern" {
  type        = string
  description = "Name pattern used to identify approved AL2023 AMIs."
}

##################### dev.tfvars 
al2023_ami_owner_account_id = "123456789012"
al2023_ami_name_pattern     = "DWB-AL2023-*"



