package cdo.terraform.required_default_tagging_test

import data.cdo.terraform.required_default_tagging as check

# Test missing and invalid tags
test_deny_resource_has_required_tags if {
	res := check.deny with input as {
		"format_version": "1.2",
		"terraform_version": "1.13.0",
		"resource_changes": [{
			"address": "module.emr_serverless_runtime_role.aws_iam_policy.emr_serverless_execution_custom_policy",
			"module_address": "module.emr_serverless_runtime_role",
			"mode": "managed",
			"type": "aws_iam_policy",
			"name": "emr_serverless_execution_custom_policy",
			"provider_name": "registry.terraform.io/hashicorp/aws",
			"change": {
				"actions": ["create"],
				"after": {
					"tags": {},
					"tags_all": {
						"ApplicationName": "SageMaker Studio Base",
						"CreatedBy": "terraform",
						"Environment": "dev",
						"Opt_in": "n",
						"Owner": "Katie Rose",
						"Project": "IMAC-IDES",
						"ResponsibleGroup": "cdo",
						"Service": "sagemaker-studio",
						"Version": "1.0.0",
					},
				},
			},
		}],
	}

	# Missing: BusinessUnit, FISMABoundary, OwnerContact → 1 deny
	# Invalid: Project="IMAC-IDES" → 1 deny
	# Total: 2
	count(res) == 2
}

