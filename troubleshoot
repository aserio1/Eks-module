
name: IMAC Configuration Pipeline

############################################################
# Trigger on commits to main or feature branch
############################################################

on:
  push:
    branches:
      - main
      - feature-IMAC-1262

  workflow_dispatch:
    inputs:
      environment:
        description: "IMAC deployment environment"
        required: true
        type: choice
        default: dev
        options:
          - dev
          - prod
          - dev-imac-lza
          - test-imac-lza
          - prod-imac-lza

############################################################
# Prevent Concurrent Builds
############################################################

concurrency:
  group: imac-config-${{ github.ref }}
  cancel-in-progress: false

############################################################
# IMAC Configuration
############################################################

env:
  PROJECT: imac
  ENV_SHORT_NAME: ${{ inputs.environment || 'dev' }}
  IMAC_CONFIG_FILE: src/project/imac.json
  WORKING_DIRECTORY: infrastructure/terraform

jobs:

  imac-config:

    name: IMAC Configuration Pipeline

    runs-on: [self-hosted, imac]

    permissions:
      contents: read

    steps:

      ##########################################################
      # 1. Runner Identity
      ##########################################################

      - name: Runner Identity
        shell: bash
        run: |
          set -euo pipefail

          echo "======================================"
          echo "IMAC GitHub Actions Runner"
          echo "======================================"

          echo "Hostname:   $(hostname)"
          echo "User:       $(whoami)"
          echo "Runner OS:  $RUNNER_OS"
          echo "Runner name: $RUNNER_NAME"

      ##########################################################
      # 2. Verify Tools
      ##########################################################

      - name: Tool Versions
        shell: bash
        run: |
          set -euo pipefail

          echo "=== AWS CLI ==="
          aws --version

          echo "=== Terraform ==="
          terraform version

          echo "=== Docker CLI ==="
          docker --version

          echo "=== Git ==="
          git --version

          echo "=== Node ==="
          node -v

          echo "=== Python ==="
          python3 --version

          echo "=== jq ==="
          jq --version

          echo "=== yq ==="
          yq --version

          echo "=== OPA ==="
          opa version

          echo "=== Regal ==="
          regal version

          echo "=== tflint ==="
          tflint --version

          echo "=== Trivy ==="
          trivy --version

          echo "=== sonar-scanner ==="
          sonar-scanner --version

          echo "=== Nuclei ==="
          nuclei --version

          echo "=== OpenGrep ==="
          opengrep-core -version

      ##########################################################
      # 3. Verify Default AWS Identity
      ##########################################################

      - name: Verify AWS Identity
        shell: bash
        run: |
          set -euo pipefail

          echo "======================================"
          echo "AWS Runner Identity"
          echo "======================================"

          # Verify the runner's existing EC2 instance role.
          # No AWS_ACCOUNT_ID is required at this stage.

          aws sts get-caller-identity

          echo "======================================"
          echo "Available AWS Profiles"
          echo "======================================"

          aws configure list-profiles

          echo "AWS identity verification completed."

      ##########################################################
      # 4. Git Checkout
      ##########################################################

      - name: Checkout IMAC Config
        uses: actions/checkout@v4

      ##########################################################
      # 5. Resolve AWS Account from imac.json
      ##########################################################

      - name: Resolve AWS Account
        id: account
        shell: bash
        run: |
          set -euo pipefail

          echo "======================================"
          echo "Resolving IMAC AWS Account"
          echo "======================================"

          if [[ ! -f "$IMAC_CONFIG_FILE" ]]; then
            echo "ERROR: IMAC configuration file not found:"
            echo "$IMAC_CONFIG_FILE"
            exit 1
          fi

          ACCOUNT_REF=$(
            jq -er \
              --arg env "$ENV_SHORT_NAME" \
              '.environments[$env].account' \
              "$IMAC_CONFIG_FILE"
          )

          AWS_ACCOUNT_ID=$(
            echo "$ACCOUNT_REF" |
            sed -nE 's|^ref:/account/([0-9]{12})\.json$|\1|p'
          )

          if [[ -z "$AWS_ACCOUNT_ID" ]]; then
            echo "ERROR: Unable to resolve AWS account."
            echo "Environment: $ENV_SHORT_NAME"
            echo "Account reference: $ACCOUNT_REF"
            exit 1
          fi

          echo "Project: $PROJECT"
          echo "Environment: $ENV_SHORT_NAME"
          echo "AWS Account: $AWS_ACCOUNT_ID"

          echo "aws_account_id=$AWS_ACCOUNT_ID" >> "$GITHUB_OUTPUT"
          echo "AWS_ACCOUNT_ID=$AWS_ACCOUNT_ID" >> "$GITHUB_ENV"

      ##########################################################
      # 6. Verify Target AWS Account
      ##########################################################

      - name: Verify Target AWS Account
        id: aws-auth
        shell: bash
        run: |
          set -euo pipefail

          echo "======================================"
          echo "Verifying Target AWS Account"
          echo "======================================"

          echo "Environment: $ENV_SHORT_NAME"
          echo "Expected Account: $AWS_ACCOUNT_ID"

          # Prefer the environment-specific profile.
          # Example: dev, prod, dev-imac-lza.

          if aws configure list-profiles |
             grep -Fxq "$ENV_SHORT_NAME"; then

            AWS_PROFILE="$ENV_SHORT_NAME"

          elif aws configure list-profiles |
               grep -Fxq "$AWS_ACCOUNT_ID"; then

            AWS_PROFILE="$AWS_ACCOUNT_ID"

          else

            echo "ERROR: No matching AWS profile found."
            echo "Environment: $ENV_SHORT_NAME"
            echo "Account: $AWS_ACCOUNT_ID"
            exit 1

          fi

          echo "Selected AWS Profile: $AWS_PROFILE"

          ACTUAL_ACCOUNT=$(
            aws sts get-caller-identity \
              --profile "$AWS_PROFILE" \
              --query Account \
              --output text
          )

          echo "Expected Account: $AWS_ACCOUNT_ID"
          echo "Actual Account:   $ACTUAL_ACCOUNT"

          if [[ "$ACTUAL_ACCOUNT" != "$AWS_ACCOUNT_ID" ]]; then
            echo "ERROR: AWS account mismatch."
            exit 1
          fi

          # Make the selected profile available to later run steps.

          echo "AWS_PROFILE=$AWS_PROFILE" >> "$GITHUB_ENV"

          # Make both profile and account available as step outputs.

          echo "aws_profile=$AWS_PROFILE" >> "$GITHUB_OUTPUT"
          echo "aws_account_id=$AWS_ACCOUNT_ID" >> "$GITHUB_OUTPUT"

          echo "AWS authentication successful."

      ##########################################################
      # 7. Verify Terraform Account Profile
      ##########################################################

      - name: Verify Terraform AWS Profile
        shell: bash
        run: |
          set -euo pipefail

          echo "======================================"
          echo "Terraform AWS Account Profile"
          echo "======================================"

          # Match the account-number profile used by the
          # existing working Run Terraform Plan workflow.

          if ! aws configure list-profiles |
               grep -Fxq "$AWS_ACCOUNT_ID"; then

            echo "ERROR: Terraform account profile not found."
            echo "Required profile: $AWS_ACCOUNT_ID"
            exit 1

          fi

          ACTUAL_ACCOUNT=$(
            aws sts get-caller-identity \
              --profile "$AWS_ACCOUNT_ID" \
              --query Account \
              --output text
          )

          echo "Terraform Profile: $AWS_ACCOUNT_ID"
          echo "Actual Account:    $ACTUAL_ACCOUNT"

          if [[ "$ACTUAL_ACCOUNT" != "$AWS_ACCOUNT_ID" ]]; then
            echo "ERROR: Terraform profile account mismatch."
            exit 1
          fi

          echo "Terraform AWS profile verified."

      ##########################################################
      # 8. Scan Dependencies
      ##########################################################

      - name: Scan Dependencies
        shell: bash
        run: |
          set -euo pipefail

          echo "[IMAC] Starting dependency scan..."

          # TODO:
          # Migrate Jenkins scan_dependencies().

          echo "ERROR: Dependency scan not yet implemented."
          exit 1

      ##########################################################
      # 9. Lint Infrastructure
      ##########################################################

      - name: Lint Infrastructure
        shell: bash
        working-directory: ${{ env.WORKING_DIRECTORY }}
        run: |
          set -euo pipefail

          echo "[IMAC] Starting infrastructure linting..."

          terraform fmt -check -recursive

          terraform init -backend=false

          terraform validate

          echo "[IMAC] Terraform validation completed."

      ##########################################################
      # 10. Scan Infrastructure
      ##########################################################

      - name: Scan Infrastructure
        shell: bash
        run: |
          set -euo pipefail

          echo "[IMAC] Starting infrastructure scan..."

          # TODO:
          # Migrate Jenkins scan_infrastructure(true).

          echo "ERROR: Infrastructure scan not yet implemented."
          exit 1

      ##########################################################
      # 11. Terraform Plan
      ##########################################################

      - name: Terraform Plan DEV
        id: terraform-plan
        uses: CDO/imac-shared-gh-actions/terraform/plan@v1
        with:
          project: ${{ env.PROJECT }}
          env_short_name: ${{ env.ENV_SHORT_NAME }}
          working_directory: ${{ env.WORKING_DIRECTORY }}

          # Same account-number profile convention as
          # the existing working Run Terraform Plan workflow.

          aws_profile_override: ${{ steps.account.outputs.aws_account_id }}

      ##########################################################
      # 12. Terraform Deploy
      ##########################################################

      - name: Terraform Deploy DEV
        shell: bash
        working-directory: ${{ env.WORKING_DIRECTORY }}
        env:
          AWS_PROFILE: ${{ steps.terraform-plan.outputs.aws_profile }}
          PLAN_FILE: ${{ steps.terraform-plan.outputs.plan_file }}
        run: |
          set -euo pipefail

          echo "[IMAC] Starting deployment..."

          echo "Environment: $ENV_SHORT_NAME"
          echo "AWS Account: $AWS_ACCOUNT_ID"
          echo "AWS Profile: $AWS_PROFILE"

          if [[ -z "${PLAN_FILE:-}" || ! -f "$PLAN_FILE" ]]; then
            echo "ERROR: Terraform plan not found."
            exit 1
          fi

          terraform apply \
            -input=false \
            "$PLAN_FILE"

          echo "[IMAC] Deployment completed."

      ##########################################################
      # 13. Compile IMAC Configuration
      ##########################################################

      - name: Compile IMAC Configuration
        shell: bash
        run: |
          set -euo pipefail

          echo "[IMAC] Starting configuration compilation..."

          # TODO:
          # Migrate Jenkins compile_config().

          echo "ERROR: Configuration compilation not yet implemented."
          exit 1
