name: IMAC Configuration Pipeline

on:
  workflow_dispatch:

  push:
    branches:
      - main
      - feature1-IMAC-1261

jobs:
  imac-config:
    runs-on: [self-hosted, imac]

    steps:
      ########################################################################
      # 1. Runner Identity
      ########################################################################
      - name: Runner identity
        run: |
          echo "Hostname:      $(hostnamectl hostname)"
          echo "User:          $(whoami)"
          echo "Runner OS:     $RUNNER_OS"
          echo "Runner name:   $RUNNER_NAME"
          echo "Runner labels: $RUNNER_LABELS"

      ########################################################################
      # 2. Tool Versions
      ########################################################################
      - name: Tool versions
        run: |
          echo "=== AWS CLI ===" && aws --version
          echo "=== Terraform ===" && terraform version
          echo "=== Docker CLI ===" && docker --version
          echo "=== Git ===" && git --version
          echo "=== Node ===" && node -v
          echo "=== Python ===" && python3 --version
          echo "=== jq ===" && jq --version
          echo "=== yq ===" && yq --version
          echo "=== OPA ===" && opa version
          echo "=== Regal ===" && regal version
          echo "=== tflint ===" && tflint --version
          echo "=== Trivy ===" && trivy --version
          echo "=== sonar-scanner ===" && sonar-scanner --version
          echo "=== Nuclei ===" && nuclei --version
          echo "=== OpenGrep ===" && opengrep-core -version

      ########################################################################
      # 3. AWS Identity
      ########################################################################
      - name: AWS identity
        run: |
          aws sts get-caller-identity

      ########################################################################
      # 4. AWS Profiles
      ########################################################################
      - name: AWS profiles
        run: |
          echo "=== ~/.aws/config ==="
          cat ~/.aws/config

          echo "=== Profile list ==="
          aws configure list-profiles

      ########################################################################
      # 5. Verify AWS Profile Role Assumption
      ########################################################################
      - name: AWS profile role assumption
        run: |
          for profile in $(aws configure list-profiles); do
            echo "Testing profile: $profile"

            aws sts get-caller-identity \
              --profile "$profile" \
              && echo "OK" \
              || echo "FAILED"
          done

      ########################################################################
      # 6. Checkout IMAC Config
      ########################################################################
      - name: Checkout IMAC Config
        uses: actions/checkout@v4

      ########################################################################
      # 7. Scan Dependencies
      ########################################################################
      - name: Scan Dependencies
        shell: bash
        env:
          PROJECT: imac
          ENV_NAME: python314
        run: |
          set -euo pipefail

          echo "======================================"
          echo "[IMAC] Starting dependency scan..."
          echo "======================================"

          ####################################################################
          # Trivy Configuration
          ####################################################################

          TRIVY_REPO=imac-policies
          TRIVY_BRANCH=main
          TRIVY_SERVER="http://trivy-server:4954"
          TRIVY_CACHE_BACKEND="redis://redis-container:6379"
          IGNORE_FILE=".trivyignore.yaml"

          ####################################################################
          # Prepare Trivy Ignore Directory
          ####################################################################

          if [[ ! -d "trivy-ignores" ]]; then
            mkdir trivy-ignores
          fi

          ####################################################################
          # Prefer Fix Branch If Available
          ####################################################################

          FIX_BRANCH="fix/correct-trivy-ignore-sections"

          if curl -kfsL \
            --output /dev/null \
            "https://raw.git.aws.hhsoig.gov/CDO/${TRIVY_REPO}/${FIX_BRANCH}/trivy-ignores/global.yaml"; then

            TRIVY_BRANCH="${FIX_BRANCH}"

            echo "Using branch ${TRIVY_BRANCH} for trivy-ignores."

          else

            echo "Branch ${FIX_BRANCH} not found."
            echo "Falling back to ${TRIVY_BRANCH}."

          fi

          ####################################################################
          # Download Trivy Ignore Files
          ####################################################################

          set +e

          curl -kfLO \
            --output-dir ./trivy-ignores \
            "https://raw.git.aws.hhsoig.gov/CDO/${TRIVY_REPO}/${TRIVY_BRANCH}/trivy-ignores/global.yaml"

          if [[ "$?" -ne 0 ]]; then
            echo "No global.yaml found in ${TRIVY_REPO}."
          fi

          curl -kfLO \
            --output-dir ./trivy-ignores \
            "https://raw.git.aws.hhsoig.gov/CDO/${TRIVY_REPO}/${TRIVY_BRANCH}/trivy-ignores/${PROJECT}.yaml"

          if [[ "$?" -ne 0 ]]; then
            echo "No ${PROJECT}.yaml found in ${TRIVY_REPO}."
          fi

          set -e

          ####################################################################
          # Merge Ignore Files
          ####################################################################

          if [[ -f "trivy-ignores/${PROJECT}.yaml" ]]; then

            yq eval-all \
              'select(fileIndex == 0) *+ select(fileIndex == 1)' \
              trivy-ignores/global.yaml \
              "trivy-ignores/${PROJECT}.yaml" \
              > "${IGNORE_FILE}"

          else

            cp trivy-ignores/global.yaml "${IGNORE_FILE}"

          fi

          echo "Trivy ignore configuration prepared."

          ####################################################################
          # Find Requirements Files
          ####################################################################

          requirements_files=$(
            find . \
              -type f \
              -iname 'requirements*.txt' \
              ! -iname 'requirements-dev.txt' \
              ! -path '*/scan/*'
          )

          ####################################################################
          # Activate Conda
          ####################################################################

          if command -v "$HOME/anaconda3/bin/conda" &> /dev/null; then

            echo "Activating Conda ${ENV_NAME}"

            set +x
            source "$HOME/anaconda3/bin/activate" "$ENV_NAME"
            set -x

          else

            echo "Conda not found. Using current Python environment."

          fi

          ####################################################################
          # Install pip-tools
          ####################################################################

          python -m pip install \
            -i "https://repo.platform.aws.hhsoig.gov/repository/pypi-all/simple" \
            --trusted-host repo.platform.aws.hhsoig.gov \
            pip-tools

          ####################################################################
          # Scan Requirements
          ####################################################################

          if [[ -z "${requirements_files}" ]]; then

            echo "No requirements files found."

          else

            for requirement_file in $requirements_files
            do

              echo "======================================"
              echo "Processing ${requirement_file}"
              echo "======================================"

              scandir="$(dirname "$requirement_file")/scan"
              scanfile="${scandir}/requirements.txt"

              mkdir -p "$scandir"

              cp "$requirement_file" \
                "${scandir}/requirements.in"

              ################################################################
              # Compile Dependencies
              ################################################################

              echo "Compiling dependencies..."

              python -m piptools compile \
                "${scandir}/requirements.in" \
                -o "$scanfile" \
                -i "https://repo.platform.aws.hhsoig.gov/repository/pypi-all/simple" \
                --trusted-host repo.platform.aws.hhsoig.gov \
                --strip-extras

              ################################################################
              # Scan CRITICAL/HIGH
              ################################################################

              echo "Scanning ${scanfile} for CRITICAL,HIGH issues..."

              trivy fs \
                --ignorefile "./${IGNORE_FILE}" \
                --server "${TRIVY_SERVER}" \
                --cache-backend "${TRIVY_CACHE_BACKEND}" \
                --timeout 30m \
                --scanners vuln \
                --format table \
                --severity CRITICAL,HIGH \
                --exit-code 1 \
                "$scanfile"

              ################################################################
              # Scan MEDIUM/LOW On Main
              ################################################################

              if [[ "$GITHUB_REF_NAME" == "main" ]]; then

                echo "Scanning ${scanfile} for MEDIUM,LOW issues..."

                trivy fs \
                  --ignorefile "./${IGNORE_FILE}" \
                  --server "${TRIVY_SERVER}" \
                  --cache-backend "${TRIVY_CACHE_BACKEND}" \
                  --timeout 30m \
                  --scanners vuln \
                  --format table \
                  --severity MEDIUM,LOW \
                  --exit-code 0 \
                  "$scanfile"

              fi

              ################################################################
              # Cleanup
              ################################################################

              rm -rf "$scandir"

            done

          fi

          echo "======================================"
          echo "[IMAC] Dependency Scan Completed"
          echo "======================================"

      ########################################################################
      # 8. Lint Python Code
      ########################################################################
      - name: Lint Python Code
        shell: bash
        env:
          PYTHON_VERSION: "3.14"
          LINT_TOOL: "Flake8"
          BLOCKING: "true"
        run: |
          set -euo pipefail

          echo "======================================"
          echo "IMAC Static Code Analysis: Python"
          echo "======================================"

          ENV_NAME="python${PYTHON_VERSION//./}"

          echo "Python Version:    ${PYTHON_VERSION}"
          echo "Conda Environment: ${ENV_NAME}"
          echo "Lint Tool:         ${LINT_TOOL}"
          echo "Blocking:          ${BLOCKING}"

          ####################################################################
          # Install Anaconda If Missing
          ####################################################################

          if [[ ! -x "$HOME/anaconda3/bin/conda" ]]; then

            echo "Anaconda not found."
            echo "Installing Anaconda..."

            wget \
              https://repo.anaconda.com/archive/Anaconda3-2024.06-1-Linux-x86_64.sh

            bash \
              Anaconda3-2024.06-1-Linux-x86_64.sh \
              -b \
              -u

          else

            echo "Anaconda is already installed."

          fi

          ####################################################################
          # Create Conda Environment If Missing
          ####################################################################

          if ! "$HOME/anaconda3/bin/conda" env list --json |
            jq -e \
              --arg env "$ENV_NAME" \
              '[.envs[] | split("/")[-1] == $env] | any' \
              > /dev/null; then

            echo "Creating ${ENV_NAME} with Python ${PYTHON_VERSION}..."

            "$HOME/anaconda3/bin/conda" create \
              -y \
              --name "$ENV_NAME" \
              "python=${PYTHON_VERSION}"

          else

            echo "Conda environment ${ENV_NAME} already exists."

          fi

          ####################################################################
          # Activate Conda
          ####################################################################

          echo "Activating Conda ${ENV_NAME}"

          set +x
          source "$HOME/anaconda3/bin/activate" "$ENV_NAME"
          set -x

          echo "======================================"
          echo "Python Environment"
          echo "======================================"

          python --version

          ####################################################################
          # Lint Function
          ####################################################################

          run_lint() {

            ##################################################################
            # Black + Mypy
            ##################################################################

            if [[ "$LINT_TOOL" == "black" ]]; then

              echo "======================================"
              echo "Running Black and Mypy"
              echo "======================================"

              python -m black --version

              python -m black \
                --check . \
                --extend-exclude=archive/,Archive/,archived/,Archived/

              python -m mypy \
                . \
                --exclude archive/ \
                --exclude Archive/ \
                --exclude archived/ \
                --exclude Archived/

            ##################################################################
            # Flake8
            ##################################################################

            elif [[ "$LINT_TOOL" == "Flake8" ]]; then

              echo "======================================"
              echo "Running Flake8"
              echo "======================================"

              python -m flake8 --version

              python -m flake8 \
                --extend-exclude=archive/,Archive/,archived/,Archived/ \
                --extend-ignore=E302,W293,E501,E231,E202

            else

              echo "ERROR: Unsupported lint tool: ${LINT_TOOL}"
              return 1

            fi
          }

          ####################################################################
          # Blocking / Non-Blocking
          ####################################################################

          if [[ "$BLOCKING" == "true" ]]; then

            echo "Running ${LINT_TOOL} in blocking mode."

            run_lint

          else

            echo "Running ${LINT_TOOL} in non-blocking mode."

            if ! run_lint; then
              echo "WARNING: Python static code analysis failed."
              echo "Pipeline will continue because BLOCKING=false."
            fi

          fi

          echo "======================================"
          echo "IMAC Python Static Code Analysis Completed"
          echo "======================================"

      ########################################################################
      # 9. Terraform Plan - dev
      #
      # Jenkins equivalent:
      # plan_infrastructure(dev)
      ########################################################################
      - name: Terraform Plan - dev
        shell: bash
        working-directory: infrastructure/terraform
        env:
          PROJECT: imac
          ENVIRONMENT: dev
          AWS_PROFILE: dev
          TF_VAR_FILE: dev.tfvars
          TF_STATE_BUCKET: imac-dev-tf-state-hhsoig
          TF_STATE_TABLE: imac-dev-tf-lock-hhsoig
          TF_S3_KEY: ""
          TF_ADDITIONAL_VARS: ""
        run: |
          set -euo pipefail

          echo "======================================"
          echo "Terraform Plan: dev"
          echo "======================================"

          echo "Project:          ${PROJECT}"
          echo "Environment:      ${ENVIRONMENT}"
          echo "AWS Profile:      ${AWS_PROFILE}"
          echo "TF State Bucket:  ${TF_STATE_BUCKET}"
          echo "TF State Table:   ${TF_STATE_TABLE}"
          echo "TF Var File:      ${TF_VAR_FILE}"

          ####################################################################
          # Store AWS Profile
          ####################################################################

          echo -n "${AWS_PROFILE}" > .aws_profile.txt

          echo "AWS profile written to .aws_profile.txt"

          ####################################################################
          # Initialize TF Var File
          ####################################################################

          touch "${TF_VAR_FILE}"

          ####################################################################
          # Verify AWS Identity
          ####################################################################

          echo "======================================"
          echo "AWS Identity"
          echo "======================================"

          aws sts get-caller-identity \
            --profile "${AWS_PROFILE}"

          ####################################################################
          # Check/Create S3 Terraform State Bucket
          ####################################################################

          echo "======================================"
          echo "Checking Terraform state bucket"
          echo "======================================"

          bucket=$(
            aws s3api list-buckets \
              --region us-east-1 \
              --profile "${AWS_PROFILE}" |
            jq -r \
              ".Buckets[] | select(.Name==\"${TF_STATE_BUCKET}\")"
          )

          if [[ -z "${bucket}" ]]; then

            echo "Terraform state bucket does not exist."
            echo "Creating ${TF_STATE_BUCKET}..."

            aws s3api create-bucket \
              --bucket "${TF_STATE_BUCKET}" \
              --region us-east-1 \
              --profile "${AWS_PROFILE}" \
              > /dev/null

            echo "Enabling bucket encryption..."

            aws s3api put-bucket-encryption \
              --bucket "${TF_STATE_BUCKET}" \
              --region us-east-1 \
              --profile "${AWS_PROFILE}" \
              --server-side-encryption-configuration \
              '{"Rules":[{"ApplyServerSideEncryptionByDefault":{"SSEAlgorithm":"AES256"}}]}' \
              > /dev/null

            echo "Enabling bucket versioning..."

            aws s3api put-bucket-versioning \
              --bucket "${TF_STATE_BUCKET}" \
              --region us-east-1 \
              --profile "${AWS_PROFILE}" \
              --versioning-configuration Status=Enabled \
              > /dev/null

            echo "Enabling S3 public access block..."

            aws s3api put-public-access-block \
              --bucket "${TF_STATE_BUCKET}" \
              --region us-east-1 \
              --profile "${AWS_PROFILE}" \
              --public-access-block-configuration \
              "BlockPublicAcls=true,IgnorePublicAcls=true,BlockPublicPolicy=true,RestrictPublicBuckets=true"

            echo "Created Terraform state bucket: ${TF_STATE_BUCKET}"

          else

            echo "Terraform state bucket already exists:"
            echo "${TF_STATE_BUCKET}"

          fi

          ####################################################################
          # Check/Create DynamoDB Lock Table
          ####################################################################

          echo "======================================"
          echo "Checking Terraform state lock table"
          echo "======================================"

          tableExists=$(
            aws dynamodb list-tables \
              --region us-east-1 \
              --profile "${AWS_PROFILE}" |
            jq -r \
              ".TableNames | index(\"${TF_STATE_TABLE}\")"
          )

          if [[ "${tableExists}" == "null" ]]; then

            echo "Terraform lock table does not exist."
            echo "Creating ${TF_STATE_TABLE}..."

            aws dynamodb create-table \
              --region us-east-1 \
              --profile "${AWS_PROFILE}" \
              --table-name "${TF_STATE_TABLE}" \
              --key-schema AttributeName=LockID,KeyType=HASH \
              --attribute-definitions AttributeName=LockID,AttributeType=S \
              --billing-mode PAY_PER_REQUEST \
              > /dev/null

            echo "Waiting for DynamoDB table..."

            aws dynamodb wait table-exists \
              --region us-east-1 \
              --profile "${AWS_PROFILE}" \
              --table-name "${TF_STATE_TABLE}"

            echo "Created Terraform lock table: ${TF_STATE_TABLE}"

          else

            echo "Terraform lock table already exists:"
            echo "${TF_STATE_TABLE}"

          fi

          ####################################################################
          # Terraform Init
          ####################################################################

          echo "======================================"
          echo "Running terraform init..."
          echo "======================================"

          if [[ -f "tools/terraform-provider-jenkins_v0.11.0" ]]; then

            VENDOR_DIR="$(pwd)/tools"

            echo "Using vendored taiidani/jenkins provider from ${VENDOR_DIR}"

            cat > "${HOME}/.terraformrc" <<EOF
          provider_installation {
            dev_overrides {
              "taiidani/jenkins" = "${VENDOR_DIR}"
            }
            direct {}
          }
          EOF

          fi

          ####################################################################
          # Optional S3 Backend Key
          ####################################################################

          TF_S3_KEY_ARGS=()

          if [[ -n "${TF_S3_KEY}" ]]; then

            TF_S3_KEY_ARGS=(
              -backend-config
              "key=${TF_S3_KEY}"
            )

          fi

          terraform init \
            -no-color \
            -backend-config="region=us-east-1" \
            -backend-config="bucket=${TF_STATE_BUCKET}" \
            -backend-config="dynamodb_table=${TF_STATE_TABLE}" \
            "${TF_S3_KEY_ARGS[@]}" \
            -upgrade \
            -reconfigure

          ####################################################################
          # Additional Terraform Variables
          ####################################################################

          TF_ADDITIONAL_ARGS=()

          if [[ -n "${TF_ADDITIONAL_VARS}" ]]; then
            read -r -a TF_ADDITIONAL_ARGS <<< "${TF_ADDITIONAL_VARS}"
          fi

          ####################################################################
          # Terraform Plan
          ####################################################################

          echo "======================================"
          echo "Running terraform plan..."
          echo "======================================"

          terraform plan \
            -no-color \
            -var-file="${TF_VAR_FILE}" \
            "${TF_ADDITIONAL_ARGS[@]}" \
            -lock=false \
            -out="${AWS_PROFILE}.tfplan"

          ####################################################################
          # Verify Terraform Plan
          ####################################################################

          echo "======================================"
          echo "Terraform Plan Completed"
          echo "======================================"

          if [[ ! -f "${AWS_PROFILE}.tfplan" ]]; then

            echo "ERROR: Terraform plan file was not created."
            exit 1

          fi

          echo "Terraform plan created successfully:"

          ls -lh "${AWS_PROFILE}.tfplan"

          echo ""
          echo "AWS Profile:"
          cat .aws_profile.txt

          echo ""
          echo "[IMAC] Terraform Plan for dev completed successfully."

      ########################################################################
      # 10. Terraform Apply - dev
      ########################################################################
      - name: Terraform Apply - dev
        if: github.ref_name == 'feature1-IMAC-1261'
        shell: bash
        working-directory: infrastructure/terraform
        env:
          AWS_PROFILE: dev
        run: |
          set -euo pipefail

          echo "======================================"
          echo "Terraform Apply: dev"
          echo "======================================"

          echo "Deploying to ${AWS_PROFILE} for branch ${GITHUB_REF_NAME}."

          ####################################################################
          # Verify AWS Identity
          ####################################################################

          echo "======================================"
          echo "AWS Identity"
          echo "======================================"

          aws sts get-caller-identity \
            --profile "${AWS_PROFILE}"

          ####################################################################
          # Verify Terraform Plan
          ####################################################################

          echo "======================================"
          echo "Checking Terraform Plan"
          echo "======================================"

          if [[ ! -f "${AWS_PROFILE}.tfplan" ]]; then

            echo "ERROR: Terraform plan file does not exist:"
            echo "${AWS_PROFILE}.tfplan"

            exit 1

          fi

          echo "Terraform plan found:"

          ls -lh "${AWS_PROFILE}.tfplan"

          ####################################################################
          # Terraform Apply
          ####################################################################

          echo "======================================"
          echo "Running terraform apply..."
          echo "======================================"

          terraform apply \
            -no-color \
            -auto-approve \
            "${AWS_PROFILE}.tfplan"

          ####################################################################
          # Complete
          ####################################################################

          echo "======================================"
          echo "Terraform Apply Completed"
          echo "======================================"

          echo "[IMAC] Deployment to ${AWS_PROFILE} completed successfully."

      ########################################################################
      # 11. Compile IMAC Configuration
      # if: github.ref_name == 'main'
      ########################################################################
      - name: Compile IMAC Configuration
        if: github.ref_name == 'feature1-IMAC-1261'
        shell: bash
        working-directory: src
        env:
          AWS_PROFILE: dev
          AWS_REGION: us-east-1
          PYTHON_VERSION: "3.14"
        run: |
          set -euo pipefail

          echo "======================================"
          echo "Compile IMAC Configuration"
          echo "======================================"

          ####################################################################
          # Python Environment
          ####################################################################

          ENV_NAME="python${PYTHON_VERSION//./}"

          echo "Python Version:    ${PYTHON_VERSION}"
          echo "Conda Environment: ${ENV_NAME}"
          echo "AWS Profile:       ${AWS_PROFILE}"
          echo "AWS Region:        ${AWS_REGION}"
          echo "Working Directory: $(pwd)"

          ####################################################################
          # Verify Anaconda
          ####################################################################

          if [[ ! -x "$HOME/anaconda3/bin/conda" ]]; then

            echo "ERROR: Anaconda is not installed."
            exit 1

          fi

          ####################################################################
          # Verify Conda Environment
          ####################################################################

          if ! "$HOME/anaconda3/bin/conda" env list --json |
            jq -e \
              --arg env "$ENV_NAME" \
              '[.envs[] | split("/")[-1] == $env] | any' \
              > /dev/null; then

            echo "ERROR: Conda environment ${ENV_NAME} does not exist."
            exit 1

          fi

          ####################################################################
          # Activate Conda Environment
          ####################################################################

          echo "Activating Conda ${ENV_NAME}"

          set +x
          source "$HOME/anaconda3/bin/activate" "$ENV_NAME"
          set -x

          echo "======================================"
          echo "Python Environment"
          echo "======================================"

          python --version

          ####################################################################
          # Verify AWS Identity
          ####################################################################

          echo "======================================"
          echo "AWS Identity"
          echo "======================================"

          aws sts get-caller-identity \
            --profile "${AWS_PROFILE}"

          ####################################################################
          # Verify Required Files
          ####################################################################

          echo "======================================"
          echo "Checking Required Files"
          echo "======================================"

          echo "Current directory:"
          pwd

          echo ""
          echo "Directory contents:"
          ls -la

          if [[ ! -f "manifest.json" ]]; then

            echo "ERROR: manifest.json was not found in $(pwd)."
            exit 1

          fi

          if [[ ! -f "compile_config.py" ]]; then

            echo "ERROR: compile_config.py was not found in $(pwd)."
            exit 1

          fi

          echo ""
          echo "Found manifest.json"
          echo "Found compile_config.py"

          ####################################################################
          # Verify Manifest Reference Directories
          ####################################################################

          echo "======================================"
          echo "Checking Manifest References"
          echo "======================================"

          for directory in account project tool views; do

            if [[ ! -d "${directory}" ]]; then
              echo "ERROR: ${directory}/ directory was not found."
              exit 1
            fi

            echo "Found ${directory}/"

          done

          ####################################################################
          # Compile Configuration
          #
          # compile_config.py:
          #
          # 1. Reads manifest.json
          # 2. Resolves account references
          # 3. Resolves project references
          # 4. Resolves tool references
          # 5. Resolves view references
          # 6. Creates combined.json
          # 7. Gets the current Git SHA
          # 8. Updates dev-ImacConfigTable
          ####################################################################

          echo "======================================"
          echo "Running compile_config.py"
          echo "======================================"

          python compile_config.py

          ####################################################################
          # Verify combined.json
          ####################################################################

          echo "======================================"
          echo "Verifying Compiled Configuration"
          echo "======================================"

          if [[ ! -f "combined.json" ]]; then

            echo "ERROR: combined.json was not created."
            exit 1

          fi

          echo "combined.json created successfully."

          ls -lh combined.json

          ####################################################################
          # Complete
          ####################################################################

          echo "======================================"
          echo "IMAC Configuration Compilation Completed"
          echo "======================================"

          echo "Git SHA:"
          git rev-parse HEAD

          echo ""
          echo "DynamoDB Table: dev-ImacConfigTable"
          echo "AWS Profile:    ${AWS_PROFILE}"
          echo "AWS Region:     ${AWS_REGION}"

          echo ""
          echo "[IMAC] Configuration compiled and uploaded successfully."
