
name: IMAC Infrastructure Policy Check

on:
  workflow_dispatch:
    inputs:
      aws_account_id:
        description: AWS account profile for Terraform plan
        required: true
        type: string

      plan_s3_uri:
        description: S3 location of Terraform plan
        required: true
        type: string

jobs:
  governance:
    name: IMAC Governance Policy Check

    runs-on: imac

    permissions:
      contents: read

    env:
      IMAC_CONFIG_TABLE: dev-ImacConfigTable
      IMAC_CONFIG_KEY: IMAC_CONFIG
      IMAC_CONFIG_REGION: us-east-1

      POLICIES_BRANCH: main
      POLICIES_BUNDLE: opa/policies

      DECISION: cdo/terraform/required_default_tagging/deny

    steps:

      ##########################################################
      # Verify required tools
      ##########################################################

      - name: Verify Governance Tools
        shell: bash
        run: |
          set -euo pipefail

          echo "[GOVERNANCE] Checking required tools..."

          for tool in aws terraform jq opa git; do
            if ! command -v "${tool}" >/dev/null 2>&1; then
              echo "[GOVERNANCE] ERROR: ${tool} is missing."
              exit 1
            fi
          done

          echo "[GOVERNANCE] All required tools available."

      ##########################################################
      # Verify AWS identity
      ##########################################################

      - name: Verify AWS Identity
        shell: bash
        env:
          AWS_ACCOUNT_ID: ${{ inputs.aws_account_id }}
        run: |
          set -euo pipefail

          echo "[AWS] Verifying AWS identity..."

          aws sts get-caller-identity \
            --profile "${AWS_ACCOUNT_ID}"

      ##########################################################
      # Download Terraform plan from S3
      ##########################################################

      - name: Download Terraform Plan
        id: download-plan
        shell: bash
        env:
          AWS_PROFILE: ${{ inputs.aws_account_id }}
          PLAN_S3_URI: ${{ inputs.plan_s3_uri }}
        run: |
          set -euo pipefail

          echo "[GOVERNANCE] Downloading Terraform plan..."

          PLAN_DIR="${RUNNER_TEMP}/imac-governance"

          mkdir -p "${PLAN_DIR}"

          PLAN_FILE="${PLAN_DIR}/terraform.tfplan"

          aws s3 cp \
            "${PLAN_S3_URI}" \
            "${PLAN_FILE}"

          if [[ ! -s "${PLAN_FILE}" ]]; then
            echo "[GOVERNANCE] ERROR: Terraform plan missing."
            exit 1
          fi

          echo "plan_file=${PLAN_FILE}" >> "${GITHUB_OUTPUT}"

          echo "[GOVERNANCE] Terraform plan downloaded."

      ##########################################################
      # Convert Terraform plan to JSON
      ##########################################################

      - name: Convert Terraform Plan to JSON
        id: plan-json
        shell: bash
        env:
          PLAN_FILE: ${{ steps.download-plan.outputs.plan_file }}
        run: |
          set -euo pipefail

          echo "[GOVERNANCE] Converting Terraform plan to JSON..."

          INPUT_FILE="${RUNNER_TEMP}/imac-governance/tfplan.json"

          terraform show -json \
            "${PLAN_FILE}" > "${INPUT_FILE}"

          jq -e . "${INPUT_FILE}" >/dev/null

          echo "input_file=${INPUT_FILE}" >> "${GITHUB_OUTPUT}"

          echo "[GOVERNANCE] Terraform JSON generated."

      ##########################################################
      # Checkout IMAC policies
      ##########################################################

      - name: Checkout IMAC Policies
        uses: actions/checkout@v4
        with:
          repository: CDO/imac-policies
          ref: main
          path: opa
          token: ${{ secrets.POLICY_REPO_TOKEN || github.token }}
          sparse-checkout: |
            policies/cdo/terraform
          sparse-checkout-cone-mode: false
          persist-credentials: false

      ##########################################################
      # Prepare OPA policies
      ##########################################################

      - name: Prepare OPA Policies
        shell: bash
        run: |
          set -euo pipefail

          POLICIES_DIR="${GITHUB_WORKSPACE}/${POLICIES_BUNDLE}"

          echo "[GOVERNANCE] Preparing policies..."

          if [[ ! -d "${POLICIES_DIR}" ]]; then
            echo "[GOVERNANCE] ERROR: Policies missing."
            exit 1
          fi

          find "${POLICIES_DIR}" \
            -name '*_test.rego' \
            -type f \
            -delete

          echo "[GOVERNANCE] Policies ready."

      ##########################################################
      # Retrieve IMAC configuration from DynamoDB
      ##########################################################

      - name: Retrieve IMAC Configuration
        id: imac-config
        shell: bash
        run: |
          set -euo pipefail

          echo "[GOVERNANCE] Loading IMAC configuration..."

          CONFIG_FILE="${RUNNER_TEMP}/imac-governance/imac-config.json"

          CONFIG_JSON=$(
            env -u AWS_PROFILE -u AWS_DEFAULT_PROFILE \
              aws dynamodb get-item \
                --table-name "${IMAC_CONFIG_TABLE}" \
                --key "{\"Name\":{\"S\":\"${IMAC_CONFIG_KEY}\"}}" \
                --region "${IMAC_CONFIG_REGION}" \
                --consistent-read \
                --output json
          )

          printf '%s' "${CONFIG_JSON}" |
            jq -er '
              .Item.CONFIG_JSON.S
              | if type == "string" then
                  fromjson
                else
                  .
                end
              | if type == "string" then
                  fromjson
                else
                  .
                end
              | select(type == "object")
              | select(.projects | type == "object")
            ' > "${CONFIG_FILE}"

          echo "[GOVERNANCE] IMAC configuration retrieved."

          echo "config_file=${CONFIG_FILE}" >> "${GITHUB_OUTPUT}"

      ##########################################################
      # Generate OPA tagging data
      ##########################################################

      - name: Generate OPA Tagging Data
        shell: bash
        env:
          CONFIG_FILE: ${{ steps.imac-config.outputs.config_file }}
        run: |
          set -euo pipefail

          echo "[GOVERNANCE] Generating OPA tagging data..."

          TAGGING_DATA_FILE="${GITHUB_WORKSPACE}/${POLICIES_BUNDLE}/data.json"

          jq -e '
          {
            tagging: {
              projects: (
                .projects
                | keys
              ),

              environments: (
                .projects
                | with_entries(
                    .value = (.value.environments | keys)
                  )
              )
            }
          }
          ' "${CONFIG_FILE}" > "${TAGGING_DATA_FILE}"

          echo "[GOVERNANCE] OPA tagging data generated."

      ##########################################################
      # Execute OPA governance policy
      ##########################################################

      - name: Execute OPA Policy Check
        id: opa-check
        shell: bash
        env:
          INPUT_FILE: ${{ steps.plan-json.outputs.input_file }}
        run: |
          set -euo pipefail

          echo "[GOVERNANCE] Starting OPA policy evaluation..."

          BUNDLE_PATH="${GITHUB_WORKSPACE}/${POLICIES_BUNDLE}"

          echo "[GOVERNANCE] Policies Bundle: ${BUNDLE_PATH}"
          echo "[GOVERNANCE] Input File: ${INPUT_FILE}"
          echo "[GOVERNANCE] Decision Path: ${DECISION}"

          if opa exec \
            --decision "${DECISION}" \
            --bundle "${BUNDLE_PATH}" \
            "${INPUT_FILE}" \
            --format json \
            --fail-non-empty
          then

            echo "[GOVERNANCE] OPA policy check PASSED."

            echo "policy_status=passed" >> "${GITHUB_OUTPUT}"

          else

            echo "[GOVERNANCE] OPA policy check FAILED."

            echo "policy_status=failed" >> "${GITHUB_OUTPUT}"

            exit 1

          fi

          echo "[GOVERNANCE] OPA policy evaluation complete."
