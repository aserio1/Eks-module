#!/usr/bin/env python3

import csv
import os
import subprocess
import sys
import tempfile
import xml.etree.ElementTree as ET
from pathlib import Path

import boto3
import requests
from botocore.exceptions import ClientError
from requests.auth import HTTPBasicAuth


JENKINS_ENV = sys.argv[1].strip()
JENKINS_URL = "https://jenkins.aws.hhsoig.gov/"
USERNAME = "SVC-Jenkins-Agent"
TECH_STACK_FILE = "jenkins_tech_stack.csv"

FOLDER_CLASS = "com.cloudbees.hudson.plugins.folder.Folder"
MULTIBRANCH_CLASS = "org.jenkinsci.plugins.workflow.multibranch.WorkflowMultiBranchProject"
PIPELINE_CLASS = "org.jenkinsci.plugins.workflow.job.WorkflowJob"


def get_secret(secret_name, region="us-east-1"):
    try:
        client = boto3.client("secretsmanager", region_name=region)
        response = client.get_secret_value(SecretId=secret_name)

        if "SecretString" in response:
            return response["SecretString"]

        return response["SecretBinary"].decode("utf-8")

    except ClientError as error:
        print(f"ERROR retrieving Jenkins token: {error}", file=sys.stderr)
        return None


def jenkins_request(url, token):
    response = requests.get(
        url,
        verify=False,
        auth=HTTPBasicAuth(USERNAME, token),
        timeout=60
    )
    response.raise_for_status()
    return response


def fetch_jenkins_pipelines(api_url, token, prefix=""):
    data = jenkins_request(api_url, token).json()
    pipelines = []

    for job in data.get("jobs", []):
        name = job.get("name", "").strip()
        url = job.get("url", "").strip()
        job_class = job.get("_class", "")

        if not name or not url:
            continue

        full_path = f"{prefix}/{name}" if prefix else name

        if job_class == FOLDER_CLASS:
            pipelines.extend(
                fetch_jenkins_pipelines(
                    f"{url}api/json",
                    token,
                    full_path
                )
            )
            continue

        # Add multibranch pipeline itself.
        # Do not recurse into feature/develop/release/PR branches.
        if job_class in (MULTIBRANCH_CLASS, PIPELINE_CLASS):
            pipelines.append({
                "project": full_path.split("/")[0],
                "pipeline": name,
                "full_path": full_path,
                "url": url
            })

    return pipelines


def get_repository_url(job_url, token):
    try:
        config_xml = jenkins_request(
            f"{job_url}config.xml",
            token
        ).text

        root = ET.fromstring(config_xml)

        for element in root.iter():
            tag = element.tag.split("}")[-1]
            value = (element.text or "").strip()

            if tag not in {
                "url",
                "remote",
                "remoteUrl",
                "repositoryUrl",
                "projectUrl"
            }:
                continue

            if (
                value.startswith(("git@", "ssh://", "https://", "http://"))
                and "jenkins.aws.hhsoig.gov" not in value
            ):
                return value

    except (
        requests.RequestException,
        ET.ParseError
    ) as error:
        print(f"WARNING: Unable to determine repository: {error}")

    return None


def clone_main(repository_url, destination):
    try:
        subprocess.run(
            [
                "git",
                "clone",
                "--quiet",
                "--depth",
                "1",
                "--branch",
                "main",
                repository_url,
                str(destination)
            ],
            check=True,
            capture_output=True,
            text=True,
            timeout=300
        )
        return True

    except (
        subprocess.CalledProcessError,
        subprocess.TimeoutExpired
    ) as error:
        print(f"WARNING: Unable to clone main from {repository_url}")

        if isinstance(error, subprocess.CalledProcessError) and error.stderr:
            print(error.stderr.strip())

        return False


def has_file(scan_dir, *patterns):
    return any(
        any(path.is_file() for path in scan_dir.rglob(pattern))
        for pattern in patterns
    )


def file_contains(scan_dir, patterns, text):
    for pattern in patterns:
        for path in scan_dir.rglob(pattern):
            if not path.is_file():
                continue

            try:
                if text in path.read_text(
                    encoding="utf-8",
                    errors="ignore"
                ):
                    return True
            except (OSError, PermissionError):
                pass

    return False


def detect_tech_stack(scan_dir):
    checks = [
        ("terraform", has_file(scan_dir, "*.tf")),
        ("python", has_file(scan_dir, "*.py")),
        ("docker", has_file(scan_dir, "Dockerfile", "Dockerfile.*")),
        ("node", has_file(scan_dir, "package.json")),
        ("maven", has_file(scan_dir, "pom.xml")),
        ("gradle", has_file(scan_dir, "build.gradle", "build.gradle.kts")),
        ("go", has_file(scan_dir, "go.mod")),
        ("dotnet", has_file(scan_dir, "*.csproj", "*.sln")),
        ("helm", has_file(scan_dir, "Chart.yaml")),
        (
            "kubernetes",
            file_contains(scan_dir, ["*.yaml", "*.yml"], "kind:")
        ),
        (
            "ansible",
            has_file(
                scan_dir,
                "ansible.cfg",
                "playbook.yml",
                "playbook.yaml"
            )
        ),
        ("packer", has_file(scan_dir, "*.pkr.hcl", "*.pkr.json")),
        (
            "cloudformation",
            file_contains(
                scan_dir,
                ["*.yaml", "*.yml", "*.json"],
                "AWSTemplateFormatVersion"
            )
        ),
        ("opa", has_file(scan_dir, "*.rego")),
        ("jenkins", has_file(scan_dir, "Jenkinsfile", "Jenkinsfile.*")),
        (
            "github-actions",
            (scan_dir / ".github" / "workflows").is_dir()
        ),
        (
            "gitlab-ci",
            (scan_dir / ".gitlab-ci.yml").is_file()
        )
    ]

    tech_stack = [
        name
        for name, found in checks
        if found
    ]

    return ",".join(tech_stack) if tech_stack else "unknown"


def count_jenkinsfile_loc(scan_dir):
    total = 0

    for path in scan_dir.rglob("*"):
        if not path.is_file():
            continue

        if not (
            path.name == "Jenkinsfile"
            or path.name.startswith("Jenkinsfile.")
        ):
            continue

        try:
            with path.open(
                "r",
                encoding="utf-8",
                errors="ignore"
            ) as file:
                total += sum(
                    1
                    for line in file
                    if line.strip()
                )

        except (OSError, PermissionError):
            continue

    return total


def write_csv(results):
    with open(TECH_STACK_FILE, "w", newline="") as csvfile:
        writer = csv.writer(csvfile)

        writer.writerow([
            "Project",
            "Pipeline",
            "Repository",
            "Tech Stack",
            "Jenkinsfile LOC"
        ])

        for result in results:
            writer.writerow([
                result["project"],
                result["pipeline"],
                result["repository"],
                result["tech_stack"],
                result["jenkinsfile_loc"]
            ])


def main():
    print("======================================")
    print("Jenkins Pipeline Tech Stack Audit")
    print("======================================")

    token = get_secret(
        f"{JENKINS_ENV}-svc-jenkins-agent-token"
    )

    if not token:
        sys.exit(1)

    try:
        pipelines = fetch_jenkins_pipelines(
            f"{JENKINS_URL}api/json",
            token
        )
    except requests.RequestException as error:
        print(
            f"ERROR retrieving Jenkins jobs: {error}",
            file=sys.stderr
        )
        sys.exit(1)

    print(f"Jenkins pipelines discovered: {len(pipelines)}")

    results = []
    scanned_repositories = {}

    with tempfile.TemporaryDirectory(
        prefix="jenkins-tech-stack-"
    ) as temp_directory:

        temp_root = Path(temp_directory)

        for index, pipeline in enumerate(pipelines, start=1):
            print(
                f"[{index}/{len(pipelines)}] "
                f"{pipeline['full_path']}"
            )

            repository = get_repository_url(
                pipeline["url"],
                token
            )

            if not repository:
                print("No Git repository found.")
                continue

            print(f"Repository: {repository}")

            if repository in scanned_repositories:
                scan_result = scanned_repositories[repository]

            else:
                repo_dir = temp_root / f"repo-{index}"

                if not clone_main(repository, repo_dir):
                    continue

                scan_result = {
                    "tech_stack": detect_tech_stack(repo_dir),
                    "jenkinsfile_loc": count_jenkinsfile_loc(repo_dir)
                }

                scanned_repositories[repository] = scan_result

            print(f"Tech Stack: {scan_result['tech_stack']}")
            print(
                f"Jenkinsfile LOC: "
                f"{scan_result['jenkinsfile_loc']}"
            )

            results.append({
                "project": pipeline["project"],
                "pipeline": pipeline["pipeline"],
                "repository": repository,
                **scan_result
            })

    write_csv(results)

    if not os.path.isfile(TECH_STACK_FILE):
        print(
            f"ERROR: {TECH_STACK_FILE} was not generated.",
            file=sys.stderr
        )
        sys.exit(1)

    print("======================================")
    print("Tech Stack Audit Complete")
    print("======================================")
    print(f"Tech stack CSV generated: {TECH_STACK_FILE}")
    print(f"Total pipelines written: {len(results)}")
    print(f"Unique repositories scanned: {len(scanned_repositories)}")
    print(f"CSV verified: {os.path.abspath(TECH_STACK_FILE)}")


if __name__ == "__main__":
    main()
