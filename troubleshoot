#!/bin/bash

REPO_URL="https://git.aws.hhsoig.gov/CDO/imac-policies.git"
REPO_BRANCH="main"

POLICIES_ROOT_DIR="opa"
POLICIES_DIR="policies"
POLICIES_BUNDLE="${POLICIES_ROOT_DIR}/${POLICIES_DIR}"

DECISION="cdo/terraform/required_default_tagging/deny"

TF_PLAN_FILE="${AWS_PROFILE}.tfplan" # generated by plan_infrastructure()
INPUT_FILE="${AWS_PROFILE}-tfplan.json"

IMAC_CONFIG_TABLE="dev-ImacConfigTable"
IMAC_CONFIG_KEY="IMAC_CONFIG"
IMAC_CONFIG_REGION="us-east-1"


echo "[GOVERNANCE] Starting OPA policy evaluation..."
echo "[GOVERNANCE] Policies Bundle: $POLICIES_BUNDLE"
echo "[GOVERNANCE] Input File: $INPUT_FILE"
echo "[GOVERNANCE] Decision Path: $DECISION"
echo "[GOVERNANCE] Policies Branch: $REPO_BRANCH"


# Convert the Terraform plan to JSON so that OPA can read the plan
if [[ -f "${TF_PLAN_FILE}" ]]; then
    terraform show -json "${TF_PLAN_FILE}" > "${INPUT_FILE}"
else
    echo "WARNING: No ${TF_PLAN_FILE} found. Skipping policy check..."
    exit 0
fi


# Download the imac-policies/policies/cdo/terraform
if [[ ! -d "${POLICIES_ROOT_DIR}" ]]; then
    git clone \
        --depth 1 \
        --branch "${REPO_BRANCH}" \
        --no-checkout \
        "${REPO_URL}" \
        "${POLICIES_ROOT_DIR}"

    cd "${POLICIES_ROOT_DIR}"

    # Initialize in cone mode before setting sparse-checkout path
    git sparse-checkout init --cone

    # Checkout only the required policies
    git sparse-checkout set "${POLICIES_DIR}/${DECISION}" && git checkout

    # Remove the _test.rego files, otherwise opa exec will run the tests as well
    find . -name '*_test.rego' -exec rm -f {} +

    cd ..
fi


###############################################################################
# Load dynamic Project and Environment configuration from imac-config
###############################################################################

echo "[GOVERNANCE] Loading tagging configuration from ${IMAC_CONFIG_TABLE}..."

# AWS_PROFILE is intentionally removed only for this command.
# The Jenkins agent instance role is used to access the DynamoDB table.
CONFIG_JSON=$(env -u AWS_PROFILE -u AWS_DEFAULT_PROFILE \
    aws dynamodb get-item \
    --table-name "${IMAC_CONFIG_TABLE}" \
    --key "{\"Name\":{\"S\":\"${IMAC_CONFIG_KEY}\"}}" \
    --region "${IMAC_CONFIG_REGION}" \
    --query 'Item.CONFIG_JSON.S' \
    --output text)


if [[ -z "${CONFIG_JSON}" || "${CONFIG_JSON}" == "None" ]]; then
    echo "[GOVERNANCE] ERROR: IMAC_CONFIG was not returned from DynamoDB."
    exit 1
fi


# CONFIG_JSON is stored as an escaped JSON string in DynamoDB
CONFIG_JSON=$(printf '%s' "${CONFIG_JSON}" | sed 's/\\"/"/g')

# Remove surrounding quotes if the value still contains them
CONFIG_JSON="${CONFIG_JSON#\"}"
CONFIG_JSON="${CONFIG_JSON%\"}"


# Verify that the retrieved configuration is valid JSON
if ! printf '%s' "${CONFIG_JSON}" | jq empty >/dev/null 2>&1; then
    echo "[GOVERNANCE] ERROR: CONFIG_JSON returned from DynamoDB is not valid JSON."
    exit 1
fi


###############################################################################
# Generate OPA data
#
# Expected data.json format:
#
# {
#   "tagging": {
#     "projects": ["imac", "sie"],
#     "environments": {
#       "imac": ["dev", "prod"],
#       "sie": ["dev", "qa", "prod"]
#     }
#   }
# }
###############################################################################

TAGGING_DATA_FILE="${POLICIES_BUNDLE}/data.json"

printf '%s' "${CONFIG_JSON}" | jq '
{
    tagging: {
        projects: (
            .projects
            | keys
        ),

        environments: (
            .projects
            | with_entries(
                .value = (.value.environments | keys)
            )
        )
    }
}
' > "${TAGGING_DATA_FILE}"


echo "[GOVERNANCE] OPA tagging data generated successfully."


###############################################################################
# Debugging only
#
# Uncomment if the generated OPA tagging data needs to be inspected.
###############################################################################

# echo "[GOVERNANCE] Generated OPA tagging data:"
# jq '.tagging' "${TAGGING_DATA_FILE}"


###############################################################################
# Execute the OPA policy on the Terraform plan
###############################################################################

echo "[GOVERNANCE] Executing OPA policy..."

opa exec \
    --decision "${DECISION}" \
    --bundle "${POLICIES_BUNDLE}" \
    "${INPUT_FILE}" \
    --format json \
    --fail-non-empty


OPA_STATUS=$?


# Check the exit status of the OPA command
if [[ ${OPA_STATUS} -eq 0 ]]; then
    echo "[GOVERNANCE] OPA policy check PASSED: $DECISION"
else
    echo "[GOVERNANCE] OPA policy check FAILED: $DECISION"
    exit 1
fi


echo "[GOVERNANCE] OPA policy evaluation complete."



