#!/bin/bash
set -euo pipefail

TECH_STACK=()

# Terraform
if [ -d "infrastructure/terraform" ] && find infrastructure/terraform -type f -name "*.tf" -print -quit | grep -q .; then
    TECH_STACK+=("terraform")
fi

# Python
if find . -type f -name "*.py" -print -quit | grep -q .; then
    TECH_STACK+=("python")
fi

# Docker
if find . -type f -name "Dockerfile" -print -quit | grep -q .; then
    TECH_STACK+=("docker")
fi

# Node
if [ -f "package.json" ]; then
    TECH_STACK+=("node")
fi

# Write JSON to file (not stdout)
(
    echo '{"tech_stack":['
    for i in "${!TECH_STACK[@]}"; do
        printf '"%s"' "${TECH_STACK[i]}"
        if [ $i -lt $((${#TECH_STACK[@]} - 1)) ]; then printf ','; fi
    done
    echo ']}'
) > tech_stack.json
