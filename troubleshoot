# Pre-flight: catch a corrupted env before the real install runs
if ! pip check > /dev/null 2>&1; then
    echo "pip check failed - env has broken/inconsistent packages, auto-healing"

    # Identify exactly which packages pip check flagged, then force-reinstall
    # just those, rather than blowing away the whole env
    BROKEN_PKGS=$(pip check 2>&1 | grep -oP "^\K[a-zA-Z0-9._-]+(?= )" | sort -u)

    if [ -n "${BROKEN_PKGS}" ]; then
        echo "Reinstalling broken packages: ${BROKEN_PKGS}"
        pip install --force-reinstall --no-deps ${BROKEN_PKGS}
    fi

    # Re-check; if still broken, something more serious is going on
    if ! pip check > /dev/null 2>&1; then
        echo "WARNING: pip check still failing after targeted reinstall, falling back to full reinstall"
        pip install --force-reinstall --no-deps -r requirements.txt
    fi
fi
 
