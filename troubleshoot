name: Run Terraform Plan

on:
  workflow_call:
    inputs:
      project:
        required: true
        type: string
      env_short_name:
        required: true
        type: string
      profile:
        required: false
        type: string
        default: ""
      s3_key:
        required: false
        type: string
        default: ""
      var_file:
        required: false
        type: string
        default: ""
      additional_vars:
        required: false
        type: string
        default: ""
      working_directory:
        required: false
        type: string
        default: infrastructure/terraform
      runner:
        required: false
        type: string
        default: imac
      aws_account_id:
        description: Target account ID — must match a runner AWS profile.
        required: true
        type: string
    outputs:
      plan_name:
        value: ${{ jobs.plan.outputs.plan_name }}
      plan_file:
        value: ${{ jobs.plan.outputs.plan_file }}
      state_bucket:
        value: ${{ jobs.plan.outputs.state_bucket }}
      plan_s3_uri:
        value: ${{ jobs.plan.outputs.plan_s3_uri }}

jobs:
  plan:
    runs-on: ${{ inputs.runner }}

    outputs:
      plan_name:    ${{ steps.terraform-plan.outputs.plan_name }}
      plan_file:    ${{ steps.terraform-plan.outputs.plan_file }}
      state_bucket: ${{ steps.terraform-plan.outputs.state_bucket }}
      plan_s3_uri:  ${{ steps.upload-plan.outputs.plan_s3_uri }}

    steps:
      - name: Checkout
        uses: actions/checkout@v4

      # Auth comes from the runner's baked-in AWS profiles (same as Jenkins agents)
      - name: Verify AWS identity
        shell: bash
        run: |
          aws sts get-caller-identity --profile ${{ inputs.aws_account_id }}

      - name: Run terraform plan
        id: terraform-plan
        uses: CDO/imac-shared-gh-actions/terraform/plan@v1
        with:
          project:              ${{ inputs.project }}
          env_short_name:       ${{ inputs.env_short_name }}
          profile:              ${{ inputs.profile }}
          s3_key:               ${{ inputs.s3_key }}
          var_file:             ${{ inputs.var_file }}
          additional_vars:      ${{ inputs.additional_vars }}
          working_directory:    ${{ inputs.working_directory }}
          aws_profile_override: ${{ inputs.aws_account_id }}

      # Plan goes to the project artifacts bucket. GitHub artifact
      # storage is not usable on our GHES (v4 unsupported, v3 blocked
      # by the instance cert), and S3 matches the Jenkins model anyway.
      - name: Upload plan to S3
        id: upload-plan
        shell: bash
        working-directory: ${{ inputs.working_directory }}
        env:
          AWS_PROFILE:      ${{ steps.terraform-plan.outputs.aws_profile }}
          ARTIFACTS_BUCKET: ${{ steps.terraform-plan.outputs.artifacts_bucket }}
          PLAN_FILE:        ${{ steps.terraform-plan.outputs.plan_file }}
        run: |
          S3_PREFIX="s3://${ARTIFACTS_BUCKET}/github-actions/${{ github.repository }}/${{ github.run_id }}"
          aws s3 cp "$PLAN_FILE"       "${S3_PREFIX}/${PLAN_FILE}"
          aws s3 cp .aws_profile.txt   "${S3_PREFIX}/.aws_profile.txt"
          echo "plan_s3_uri=${S3_PREFIX}/${PLAN_FILE}" >> $GITHUB_OUTPUT
          echo "Plan uploaded to ${S3_PREFIX}/${PLAN_FILE}"
