### compile_config.py
import json
import os
import subprocess

def compile_config():
    root = parse_json("manifest.json")
    crawl_object(root)
    write_json("combined.json", root)
    
def parse_json(file):
    with open(file) as f:
        data = json.load(f)
    return data
    

def get_git_revision_hash():
    return subprocess.check_output(['git', 'rev-parse', 'HEAD']).decode('ascii').strip()
    

def write_json(file, data):
    with open(file, "w") as f:
        j = json.dumps(data).replace("\"","\\\"")
        db_item = {
            "CONFIG_JSON": {"S": f"\"{j}\""},
            "Name": {"S": "IMAC_CONFIG"},
            "GIT_SHA": {"S": get_git_revision_hash() }
        }
        json.dump(db_item, f)

    print("Updating the config in DynamoDB")
    try:
        # Using file:// syntax for --item to avoid "Argument list too long"
        subprocess.run(["aws", "dynamodb", "put-item",
                        "--table-name", "dev-ImacConfigTable",
                        "--item", f"file://{file}",
                        "--region", "us-east-1"], check=True)
    except subprocess.CalledProcessError as e:
        print(f"Command failed with return code {e.returncode}")

        
def crawl_object(root):
    for key, value in root.items():
        if isinstance(value, str) and "view" in value:
            print(f"Parsing views: {value}")
            parse_view(root, key, value)
        elif isinstance(value, str) and "ref:/" in value:
            print(f"Parsing ref: {value}")
            parse_ref(root, key, value)
        elif isinstance(value, list):
            print(f"Crawling array: {value}")
            crawl_array(root, value)
        elif isinstance(value, dict):
            print(f"Crawling Object: {value}")
            crawl_object(value)
        
def crawl_array(root, value):
    for item in value:
        if isinstance(item, str) and "ref:/" in item:
            print(f"Parsing ref: {item}")
            parse_ref(root, item, item)
        elif isinstance(item, list):
            print(f"Crawling array: {item}")
            crawl_array(root, item)
        elif isinstance(item, dict):
            print(f"Crawling Object: {item}")
            crawl_object(item)
            
def parse_ref(root, key, value):
    path = value.replace("ref:/", "")
    if ".json" in path:
        data = parse_json(path)
        crawl_object(data)
        root[key] = data
    else:
        refs = {}
        for file in os.listdir(path):
            fq_file = f"{path}/{file}"
            if os.path.isfile(fq_file):
                data = parse_json(fq_file)
                crawl_object(data)
                ref_key = file.replace(".json", "")
                refs[ref_key] = data
        root[key] = refs
        
def parse_view(root, key, value):
    path = value.replace("ref:/", "")
    refs = {}
    for file in os.listdir(path):
        if os.path.isfile(file):
            data = parse_json(file)
            ref_key = file.replace(".json", "")
            refs[ref_key] = data
    root[key] = refs
    
    
compile_config()
