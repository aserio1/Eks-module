jobs:
  smoke-test:
    runs-on: [self-hosted, imac]

    steps:
      ########################################################################
      # 1. confirm we are on the right runner
      ########################################################################
      - name: Runner identity
        run: |
          echo "Hostname:   $(hostnamectl hostname)"
          echo "User:       $(whoami)"
          echo "Runner OS:  $RUNNER_OS"
          echo "Runner name: $RUNNER_NAME"
          echo "Runner labels: $RUNNER_LABELS"

      ########################################################################
      # 2. confirm tools are available
      ########################################################################
      - name: Tool versions
        run: |
          echo "=== AWS CLI ===" && aws --version
          echo "=== Terraform ===" && terraform version
          echo "=== Docker CLI ===" && docker --version
          echo "=== Git ===" && git --version
          echo "=== Node ===" && node -v
          echo "=== Python ===" && python3 --version
          echo "=== jq ===" && jq --version
          echo "=== yq ===" && yq --version
          echo "=== OPA ===" && opa version
          echo "=== Regal ===" && regal version
          echo "=== tflint ===" && tflint --version
          echo "=== Trivy ===" && trivy --version
          echo "=== sonar-scanner ===" && sonar-scanner --version
          echo "=== Nuclei ===" && nuclei --version
          echo "=== OpenGrep ===" && opengrep-core -version

      ########################################################################
      # 3. confirm AWS identity — verifies instance profile is working
      ########################################################################
      - name: AWS identity
        run: |
          aws sts get-caller-identity

      ########################################################################
      # 4. confirm AWS profiles are in ~/.aws/config
      ########################################################################
      - name: AWS profiles
        run: |
          echo "=== ~/.aws/config ===" && cat ~/.aws/config
          echo "=== Profile list ===" && aws configure list-profiles
