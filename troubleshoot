11:11:38  # METADATA
11:11:38  # title: Required SAST & DAST Steps Check
11:11:38  # description: >-
11:11:38  #   Enforces that every project runs SAST, and that applications (repos exposing
11:11:38  #   an HTTP surface) additionally run DAST. Applicability for DAST is decided
11:11:38  #   from code signals (web framework in package.json, API Gateway, or an ALB
11:11:38  #   HTTP/HTTPS listener). Per-pipeline overrides in
11:11:38  #   imac-jenkins-jobs/jobs/{project}.json (security_overrides, matched on
11:11:38  #   repo + optional jenkinsfile) can exempt or force SAST/DAST for jobs the
11:11:38  #   blanket rules get wrong (e.g. auxiliary image-build pipelines in a repo
11:11:38  #   whose primary pipeline already runs SAST). The legacy repo-wide
11:11:38  #   dast_overrides list is still honored when no security_overrides entry
11:11:38  #   matches. When the detector did not populate signals and no override exists,
11:11:38  #   DAST defaults to required (fail-safe). Exposes three decisions - sast_deny
11:11:38  #   (block immediately), dast_deny (grace-period / non-blocking rollout), and
11:11:38  #   deny (both combined).
11:11:38  # scope: package
11:11:38  # entrypoint: true
11:11:38  # custom:
11:11:38  #   id: CDO-JENKINS-0005
11:11:38  #   avd_id: CDO-JENKINS-0005
11:11:38  #   severity: HIGH
11:11:38  #   short_code: required-security-steps
11:11:38  #   recommended_actions: >-
11:11:38  #     Add the missing sast and/or dast step to the pipeline template. If this
11:11:38  #     specific pipeline should not run the step (e.g. its repo's primary
11:11:38  #     pipeline already does), add a security_overrides entry with
11:11:38  #     sast_required=false / dast_required=false and a reason to
11:11:38  #     imac-jenkins-jobs/jobs/{project}.json, scoped to this jenkinsfile.
11:11:38  #   input:
11:11:38  #     selector:
11:11:38  #       - type: json
11:11:38  package cdo.pipelines.required_security_steps
11:11:38  
11:11:38  import rego.v1
11:11:38  
11:11:38  # Steps present in the pipeline template. Authoritative = INVOKED in the
11:11:38  # Jenkinsfile (a library loaded but never called does not actually run).
11:11:38  steps := {step |
11:11:38  	some step in input.pipeline_steps
11:11:38  	step != ""
11:11:38  }
11:11:38  
11:11:38  # Libraries loaded in pipeline_config.groovy (secondary signal).
11:11:38  loaded := {lib |
11:11:38  	some lib in input.loaded_libraries
11:11:38  	lib != ""
11:11:38  }
11:11:38  
11:11:38  # ─────────────────────────────────────────────────────────────────────────────
11:11:38  # PER-PIPELINE SECURITY OVERRIDES
11:11:38  #
11:11:38  # jobs/{project}.json may carry a top-level "security_overrides" list:
11:11:38  #
11:11:38  #   "security_overrides": [
11:11:38  #     {
11:11:38  #       "repo": "https://git.aws.hhsoig.gov/CDO/dwb-data.git",
11:11:38  #       "jenkinsfile": "jenkins/Jenkinsfile.build_image",
11:11:38  #       "sast_required": false,
11:11:38  #       "reason": "SAST runs in the repo's primary pipeline (jenkins/Jenkinsfile)."
11:11:38  #     }
11:11:38  #   ]
11:11:38  #
11:11:38  # Matching: entry.repo must equal input.repo. If the entry has a "jenkinsfile"
11:11:38  # field it must equal input.jenkinsfile (job-scoped); if the field is omitted
11:11:38  # the entry applies to every pipeline in that repo (repo-scoped).
11:11:38  #
11:11:38  # Conflict handling is fail-safe: if any matching entry forces a step ON
11:11:38  # (…_required == true), that wins over any matching entry turning it off.
11:11:38  #
11:11:38  # Evaluated as boolean helper rules (never single-assignment) so duplicate or
11:11:38  # overlapping entries cannot raise an "assigned more than once" eval error and
11:11:38  # crash the policy — same defensive pattern as the legacy dast_overrides
11:11:38  # handling below.
11:11:38  # ─────────────────────────────────────────────────────────────────────────────
11:11:38  
11:11:38  security_override_entries := object.get(data.defined_pipelines, "security_overrides", [])
11:11:38  
11:11:38  # Repo-scoped match (no jenkinsfile field on the entry).
11:11:38  matching_security_overrides contains entry if {
11:11:38  	some entry in security_override_entries
11:11:38  	entry.repo == input.repo
11:11:38  	not entry.jenkinsfile
11:11:38  }
11:11:38  
11:11:38  # Job-scoped match (entry pins a specific jenkinsfile).
11:11:38  matching_security_overrides contains entry if {
11:11:38  	some entry in security_override_entries
11:11:38  	entry.repo == input.repo
11:11:38  	entry.jenkinsfile == input.jenkinsfile
11:11:38  }
11:11:38  
11:11:38  # ── SAST override resolution ────────────────────────────────────────────────
11:11:38  sast_override_off if {
11:11:38  	some entry in matching_security_overrides
11:11:38  	entry.sast_required == false
11:11:38  }
11:11:38  
11:11:38  sast_override_on if {
11:11:38  	some entry in matching_security_overrides
11:11:38  	entry.sast_required == true
11:11:38  }
11:11:38  
11:11:38  # SAST is required unless explicitly exempted; a forced-on entry always wins.
11:11:38  sast_required if sast_override_on
11:11:38  
11:11:38  sast_required if not sast_override_off
11:11:38  
11:11:38  # ── DAST override resolution (new-style) ────────────────────────────────────
11:11:38  sec_dast_forces_on if {
11:11:38  	some entry in matching_security_overrides
11:11:38  	entry.dast_required == true
11:11:38  }
11:11:38  
11:11:38  sec_dast_forces_off if {
11:11:38  	some entry in matching_security_overrides
11:11:38  	entry.dast_required == false
11:11:38  }
11:11:38  
11:11:38  sec_dast_present if sec_dast_forces_on
11:11:38  
11:11:38  sec_dast_present if sec_dast_forces_off
11:11:38  
11:11:38  # ─────────────────────────────────────────────────────────────────────────────
11:11:38  # DECISIONS
11:11:38  #
11:11:38  # sast_deny — SAST is a mature, universal requirement; the hook blocks on this
11:11:38  #             immediately (unless exempted for this pipeline by override).
11:11:38  # dast_deny — DAST is a new requirement; the hook wraps this in a grace-period
11:11:38  #             feature flag (warn-only until an enforce date, then block).
11:11:38  # deny      — aggregate of both, for callers wanting a single combined gate.
11:11:38  # ─────────────────────────────────────────────────────────────────────────────
11:11:38  
11:11:38  # True when the detector could not read the Jenkinsfile at all (unset path or
11:11:38  # missing file). In that case pipeline_steps is [] but this MUST NOT be read
11:11:38  # as "steps are absent" — it means "unknown." All invocation-dependent denials
11:11:38  # (missing step, loaded-but-not-invoked, no target URL) are suspended when this
11:11:38  # is set, so a detector wiring bug never produces a false violation against a
11:11:38  # compliant pipeline. Applicability (DAST-from-signals, SAST-always) is
11:11:38  # unaffected since it does not depend on reading the Jenkinsfile.
11:11:38  invocation_unverified if input.invocation_check_failed == true
11:11:38  
11:11:38  # ── SAST: required for all pipelines unless overridden ──────────────────────
11:11:38  # Two mutually exclusive messages for the same underlying failure (SAST does
11:11:38  # not run): a clearer one when the library is loaded but never invoked, and the
11:11:38  # generic "missing" one otherwise. Suspended when invocation could not be
11:11:38  # verified, and skipped entirely when this pipeline carries a
11:11:38  # sast_required=false override.
11:11:38  sast_deny contains msg if {
11:11:38  	sast_required
11:11:38  	not invocation_unverified
11:11:38  	not steps.sast
11:11:38  	not loaded.sast
11:11:38  	msg := "Missing required step: 'sast' is required for all projects but was not found in the pipeline template. If this specific pipeline should not run SAST (e.g. the repo's primary pipeline already does), add a security_overrides entry with sast_required=false to imac-jenkins-jobs/jobs/{project}.json."
11:11:38  }
11:11:38  
11:11:38  sast_deny contains msg if {
11:11:38  	sast_required
11:11:38  	not invocation_unverified
11:11:38  	loaded.sast
11:11:38  	not steps.sast
11:11:38  	msg := "The 'sast' library is loaded in pipeline_config.groovy but sast() is never invoked in the Jenkinsfile, so the scan does not run."
11:11:38  }
11:11:38  
11:11:38  # Not a denial — invocation could not be verified, so we do not fail the build
11:11:38  # on it. Surfaced as a separate decision so the hook can log a loud warning
11:11:38  # without blocking. See sast_deny / dast_deny for the suspended checks.
11:11:38  warn contains msg if {
11:11:38  	invocation_unverified
11:11:38  	msg := "Could not verify invoked security steps: the Jenkinsfile was not readable by the detector (check JENKINSFILE_PATH wiring / multi-Jenkinsfile repos). Invocation-based SAST/DAST checks were skipped for this run, not denied."
11:11:38  }
11:11:38  
11:11:38  [31m[0m
11:11:38  [31m[0m# Audit-trail breadcrumb: make exemptions visible in the build log so a
11:11:38  # skipped SAST check is always an explicit, reviewable decision, never silent.
11:11:38  warn contains msg if {
11:11:38  	sast_override_off
11:11:38  	not sast_override_on
11:11:38  	msg := sprintf(
11:11:38  		"SAST check skipped for this pipeline (%s @ %s) by a security_overrides entry with sast_required=false.",
11:11:38  		[input.repo, input.jenkinsfile],
11:11:38  	)
11:11:38  }
11:11:38  
11:11:38  # ── DAST: required for applications ──────────────────────────────────────────
11:11:38  # Mutually exclusive with the loaded-but-not-invoked message below. Applicability
11:11:38  # (dast_required) is unaffected by invocation_unverified — only the denials
11:11:38  # that depend on reading the Jenkinsfile are suspended.
11:11:38  dast_deny contains msg if {
11:11:38  	dast_required
11:11:38  	not invocation_unverified
11:11:38  	not steps.dast
11:11:38  	not loaded.dast
11:11:38  	msg := sprintf(
11:11:38  		"Missing required step: 'dast' is required for this repo (%s) but was not found in the pipeline template. If this repo has no scannable HTTP surface, add a security_overrides (or legacy dast_overrides) entry with dast_required=false to imac-jenkins-jobs/jobs/{project}.json.",
11:11:38  		[dast_reason],
11:11:38  	)
11:11:38  }
11:11:38  
11:11:38  # Library loaded but step never invoked → the scan does not actually run.
11:11:38  dast_deny contains msg if {
11:11:38  	dast_required
11:11:38  	not invocation_unverified
11:11:38  	loaded.dast
11:11:38  	not steps.dast
11:11:38  	msg := "The 'dast' library is loaded in pipeline_config.groovy but dast() is never invoked in the Jenkinsfile, so the scan does not run."
11:11:38  }
11:11:38  
11:11:38  # dast.groovy signature is call(String targetUrl, Boolean blocking=true):
11:11:38  # targetUrl is REQUIRED and nuclei.sh runs `-u $TARGET_URL`. A dast() call with
11:11:38  # no URL runs the scanner against nothing and can appear to pass. Require a
11:11:38  # real target so the step is not merely present but actually scans something.
11:11:38  dast_deny contains msg if {
11:11:38  	dast_required
11:11:38  	not invocation_unverified
11:11:38  	steps.dast
11:11:38  	not valid_target_url
11:11:38  	msg := "The 'dast' step is invoked but has no target URL. dast() requires a URL argument (e.g. dast(\"https://your-app...\")); without it Nuclei has nothing to scan."
11:11:38  }
11:11:38  
11:11:38  # ── Combined decision (both blocking): backwards-compatible entrypoint ───────
11:11:38  deny contains msg if {
11:11:38  	some msg in sast_deny
11:11:38  }
11:11:38  
11:11:38  deny contains msg if {
11:11:38  	some msg in dast_deny
11:11:38  }
11:11:38  
11:11:38  # ── Target URL validity ─────────────────────────────────────────────────────
11:11:38  valid_target_url if {
11:11:38  	is_string(input.dast_target_url)
11:11:38  	trim_space(input.dast_target_url) != ""
11:11:38  	startswith(input.dast_target_url, "http")
11:11:38  }
11:11:38  
11:11:38  # ─────────────────────────────────────────────────────────────────────────────
11:11:38  # DAST APPLICABILITY
11:11:38  #
11:11:38  # Precedence: a matching security_overrides entry wins; otherwise a legacy
11:11:38  # repo-wide dast_overrides entry; otherwise code signals decide; if the
11:11:38  # detector did not populate any signal and there is no override, default to
11:11:38  # required (fail-safe).
11:11:38  # ─────────────────────────────────────────────────────────────────────────────
11:11:38  
11:11:38  # Legacy repo-wide overrides. Presence and forced value are evaluated as
11:11:38  # booleans (not a single assignment) so duplicate repo entries in
11:11:38  # dast_overrides cannot raise an "assigned more than once" eval error and
11:11:38  # crash the policy.
11:11:38  legacy_override_present if {
11:11:38  	some entry in data.defined_pipelines.dast_overrides
11:11:38  	entry.repo == input.repo
11:11:38  }
11:11:38  
11:11:38  legacy_override_forces_on if {
11:11:38  	some entry in data.defined_pipelines.dast_overrides
11:11:38  	entry.repo == input.repo
11:11:38  	entry.dast_required == true
11:11:38  }
11:11:38  
11:11:38  # Final decision
11:11:38  dast_required if sec_dast_forces_on
11:11:38  
11:11:38  dast_required if {
11:11:38  	not sec_dast_present
11:11:38  	legacy_override_forces_on
11:11:38  }
11:11:38  
