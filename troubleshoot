aws s3 cp \
  s3://imac-prod-tf-state-hhsoig/jenkins.tfstate \
  /tmp/jenkins.tfstate


jq -r '
  .resources[]
  | select(.type == "aws_s3_bucket" and .name == "jenkins_binaries")
  | .instances[].attributes.id
' /tmp/jenkins.tfstate

export AWS_PROFILE=dev

terraform init -reconfigure \
  -backend-config="bucket=imac-prod-tf-state-hhsoig" \
  -backend-config="key=jenkins.tfstate" \
  -backend-config="region=us-east-1" \
  -backend-config="dynamodb_table=imac-prod-tf-lock-hhsoig" \
  -backend-config="encrypt=true"

terraform state list | grep aws_s3_bucket.jenkins_binaries

terraform import \
  -var-file="prod.tfvars" \
  aws_s3_bucket.jenkins_binaries \
  jenkins-binaries-213141505949

terraform plan \
  -var-file="dev.tfvars" \
  -target=aws_s3_bucket.jenkins_binaries \
  -target=aws_s3_bucket_versioning.jenkins_binaries \
  -target=aws_s3_bucket_lifecycle_configuration.jenkins_binaries
