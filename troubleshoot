# Install OS Packages
RUN dnf -y install procps jq curl ca-certificates && \
    curl -fsSL https://rpm.nodesource.com/setup_18.x | bash - && \
    dnf -y install nodejs && \
    node --version | grep '^v18\.' && \
    npm --version && \
    npm install --global yarn && \
    yarn --version && \
    dnf clean all
