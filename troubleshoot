#!/usr/bin/env python3

"""
Jenkins EFS Workspace Cleanup

Features:
- Recursively identify .terraform directories.
- Identify stale top-level workspaces older than 90 days.
- Generate a CSV inventory.
- Dry-run by default.
- Delete .terraform directories when explicitly enabled.
- Delete stale workspaces only from an approved CSV.
- Limit concurrent EFS operations.
- Avoid full EFS size scans.
- Do not follow symbolic links.

IMPORTANT:
Workspace deletion requires external Jenkins active-build
validation before execution.
"""

import argparse
import csv
import os
import shutil
import stat
import time

from concurrent.futures import ThreadPoolExecutor, as_completed
from datetime import datetime
from pathlib import Path
from threading import Lock


ROOT_DIR = "/home/jenkins/workspace"

STALE_DAYS = 90
MAX_WORKERS = 2

print_lock = Lock()


def log(message):
    with print_lock:
        print(message, flush=True)


def get_dir_size(path):
    """Calculate logical file size without following symlinks."""
    total = 0
    stack = [path]

    while stack:
        current = stack.pop()

        try:
            with os.scandir(current) as entries:
                for entry in entries:
                    try:
                        if entry.is_symlink():
                            continue

                        if entry.is_file(follow_symlinks=False):
                            total += entry.stat(
                                follow_symlinks=False
                            ).st_size

                        elif entry.is_dir(follow_symlinks=False):
                            stack.append(entry.path)

                    except OSError as error:
                        log(f"WARNING: {entry.path}: {error}")

        except OSError as error:
            log(f"WARNING: {current}: {error}")

    return total


def find_terraform_dirs(root):
    """Find .terraform directories without descending into them."""
    stack = [root]

    while stack:
        current = stack.pop()

        try:
            with os.scandir(current) as entries:
                for entry in entries:
                    if not entry.is_dir(follow_symlinks=False):
                        continue

                    if entry.name == ".terraform":
                        yield entry.path
                    else:
                        stack.append(entry.path)

        except OSError as error:
            log(f"WARNING: Cannot scan {current}: {error}")


def find_stale_workspaces(root, days):
    """Find top-level directories older than the retention threshold."""
    cutoff = time.time() - days * 86400

    with os.scandir(root) as entries:
        for entry in entries:
            try:
                if not entry.is_dir(follow_symlinks=False):
                    continue

                metadata = entry.stat(follow_symlinks=False)

                if metadata.st_mtime < cutoff:
                    yield {
                        "path": entry.path,
                        "modified": datetime.fromtimestamp(
                            metadata.st_mtime
                        ).isoformat(timespec="seconds"),
                        "age_days": int(
                            (time.time() - metadata.st_mtime) / 86400
                        ),
                    }

            except OSError as error:
                log(f"WARNING: {entry.path}: {error}")


def classify_workspace(path):
    name = os.path.basename(path)

    if name.endswith("@tmp"):
        return "Temporary workspace"

    if "@2" in name or "@3" in name:
        return "Concurrent workspace"

    if "_PR-" in name:
        return "Pull request workspace"

    return "Standard workspace"


def validate_target(path, root):
    """Reject paths outside the configured workspace root."""
    root_real = os.path.realpath(root)
    path_real = os.path.realpath(path)

    if os.path.commonpath([root_real, path_real]) != root_real:
        raise ValueError(f"Path outside workspace root: {path}")

    if path_real == root_real:
        raise ValueError("Refusing to delete workspace root")

    if os.path.islink(path):
        raise ValueError("Refusing to delete symlink")


def delete_directory(path, root):
    """Delete a validated directory."""
    try:
        validate_target(path, root)

        if not os.path.isdir(path):
            return "SKIPPED"

        shutil.rmtree(path)

        log(f"DELETED: {path}")
        return "DELETED"

    except Exception as error:
        log(f"ERROR: Failed to delete {path}: {error}")
        return "FAILED"


def write_csv(filename, records):
    fields = [
        "path",
        "type",
        "modified",
        "age_days",
        "size_gib",
        "status",
    ]

    with open(filename, "w", newline="", encoding="utf-8") as output:
        writer = csv.DictWriter(output, fieldnames=fields)
        writer.writeheader()
        writer.writerows(records)


def load_approved_paths(filename):
    approved = set()

    if not filename:
        return approved

    with open(filename, newline="", encoding="utf-8") as source:
        reader = csv.DictReader(source)

        if not {"path", "approved"}.issubset(reader.fieldnames or []):
            raise ValueError(
                "Approval CSV must contain path and approved columns"
            )

        for row in reader:
            if row["approved"].strip().lower() == "yes":
                approved.add(row["path"].strip())

    return approved


def main():
    parser = argparse.ArgumentParser()

    parser.add_argument(
        "--execute",
        action="store_true",
        help="Enable deletion"
    )

    parser.add_argument(
        "--cleanup-terraform",
        action="store_true",
        help="Include .terraform cleanup"
    )

    parser.add_argument(
        "--cleanup-workspaces",
        action="store_true",
        help="Include stale workspace cleanup"
    )

    parser.add_argument(
        "--days",
        type=int,
        default=STALE_DAYS
    )

    parser.add_argument(
        "--approved-csv",
        help="CSV containing approved workspace paths"
    )

    parser.add_argument(
        "--jenkins-idle-confirmed",
        action="store_true",
        help="Operator attests Jenkins agent is drained and idle"
    )

    parser.add_argument(
        "--report",
        default="jenkins_efs_cleanup.csv"
    )

    args = parser.parse_args()

    root = ROOT_DIR

    if args.days < 1:
        parser.error("--days must be at least 1")

    if not os.path.isdir(root):
        parser.error(f"Workspace root does not exist: {root}")

    if args.execute and not args.jenkins_idle_confirmed:
        parser.error(
            "Execution requires --jenkins-idle-confirmed. "
            "Drain the agent and verify no active builds first."
        )

    if args.execute and args.cleanup_workspaces and not args.approved_csv:
        parser.error(
            "Workspace deletion requires --approved-csv"
        )

    approved_paths = load_approved_paths(args.approved_csv)

    records = []
    targets = []

    log("=" * 60)
    log("JENKINS EFS CLEANUP")
    log("=" * 60)

    log(f"Root directory : {root}")
    log(f"Retention days : {args.days}")
    log(f"Mode           : {'EXECUTE' if args.execute else 'DRY-RUN'}")

    if args.cleanup_workspaces:
        log("\nScanning stale workspaces...")

        for item in find_stale_workspaces(root, args.days):
            path = item["path"]

            record = {
                "path": path,
                "type": classify_workspace(path),
                "modified": item["modified"],
                "age_days": item["age_days"],
                "size_gib": "",
                "status": "REVIEW REQUIRED",
            }

            if args.execute and path in approved_paths:
                record["status"] = "APPROVED"
                targets.append((path, record))

            records.append(record)

    if args.cleanup_terraform:
        log("\nScanning .terraform directories...")

        for path in find_terraform_dirs(root):
            record = {
                "path": path,
                "type": "Terraform cache",
                "modified": "",
                "age_days": "",
                "size_gib": "",
                "status": "PENDING" if args.execute else "DRY-RUN",
            }

            records.append(record)

            if args.execute:
                targets.append((path, record))

    if args.execute:
        log(f"\nDeleting {len(targets)} approved targets...")

        with ThreadPoolExecutor(max_workers=MAX_WORKERS) as executor:
            futures = {
                executor.submit(delete_directory, path, root): record
                for path, record in targets
            }

            for future in as_completed(futures):
                record = futures[future]
                record["status"] = future.result()

    write_csv(args.report, records)

    deleted = sum(
        1 for record in records if record["status"] == "DELETED"
    )

    failed = sum(
        1 for record in records if record["status"] == "FAILED"
    )

    log("\n" + "=" * 60)
    log("CLEANUP SUMMARY")
    log("=" * 60)

    log(f"Total records : {len(records)}")
    log(f"Deleted       : {deleted}")
    log(f"Failed        : {failed}")
    log(f"CSV report    : {args.report}")

    log("\nCleanup completed.")


if __name__ == "__main__":
    main()
