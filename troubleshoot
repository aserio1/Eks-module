@AfterStep({ hookContext.step.equals("plan_infrastructure")})
void call(){
    String policyCheckScript = resource("infra_policy_check.sh")

    node(jte.keywords.project) {

        ws("workspace/${env.JOB_NAME.replace('%2F','/')}/$BUILD_NUMBER") {
            stage("Governance: Infra Policy check") {
                dir("infrastructure/terraform") {
                    def enforceDate = '2026-05-01'
                    // We use Unix epoch timestamps (numbers of seconds since January 1, 1970) to perform our date comparisons in Groovy.
                    def currentDateEpoch = sh(returnStdout: true, script: 'date +%s', label: '[Get Current Timestamp]').trim().toLong()
                    def enforceDateEpoch = sh(returnStdout: true, script: "date -d '${enforceDate}' +%s", label: '[Get Enforcement Timestamp]').trim().toLong()

                    // Grab current environment from plan step output
                    def aws_profile = ""
                    if (fileExists('.aws_profile.txt')) {
                        aws_profile = readFile(file: '.aws_profile.txt').trim()
                    } else {
                        error("The .aws_profile.txt file was not found! Cannot proceed with infrastructure policy check.")
                    }

                    println "WARNING: Terraform Plan policy checks enforcement begins ${enforceDate}!"
                    def policyCheckScriptStatus = withEnv([
                        "AWS_PROFILE=${aws_profile}"
                    ]) {
                        sh(
                            label: '[Execute Infrastructure Policy Check] - ${aws_profile}.tfplan',
                            script: policyCheckScript, 
                            returnStatus: true
                        )
                    }
                    if (policyCheckScriptStatus == 1) {
                        if (currentDateEpoch >= enforceDateEpoch) {
                            // fail the pipeline
                            error "Pipeline fails due to Terraform Plan policy checks enforcement date being reached."
                        } else {
                            // fail only the stage
                            println "Starting ${enforceDate}, these checks will cause pipeline failures."
                            catchError(buildResult: 'SUCCESS', stageResult: 'FAILURE') {
                                sh(
                                    label: '[Fail Stage (Pre-Enforcement Warning)]',
                                    script: "exit $policyCheckScriptStatus"
                                )
                            }
                        }
                    } else if (policyCheckScriptStatus != 0) {
                        // Check exit status anything else than exit code 1
                        error "Script failed with exit code: $policyCheckScriptStatus."
                    }
                }
            }
        }
    }
}
