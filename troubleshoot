void call() {

  stage("Publish to SNS") {
    node(jte.keywords.project) {
      ws("workspace/${env.JOB_NAME.replace('%2F', '/')}/${env.BUILD_NUMBER}") {

        println "Publishing a message to Jenkins SNS topic."

        script {
          def jenkins_env = "prod"

          if (env.JENKINS_URL.startsWith("https://dev")) {
            jenkins_env = "dev"
          }

          def sns_arn = sh(
            returnStdout: true,
            script: """
              unset AWS_PROFILE

              aws sns list-topics \
                --region us-east-1 \
                --query "Topics[?contains(TopicArn, '${jenkins_env}-jenkins-notifications')].TopicArn | [0]" \
                --output text
            """
          ).trim()

          if (!sns_arn || sns_arn == "None") {
            error("SNS topic ${jenkins_env}-jenkins-notifications was not found.")
          }

          def buildStatus = currentBuild.currentResult

          // JOB_NAME for a multibranch job looks like: folder/folder/JobName/branchName
          // We only want the bare job name (no folder, no branch).
          def jobNameParts = env.JOB_NAME.split('/')
          def bareJobName = jobNameParts.size() >= 2 ? jobNameParts[-2] : jobNameParts[-1]

          def subject = "JENKINS(${jenkins_env}): ${bareJobName} build status is: ${buildStatus}!"

          def message = """
Jenkins pipeline status: ${buildStatus}

Job: ${bareJobName}
Branch: ${env.JOB_BASE_NAME}
Build: #${env.BUILD_NUMBER}
Environment: ${jenkins_env}
Project: ${jte.keywords.project}

Review the Jenkins build:
${env.BUILD_URL}
          """.stripIndent().trim()

          def project = jte.keywords.project

          if (subject.length() >= 100) {
            subject = subject.take(99)
          }

          try {
            sh """
              unset AWS_PROFILE

              aws sns publish \
                --region us-east-1 \
                --topic-arn '${sns_arn}' \
                --subject '${subject}' \
                --message '${message}' \
                --message-attributes '{"department":{"DataType":"String","StringValue":"${project}"}}'
            """

            echo "SNS message published successfully."

          } catch (Exception e) {
            echo "ERROR: Cannot publish message to the ${jenkins_env}-jenkins-notifications SNS topic."
            throw e
          }
        }
      }
    }
  }
}
