
#!/usr/bin/env python3

# This script scans recursively for stale .terraform dirs
# and Jenkins build directories found in /home/jenkins/workspace.
# Executed via a Jenkins job that runs daily during off hours.
# DRY RUN - No files or directories are deleted.

import os
import time
from datetime import datetime
from concurrent.futures import ThreadPoolExecutor, as_completed
from threading import Lock

ROOT_DIR = "/home/jenkins/workspace"
MAX_WORKERS = 8  # Tune based on EFS throughput limits
STALE_DAYS = 90

MAX_SCAN_SECONDS = 300
MAX_SIZE_SECONDS = 120
PROGRESS_INTERVAL = 5000

SKIP_DIRS = {
    ".git",
    ".svn",
    ".hg",
    "node_modules",
    "__pycache__",
    ".venv",
    "venv",
    ".cache",
    ".mypy_cache",
    ".pytest_cache",
    ".tox",
    ".gradle",
    ".m2",
    ".idea",
    ".vscode"
}

print_lock = Lock()
stats_lock = Lock()
freed_space = 0


def get_dir_size_fast(path, deadline):
    """Calculate directory size without following symlinks."""
    total = 0
    stack = [path]
    complete = True

    while stack:
        if time.monotonic() >= deadline:
            complete = False
            break

        current = stack.pop()

        try:
            with os.scandir(current) as entries:
                for entry in entries:
                    if time.monotonic() >= deadline:
                        complete = False
                        break

                    try:
                        if entry.is_file(follow_symlinks=False):
                            total += entry.stat(
                                follow_symlinks=False
                            ).st_size

                        elif entry.is_dir(follow_symlinks=False):
                            stack.append(entry.path)

                    except OSError:
                        complete = False

        except OSError:
            complete = False

        if not complete:
            break

    return total, complete


def delete_stale_dir(item, deadline):
    """DRY RUN - Report stale directory and potential space savings."""
    path = item["path"]
    size, complete = get_dir_size_fast(path, deadline)

    with print_lock:
        if complete:
            print(
                f"DRY RUN - Would delete: {path} "
                f"({size / (1024 ** 2):.2f} MB)",
                flush=True
            )
        else:
            print(
                f"DRY RUN - Would delete: {path} "
                f"(size incomplete; at least "
                f"{size / (1024 ** 2):.2f} MB measured)",
                flush=True
            )

    return size, complete


def find_stale_dirs(root, cutoff):
    """
    Fast directory discovery using os.scandir.

    Find:
      1. .terraform directories older than 90 days
      2. Numeric Jenkins build directories older than 90 days

    Skip internal cache directories.
    Prune stale numeric directories and all .terraform
    directories to avoid duplicate candidates and work.
    """
    stack = [root]
    stale_dirs = []

    scanned = 0
    skipped = 0
    errors = 0
    timed_out = False

    start_time = time.monotonic()
    now = time.time()

    while stack:

        if time.monotonic() - start_time >= MAX_SCAN_SECONDS:
            timed_out = True
            break

        current = stack.pop()
        scanned += 1

        if scanned % PROGRESS_INTERVAL == 0:
            print(
                f"Scanned: {scanned} | "
                f"Stale directories: {len(stale_dirs)}",
                flush=True
            )

        try:
            with os.scandir(current) as entries:
                for entry in entries:

                    if time.monotonic() - start_time >= MAX_SCAN_SECONDS:
                        timed_out = True
                        break

                    try:
                        if not entry.is_dir(follow_symlinks=False):
                            continue

                        if entry.name in SKIP_DIRS:
                            skipped += 1
                            continue

                        is_terraform = entry.name == ".terraform"
                        is_numeric = entry.name.isdigit()

                        if is_terraform or is_numeric:
                            modified = entry.stat(
                                follow_symlinks=False
                            ).st_mtime

                            if modified < cutoff:
                                age_days = int(
                                    (now - modified) / 86400
                                )

                                item = {
                                    "path": entry.path,
                                    "type": (
                                        "Terraform"
                                        if is_terraform
                                        else "Numeric Build"
                                    ),
                                    "modified": modified,
                                    "age_days": age_days
                                }

                                stale_dirs.append(item)

                                print(
                                    f"STALE ({age_days} days) | "
                                    f"Type: {item['type']} | "
                                    f"Last Modified: "
                                    f"{datetime.fromtimestamp(modified).strftime('%Y-%m-%d %H:%M:%S')} | "
                                    f"{entry.path}",
                                    flush=True
                                )

                                # Avoid scanning inside selected folders.
                                continue

                            if is_terraform:
                                continue

                        stack.append(entry.path)

                    except OSError as error:
                        errors += 1
                        print(f"Cannot inspect {entry.path}: {error}")

        except OSError as error:
            errors += 1
            print(f"Cannot access {current}: {error}")

    return stale_dirs, {
        "scanned": scanned,
        "skipped": skipped,
        "errors": errors,
        "timed_out": timed_out,
        "elapsed": time.monotonic() - start_time
    }


def main():
    global freed_space

    start_time = time.monotonic()
    cutoff = time.time() - (STALE_DAYS * 86400)

    print("======================================")
    print("JENKINS WORKSPACE CLEANUP - DRY RUN")
    print("======================================")
    print(f"Scanning         : {ROOT_DIR}")
    print(f"Retention period : {STALE_DAYS} days")
    print(f"Max scan time    : {MAX_SCAN_SECONDS} seconds")
    print(f"Max size time    : {MAX_SIZE_SECONDS} seconds")
    print("Mode             : DRY-RUN")
    print()

    if not os.path.isdir(ROOT_DIR):
        print(f"ERROR: Directory not found: {ROOT_DIR}")
        raise SystemExit(1)

    stale_dirs, stats = find_stale_dirs(ROOT_DIR, cutoff)

    print()
    print(f"Found {len(stale_dirs)} stale directories")
    print("Calculating potential space savings...\n")

    size_deadline = time.monotonic() + MAX_SIZE_SECONDS
    complete_sizes = 0
    incomplete_sizes = 0

    with ThreadPoolExecutor(max_workers=MAX_WORKERS) as executor:
        futures = {
            executor.submit(
                delete_stale_dir, item, size_deadline
            ): item
            for item in stale_dirs
        }

        for future in as_completed(futures):
            size, complete = future.result()

            with stats_lock:
                freed_space += size

                if complete:
                    complete_sizes += 1
                else:
                    incomplete_sizes += 1

    terraform_count = sum(
        1 for item in stale_dirs
        if item["type"] == "Terraform"
    )

    numeric_count = sum(
        1 for item in stale_dirs
        if item["type"] == "Numeric Build"
    )

    print("\n======================================")
    print("DRY-RUN SUMMARY")
    print("======================================")
    print(f"Directories scanned         : {stats['scanned']}")
    print(f"Directories skipped         : {stats['skipped']}")
    print(f"Stale Terraform directories : {terraform_count}")
    print(f"Stale numeric directories   : {numeric_count}")
    print(f"Total stale directories     : {len(stale_dirs)}")
    print(f"Sizes fully calculated      : {complete_sizes}")
    print(f"Sizes incomplete            : {incomplete_sizes}")

    print(
        f"Potential space recoverable : "
        f"{freed_space / (1024 ** 3):.2f} GB"
    )

    if incomplete_sizes:
        print("Space estimate              : PARTIAL")
    else:
        print("Space estimate              : COMPLETE")

    print(f"Scan errors                 : {stats['errors']}")
    print(
        f"Execution time              : "
        f"{time.monotonic() - start_time:.2f} seconds"
    )

    scan_status = (
        "PARTIAL"
        if stats["timed_out"] or stats["errors"]
        else "COMPLETE WITH EXCLUSIONS"
    )

    print(f"Scan status                 : {scan_status}")
    print("Directories deleted         : 0")
    print("Files deleted               : 0")
    print("======================================")
    print("DRY-RUN COMPLETE - NOTHING DELETED")
    print("======================================")


if __name__ == "__main__":
    main()
