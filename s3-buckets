Suggestion
###
I find that the following code does too many checks - we want to try a one detection point (not three), one repair attempt and one clear failure if repair does not work. This way pre-flight either passes or fails (repair path: force-reinstall everything, recheck, exit) you can replace all starting line 35 to the end with something simpler:

# Pre-flight: heal a corrupted shared env before installing anything new.
# This is rare (roughly once every two months, usually from a previously
# interrupted build) - if it fires, force-reinstall everything from the
# matched requirements files rather than trying to target individual
# packages, then fail the build loudly if that doesn't fix it.
#
# python -m pip (not pip3) ensures this always runs against the pip bundled
# with the currently activated conda env's python, rather than whatever
# pip3 happens to resolve to first on PATH.
if ! python -m pip check
then
    echo "pip check failed - shared env is inconsistent, forcing full reinstall"
    for req_file in $REQUIREMENTS; do
        find . -iname "$req_file" | xargs -n 1 $PIP_INSTALL --force-reinstall -r
    done

    if ! python -m pip check
    then
        echo "ERROR: environment still broken after reinstall - manual investigation needed"
        exit 1
    fi
    echo "Environment repaired"
fi

# Loop through each file (handles space-separated list)
for req_file in $REQUIREMENTS; do
    matches=$(find . -iname "$req_file")
    if [[ -n "$matches" ]]
    then
      find . -iname "$req_file" | xargs -n 1 $PIP_INSTALL -r
    fi
done
