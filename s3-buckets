resource "aws_s3_bucket" "jenkins_binaries" {
  bucket = "jenkins-binaries-213141505949"

  tags = {
    Owner                     = ""
    ApplicationName           = ""
    CreatedBy                 = ""
    Compliance                = ""
    ResourceRole              = ""
    ResourceName              = ""
    Cluster                   = ""
    Security                  = ""
    ResponsibleGroup          = ""
    Project                   = ""
    "SecurityCategorization " = ""
    Version                   = ""
    BusinessUnit              = ""
    CreatedOn                 = ""
    "Opt In"                  = ""
    "Environment "            = "Dev"
  }

  lifecycle {
    prevent_destroy = true
  }
}

resource "aws_s3_bucket_versioning" "jenkins_binaries" {
  bucket = aws_s3_bucket.jenkins_binaries.id

  versioning_configuration {
    status = "Enabled"
  }
}

resource "aws_s3_bucket_lifecycle_configuration" "jenkins_binaries" {
  bucket = aws_s3_bucket.jenkins_binaries.id

  depends_on = [
    aws_s3_bucket_versioning.jenkins_binaries
  ]

  rule {
    id     = "cleanup-noncurrent-versions"
    status = "Enabled"

    filter {}

    noncurrent_version_expiration {
      noncurrent_days           = 90
      newer_noncurrent_versions = 3
    }
  }

  rule {
    id     = "abort-incomplete-multipart-uploads"
    status = "Enabled"

    filter {}

    abort_incomplete_multipart_upload {
      days_after_initiation = 7
    }
  }
}

