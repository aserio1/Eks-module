#!/usr/bin/env bash

set -e

if ! command -v ~/anaconda3/bin/conda &> /dev/null
then
    wget https://repo.anaconda.com/archive/Anaconda3-2024.06-1-Linux-x86_64.sh
    bash Anaconda3-2024.06-1-Linux-x86_64.sh -b -u
fi

if ! ~/anaconda3/bin/conda info --envs |
    awk '{print $1}' |
    grep -Fxq "$ENV_NAME"
then
    ~/anaconda3/bin/conda create \
        -y \
        --name "$ENV_NAME" \
        python="$PYTHON_VERSION"
fi

echo "Activating Conda environment: $ENV_NAME"

set +x
source ~/anaconda3/bin/activate "$ENV_NAME"
set -x

python --version
python -m pip --version

PIP_INDEX_URL="https://repo.platform.aws.hhsoig.gov/repository/$REPO_NAME/simple"
PIP_TRUSTED_HOST="repo.platform.aws.hhsoig.gov"

PIP_INSTALL="python -m pip install \
-i $PIP_INDEX_URL \
--trusted-host $PIP_TRUSTED_HOST \
--no-color \
--no-cache-dir"

if ! python -m pip check
then
    echo "pip check failed - shared environment is inconsistent, forcing reinstall"

    for req_file in $REQUIREMENTS
    do
        find . -iname "$req_file" | while IFS= read -r requirements_file
        do
            eval "$PIP_INSTALL --force-reinstall -r \"$requirements_file\""
        done
    done

    if ! python -m pip check
    then
        echo "ERROR: environment is still broken after reinstall"
        exit 1
    fi

    echo "Environment repaired"
fi

for req_file in $REQUIREMENTS
do
    find . -iname "$req_file" | while IFS= read -r requirements_file
    do
        eval "$PIP_INSTALL -r \"$requirements_file\""
    done
done
